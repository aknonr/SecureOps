{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureops.contoso.local/contracts/identity-lookup.schema.json",
  "title": "IdentityLookup",
  "description": "Phase 1A backend-only identity lookup contracts.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/currentIdentityResponse" },
    { "$ref": "#/$defs/capabilitiesResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "#/$defs/auditStoreHealthResponse" },
    { "$ref": "#/$defs/providerHealthResponse" },
    { "$ref": "#/$defs/exampleExchange" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["account", "purpose"],
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Exact PAM account or AD username. Wildcards and bulk input are rejected."
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Incident-response context for the privileged read."
        },
        "alertId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "turuncuhatEvtId": {
          "type": ["string", "null"],
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["status", "normalizedAccount", "source"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["Found", "NotFound"]
        },
        "normalizedAccount": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["Mock", "ActiveDirectory"]
        },
        "user": {
          "type": ["object", "null"],
          "properties": {
            "displayName": { "type": ["string", "null"] },
            "samAccountName": { "type": "string" },
            "userPrincipalName": { "type": ["string", "null"] },
            "mail": { "type": ["string", "null"] },
            "department": { "type": ["string", "null"] },
            "title": { "type": ["string", "null"] },
            "managerDisplayName": { "type": ["string", "null"] },
            "enabled": { "type": ["boolean", "null"] },
            "locked": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "currentIdentityResponse": {
      "type": "object",
      "required": ["isAuthenticated", "canLookupIdentity"],
      "properties": {
        "name": {
          "type": ["string", "null"],
          "description": "Authenticated principal name when available."
        },
        "isAuthenticated": {
          "type": "boolean"
        },
        "canLookupIdentity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "capabilitiesResponse": {
      "type": "object",
      "required": ["maxAccountLength", "supportsUpnLookup", "returnedFields", "rejectedInputClasses", "rateLimitPolicy"],
      "properties": {
        "maxAccountLength": {
          "type": "integer",
          "minimum": 1
        },
        "supportsUpnLookup": {
          "type": "boolean"
        },
        "returnedFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rejectedInputClasses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rateLimitPolicy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["errorCode", "message"],
      "properties": {
        "errorCode": {
          "type": "string",
          "enum": [
            "InvalidRequestBody",
            "PurposeRequired",
            "InvalidIdentityLookupRequest",
            "EmptyAccount",
            "AccountTooLong",
            "BulkLookupRejected",
            "SearchPatternRejected",
            "AccountPatternRejected",
            "AuditUnavailable",
            "DirectoryProviderTimeout",
            "ProviderUnavailable",
            "RateLimitExceeded",
            "IdentityLookupUnavailable"
          ]
        },
        "message": {
          "type": "string"
        },
        "correlationId": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "auditStoreHealthResponse": {
      "type": "object",
      "required": ["status", "provider", "persistent", "failClosed", "queueEnabled", "lastErrorCode"],
      "properties": {
        "status": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "enum": ["InMemory", "File", "SqlServer"]
        },
        "persistent": {
          "type": "boolean"
        },
        "failClosed": {
          "type": "boolean"
        },
        "queueEnabled": {
          "type": "boolean"
        },
        "queueCapacity": {
          "type": ["integer", "null"]
        },
        "queuedCount": {
          "type": ["integer", "null"]
        },
        "lastErrorCode": {
          "type": ["string", "null"],
          "description": "Safe machine-readable last audit-store failure code, when known."
        }
      },
      "additionalProperties": false
    },
    "providerHealthResponse": {
      "type": "object",
      "required": ["status", "provider", "realDirectoryProviderEnabled"],
      "properties": {
        "status": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "enum": ["Mock", "ActiveDirectory"]
        },
        "realDirectoryProviderEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "exampleExchange": {
      "type": "object",
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" }
      },
      "additionalProperties": false
    }
  }
}
