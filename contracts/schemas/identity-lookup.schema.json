{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureops.contoso.local/contracts/identity-lookup.schema.json",
  "title": "IdentityLookup",
  "description": "Phase 1A backend-only identity lookup contracts.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/exampleExchange" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["account", "purpose"],
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Exact PAM account or AD username. Wildcards and bulk input are rejected."
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Incident-response context for the privileged read."
        },
        "alertId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "turuncuhatEvtId": {
          "type": ["string", "null"],
          "maxLength": 100
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["status", "normalizedAccount", "source"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["Found", "NotFound"]
        },
        "normalizedAccount": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["Mock", "ActiveDirectory"]
        },
        "user": {
          "type": ["object", "null"],
          "properties": {
            "displayName": { "type": ["string", "null"] },
            "samAccountName": { "type": "string" },
            "userPrincipalName": { "type": ["string", "null"] },
            "mail": { "type": ["string", "null"] },
            "department": { "type": ["string", "null"] },
            "title": { "type": ["string", "null"] },
            "managerDisplayName": { "type": ["string", "null"] },
            "enabled": { "type": ["boolean", "null"] },
            "locked": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "exampleExchange": {
      "type": "object",
      "required": ["request", "response"],
      "properties": {
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" }
      },
      "additionalProperties": false
    }
  }
}
