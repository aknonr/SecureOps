{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureops.contoso.local/contracts/service-account-usage.schema.json",
  "title": "ServiceAccountUsageScan",
  "description": "PROPOSED (ADR-0024). Output of Get-SecureOpsAccountUsage on one server: where the given accounts run (Windows services, scheduled tasks, IIS) and, optionally, whether components now run as the expected gMSA. Never contains passwords. Unreachable servers have no document; the caller records them as Unreachable, never as 'not used'.",
  "type": "object",
  "required": ["schema", "serverName", "generatedAt", "durationMs", "accounts", "scanResult", "sources", "components", "warnings"],
  "properties": {
    "schema": { "const": "service-account-usage-v1" },
    "serverName": { "type": ["string", "null"], "maxLength": 255 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "accounts": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": { "type": "string", "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,14}\\\\)?[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\\$?$" }
    },
    "scanResult": { "enum": ["Success", "Partial", "Failed"] },
    "sources": {
      "type": "object",
      "required": ["WindowsServices", "ScheduledTasks", "Iis"],
      "properties": {
        "WindowsServices": { "enum": ["Success", "Failed"] },
        "ScheduledTasks": { "enum": ["Success", "Failed"] },
        "Iis": { "enum": ["Success", "Failed", "NotInstalled"] }
      },
      "additionalProperties": false
    },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "verification": {
      "type": ["object", "null"],
      "required": ["ExpectedAccount", "Status", "RunningAsGmsa", "StillFormerAccount"],
      "properties": {
        "ExpectedAccount": { "type": "string", "pattern": "\\$$" },
        "Status": { "enum": ["Converted", "NotConverted", "NoComponents"] },
        "RunningAsGmsa": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "StillFormerAccount": { "type": "array", "items": { "$ref": "#/$defs/component" } }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": ["ComponentType", "ComponentName", "Identity", "MatchedAccount"],
      "properties": {
        "ComponentType": { "enum": ["WindowsService", "ScheduledTask", "IisAppPool", "IisSite", "IisApplication", "IisVirtualDirectory"] },
        "ComponentName": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "Identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "MatchedAccount": { "type": "string" },
        "State": { "type": ["string", "null"] },
        "Detail": { "type": ["string", "null"], "maxLength": 1024 }
      },
      "additionalProperties": false,
      "not": { "anyOf": [ { "required": ["Password"] }, { "required": ["password"] } ] }
    }
  }
}
