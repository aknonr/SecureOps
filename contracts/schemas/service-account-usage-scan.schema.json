{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secureops.contoso.local/contracts/service-account-usage-scan.schema.json",
  "title": "ServiceAccountUsageScanUpload",
  "description": "ADR-0027. Upload file for a usage scan a person ran under their own authority: the planned servers, one service-account-usage-v1 document per server that answered, and the planned servers that gave no document. Built by Invoke-ServiceAccountUsageScan.ps1 -CombinePath on the person's workstation. Never contains passwords or person names; the API rejects the whole file if any property name or value looks like a secret. A server in notReached is 'no information', never 'not used'.",
  "type": "object",
  "required": ["schema", "generatedAt", "tool", "accounts", "expectedAccount", "plannedServers", "results", "notReached"],
  "properties": {
    "schema": { "const": "service-account-usage-scan-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tool": { "enum": ["Combined", "Jea"] },
    "accounts": {
      "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,14}\\\\)?[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\\$?$" }
    },
    "expectedAccount": {
      "type": ["string", "null"],
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_.-]{0,14}\\\\)?[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\\$$"
    },
    "plannedServers": {
      "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true,
      "items": { "$ref": "#/$defs/serverName" }
    },
    "results": {
      "type": "array", "maxItems": 500,
      "items": { "$ref": "service-account-usage.schema.json" }
    },
    "notReached": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["serverName", "reason"],
        "properties": {
          "serverName": { "$ref": "#/$defs/serverName" },
          "reason": { "enum": ["Unreachable", "NoResult"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "serverName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" }
  }
}
