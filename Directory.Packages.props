<Project>

  <!--
    Central NuGet version management. Each .csproj does <PackageReference Include="..." />
    without a Version. Versions are pinned here.

    These are the planned MVP dependencies. Versions are placeholders and should be
    updated to the latest stable for .NET 8 at Phase 1 sprint 1.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="SkiaSharp" Version="4.151.2" />
    <!-- ASP.NET Core / Hosting -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="8.0.30" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />

    <!-- Authentication -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.30" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.30" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.30" />
    <PackageVersion Include="System.DirectoryServices" Version="8.0.0" />
    <PackageVersion Include="System.DirectoryServices.AccountManagement" Version="8.0.1" />

    <!-- EF Core + SQL Server -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30" />

    <!-- Dapper for hot-path audit writes -->
    <PackageVersion Include="Dapper" Version="2.1.86" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.3" />

    <!-- Hangfire -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.6" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.6" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.6" />

    <!-- PowerShell / JEA -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.4.18" />
    <!-- Match PowerShell's Roslyn compiler floor and EF Design's exact compiler/workspace pair. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.9.2" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="11.9.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.5.0" />

    <!-- Logging (Serilog) -->
    <PackageVersion Include="Serilog" Version="3.1.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageVersion Include="Serilog.Sinks.MSSqlServer" Version="6.5.1" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="8.0.0" />

    <!-- Resilience -->
    <PackageVersion Include="Polly" Version="8.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="8.0.30" />

    <!-- Blazor UI -->
    <PackageVersion Include="MudBlazor" Version="6.16.0" />

    <!-- JSON Schema validation (contract tests) -->
    <PackageVersion Include="JsonSchema.Net" Version="7.0.4" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.6.6" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <!-- Test-only: Microsoft's Open XML schema validator for generated XLSX (Service Accounts charts); not shipped. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="NSubstitute" Version="5.1.0" />
    <PackageVersion Include="bunit" Version="1.25.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.30" />
    <PackageVersion Include="System.Text.Json" Version="8.0.6" />
    <PackageVersion Include="Testcontainers.MsSql" Version="3.7.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

</Project>
