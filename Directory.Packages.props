<Project>

  <!--
    Central NuGet version management. Each .csproj does <PackageReference Include="..." />
    without a Version. Versions are pinned here.

    Microsoft packages follow the .NET 10 servicing patch (10.0.x); bump them together.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <!-- ASP.NET Core / Hosting -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />

    <!-- Authentication -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <!-- Transitive via MimeKit, Microsoft.Data.SqlClient and PowerShell SDK: pinned to the patched servicing version (NuGet audit advisories, 2026-10). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageVersion Include="System.DirectoryServices" Version="10.0.13" />
    <PackageVersion Include="System.DirectoryServices.AccountManagement" Version="10.0.13" />


    <!-- Data access: Dapper over numbered SQL scripts (ADR-0001) -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />

    <!-- Hangfire -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />

    <!-- PowerShell / JEA -->
    <PackageVersion Include="Microsoft.PowerShell.SDK" Version="7.6.6" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Swashbuckle 10 requires Microsoft.OpenApi 2.x; referenced directly because src/SecureOps.Api/OpenApi filters use its model. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />

    <!-- Logging (Serilog) -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.MSSqlServer" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />


    <!-- Blazor UI -->
    <PackageVersion Include="MudBlazor" Version="9.11.0" />


    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Test-only: JSON Schema validation of the Service Accounts usage contracts (unit tests). Same version Microsoft.PowerShell.SDK already brings in transitively (a lower pin is a NU1605 downgrade). -->
    <PackageVersion Include="JsonSchema.Net" Version="7.4.0" />
    <!-- Test-only: Microsoft's Open XML schema validator for generated XLSX (Service Accounts charts); not shipped. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
