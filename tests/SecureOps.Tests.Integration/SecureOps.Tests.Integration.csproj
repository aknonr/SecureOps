<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SecureOps.Tests.Integration
    xUnit integration tests. Current tests use the in-process Web API host
    (Microsoft.AspNetCore.Mvc.Testing) and deterministic backend fakes only.

    See: docs/agent-guides/090-testing-quality.md
  -->

  <PropertyGroup>
    <RootNamespace>SecureOps.Tests.Integration</RootNamespace>
    <AssemblyName>SecureOps.Tests.Integration</AssemblyName>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureOps.Domain\SecureOps.Domain.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Shared\SecureOps.Shared.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Infrastructure\SecureOps.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Api\SecureOps.Api.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Ui\SecureOps.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
