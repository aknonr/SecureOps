<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SecureOps.Tests.Integration
    xUnit integration tests. End-to-end flows with real SQL (Testcontainers MSSQL)
    and Web API host (Microsoft.AspNetCore.Mvc.Testing). PowerShell calls use the
    MockPowerShellRunner with canned outputs in unit-level integration tests; a
    separate subset runs against a real pilot server when access is available.

    See: .cursor/rules/090-testing-and-quality-rules.mdc
  -->

  <PropertyGroup>
    <RootNamespace>SecureOps.Tests.Integration</RootNamespace>
    <AssemblyName>SecureOps.Tests.Integration</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureOps.Domain\SecureOps.Domain.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Shared\SecureOps.Shared.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Infrastructure\SecureOps.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Api\SecureOps.Api.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Worker\SecureOps.Worker.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Ui\SecureOps.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="bunit" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
