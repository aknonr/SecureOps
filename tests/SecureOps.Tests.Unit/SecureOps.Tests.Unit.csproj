<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SecureOps.Tests.Unit
    xUnit unit tests. Domain logic, application services with mocked infrastructure.
    No SQL, no PowerShell, no real external systems.

    See: docs/agent-guides/090-testing-quality.md
  -->

  <PropertyGroup>
    <RootNamespace>SecureOps.Tests.Unit</RootNamespace>
    <AssemblyName>SecureOps.Tests.Unit</AssemblyName>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SecureOps.Worker\SecureOps.Worker.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Domain\SecureOps.Domain.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Shared\SecureOps.Shared.csproj" />
    <ProjectReference Include="..\..\src\SecureOps.Infrastructure\SecureOps.Infrastructure.csproj" />
    <!-- UI presentation logic that is pure and worth testing without a browser: error translation,
         account input mirroring, and lookup result reuse. -->
    <ProjectReference Include="..\..\src\SecureOps.Ui\SecureOps.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
