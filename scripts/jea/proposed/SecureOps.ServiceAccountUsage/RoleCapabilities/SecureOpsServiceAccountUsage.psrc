@{
    # PROPOSED (ADR-0024) — review with Bilgi Güvenliği before any deployment.
    # The caller can run exactly one command. Get-SecureOpsAccountUsage reads services, scheduled tasks and the IIS
    # identity attributes (never passwords) inside its own function body; the raw cmdlets it uses are deliberately NOT
    # visible, so a caller cannot ask Get-WebConfigurationProperty or Get-Content for password attributes.
    GUID             = '8c0b5e2a-1f4d-4a77-b3c6-9e2d7a5f1c08'
    Description      = 'SecureOps service account usage discovery (read-only, one function).'
    ModulesToImport  = @('SecureOps.ServiceAccountUsage')
    VisibleFunctions = @('Get-SecureOpsAccountUsage')
    VisibleCmdlets   = @()
    VisibleProviders = @()
    VisibleExternalCommands = @()
}
