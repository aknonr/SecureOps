@{
    # ADR-0024 R2. Session configuration template for the discovery endpoint. The installer replaces the placeholder group with the
    # read group the server owner names (the group that holds the Worker's read gMSA) and registers it as SecureOpsServiceAccountUsage.
    SchemaVersion       = '2.0.0.0'
    GUID                = 'b7e41d9c-3a26-4f0e-8c55-1d9f6a2e7b40'
    Description         = 'SecureOps service account usage discovery (read-only JEA endpoint).'
    SessionType         = 'RestrictedRemoteServer'
    LanguageMode        = 'NoLanguage'
    RunAsVirtualAccount = $true
    TranscriptDirectory = 'C:\ProgramData\SecureOps\JEA\Transcripts'
    # Placeholder group (ADR-0024 R2-1): only the read group may connect; nobody else is mapped to any role.
    RoleDefinitions     = @{ 'CONTOSO\SecureOps-SaRead' = @{ RoleCapabilities = 'SecureOpsServiceAccountUsage' } }
}
