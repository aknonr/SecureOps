<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SecureOps.Ui
    Blazor Server + MudBlazor. Hosted on IIS in-process.
    Phase 2 deliverable; minimal status page in Phase 1.

    See: docs/03-architecture.md, docs/agent-guides/060-ui.md
  -->

  <PropertyGroup>
    <RootNamespace>SecureOps.Ui</RootNamespace>
    <AssemblyName>SecureOps.Ui</AssemblyName>
    <UserSecretsId>secureops-ui-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- LocalReturnUrl guards open-redirect and sign-in-loop cases and stays internal to the shell;
         the unit tests assert that behavior directly. -->
    <InternalsVisibleTo Include="SecureOps.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureOps.Domain\SecureOps.Domain.csproj" />
    <ProjectReference Include="..\SecureOps.Shared\SecureOps.Shared.csproj" />
    <ProjectReference Include="..\SecureOps.Infrastructure\SecureOps.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blazor + components -->
    <PackageReference Include="MudBlazor" />

    <!-- Auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" />
    <PackageReference Include="Serilog.Settings.Configuration" />

    <!-- Resilience for API client calls -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
  </ItemGroup>

</Project>
