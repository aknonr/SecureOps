@*
    Primary navigation, grouped by what the operator is doing rather than by which team built it.

    Entries appear based on capabilities returned by GET /api/v1/access/me, so the menu reflects the
    server's view of this account instead of the UI's own guess. Hiding an entry only avoids a dead
    end — the API re-checks every capability on every call.

    Planned capabilities stay listed but visibly inert, because "what is coming next" is part of what
    this navigation is meant to communicate.
*@

@implements IDisposable
@inject ICurrentAccessProvider AccessProvider

<MudNavMenu Dense="true" Class="so-nav">
    <AuthorizeView>
        <Authorized Context="signedIn">
            <div class="so-nav-group">Operasyon</div>

            @* Same route either way: the dashboard shows the management report to holders of
               Reporting.ManagementView and the operator board to everyone else. Only the label
               changes, so the entry matches what the page will actually be. *@
            <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">
                @(Can(Capabilities.ManagementReportingView) ? "Yönetim Panosu" : "Genel Bakış")
            </MudNavLink>

            @if (Can(Capabilities.IdentityLookup))
            {
                <MudNavLink Href="identity-lookup" Icon="@Icons.Material.Filled.ManageSearch">
                    Kimlik Sorgulama
                </MudNavLink>
            }

            @if (Can(Capabilities.OperationalRecordsView))
            {
                <MudNavLink Href="operational-records" Icon="@Icons.Material.Filled.Assignment">
                    Operasyonel Kayıtlar
                </MudNavLink>
            }

            @* Cross-user analytics is a separate privilege from doing the work. An operator who can
               run lookups or move records to Jira has no entry here. *@
            @if (Can(Capabilities.ManagementReportingView))
            {
                <div class="so-nav-group">Raporlama</div>

                <MudNavLink Href="reporting/operators" Icon="@Icons.Material.Filled.QueryStats">
                    Operatör Raporu
                </MudNavLink>
            }

            <div class="so-nav-group">Erişim</div>

            <MudNavLink Href="access/me" Icon="@Icons.Material.Filled.VerifiedUser">
                Erişimim
            </MudNavLink>

            @if (Can(Capabilities.AccessApproveRequests))
            {
                <MudNavLink Href="access/requests" Icon="@Icons.Material.Filled.AdminPanelSettings">
                    Erişim Talepleri
                </MudNavLink>
            }

            @* Gated on ManageUsers rather than ApproveRequests: the users read model is a
               different capability, and an approver without it would get a blocked page. *@
            @if (Can(Capabilities.AccessManageUsers))
            {
                <MudNavLink Href="access/users" Icon="@Icons.Material.Filled.Group">
                    Kullanıcılar
                </MudNavLink>
            }

            <div class="so-nav-group">Sonraki fazlar</div>

            <MudNavLink Href="audit-compliance" Icon="@Icons.Material.Filled.VerifiedUser">
                Denetim ve Uyum
                <span class="so-nav-tag">Planlandı</span>
            </MudNavLink>

            <MudNavLink Href="diagnostics-readonly" Icon="@Icons.Material.Filled.FactCheck">
                Salt Okunur Tanılama
                <span class="so-nav-tag">Planlandı</span>
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private AccessSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _snapshot = await AccessProvider.GetAsync();
    }

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    private bool Can(string capability) => _snapshot?.Can(capability) == true;

    public void Dispose() => AccessProvider.Changed -= OnAccessChanged;
}
