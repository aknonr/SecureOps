@*
    One integration provider's state.

    The status word is the server's, translated but never reinterpreted. An unrecognised value is
    shown as it arrived with a neutral tone, so a status added later reads as unknown rather than
    being coloured green by a default branch.
*@

<article class="so-integration so-integration--@ToneSlug">
    <div class="so-integration-head">
        <span class="so-integration-title">@Title</span>
        <SoStatusBadge Label="@StatusLabel" Tone="@Tone" Icon="@StatusIcon" />
    </div>

    <p class="so-integration-text">@Description</p>

    <dl class="so-integration-meta">
        <dt>Seçilen sağlayıcı</dt>
        <dd><code class="so-code so-code--sm">@Provider.Selection</code></dd>
    </dl>
</article>

@code {
    /// <summary>Provider state exactly as the API returned it.</summary>
    [Parameter, EditorRequired]
    public IntegrationProviderHealthResponse Provider { get; set; } = default!;

    /// <summary>Operator-facing name of the integration.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>One line on what SecureOps uses it for.</summary>
    [Parameter]
    public string? Description { get; set; }

    private string StatusLabel => Provider.Status switch
    {
        "Configured" => "Yapılandırıldı",
        "Disabled" => "Devre dışı",
        "Unavailable" => "Erişilemiyor",
        "Healthy" => "Sağlıklı",
        _ => Provider.Status
    };

    // Disabled is neutral, not a fault: a provider that is deliberately off is a configuration
    // decision, and colouring it red would send operators chasing a non-problem.
    private SoStatusBadge.BadgeTone Tone => Provider.Status switch
    {
        "Configured" => SoStatusBadge.BadgeTone.Positive,
        "Healthy" => SoStatusBadge.BadgeTone.Positive,
        "Disabled" => SoStatusBadge.BadgeTone.Neutral,
        "Unavailable" => SoStatusBadge.BadgeTone.Critical,
        _ => SoStatusBadge.BadgeTone.Neutral
    };

    private string ToneSlug => Provider.Status switch
    {
        "Configured" or "Healthy" => "ok",
        "Disabled" => "off",
        "Unavailable" => "down",
        _ => "unknown"
    };

    private string StatusIcon => Provider.Status switch
    {
        "Configured" or "Healthy" => Icons.Material.Filled.CheckCircle,
        "Disabled" => Icons.Material.Filled.PauseCircle,
        "Unavailable" => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.HelpOutline
    };
}
