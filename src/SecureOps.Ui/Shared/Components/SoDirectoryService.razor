@using Microsoft.Extensions.Logging
@inject IDirectoryApiClient Directory
@inject ILogger<SoDirectoryService> Logger

@*
    Service-account indicators from directory evidence.

    Indicators, not a classification. The API reports what the directory object says — object class,
    SPNs, managedBy, password policy — and does not decide that an account is a service account.
    Neither does this panel, in either direction: an ordinary user object carrying SPNs is shown as
    exactly that, and an account with no SPNs is not thereby "not a service account".

    Two results are easy to render as failures and must not be:

      SPN count 0 with a successful read is empty evidence, not an outage. It says this account has
      no service principal names, which is a finding.

      membershipEvidenceAvailable=false means the principal and SPN read succeeded while the group
      graph did not. The panel keeps everything it does have and marks only the counts unknown,
      rather than collapsing into "Active Directory yanıt vermiyor".
*@

@if (_loading)
{
    <SoLoading Message="Servis göstergeleri getiriliyor…" Variant="SoLoading.LoadingVariant.Block" />
}
else if (_problem is not null)
{
    <SoProblemPanel Problem="_problem" OnRetry="@(() => LoadAsync(refresh: true))" />
}
else if (_evidence is not null)
{
    <section class="so-panel">
        <div class="so-panel-head">
            <h3 class="so-subhead so-subhead--flush">Servis Hesabı Göstergeleri</h3>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@(() => LoadAsync(refresh: true))">
                Yenile
            </MudButton>
        </div>

        <p class="so-panel-text so-panel-text--sm">
            Aşağıdakiler Active Directory'den okunan kanıtlardır, kesin bir sınıflandırma değildir.
            WASAS bir hesabın servis hesabı olduğuna karar vermez; kararı bu kanıtlara bakarak
            siz verirsiniz.
        </p>

        @if (!_evidence.MembershipEvidenceAvailable)
        {
            @* The principal read worked. Only the group graph did not, and saying which is which
               stops an operator reporting an AD outage that is not happening. *@
            <div class="so-partial-notice" role="status">
                <span class="so-partial-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                </span>
                <div>
                    <p class="so-partial-title">Hesap bilgileri alındı, grup sayıları alınamadı</p>
                    <p class="so-panel-text so-panel-text--sm">
                        Bu hesabın nesne ve SPN bilgileri başarıyla okundu; grup üyeliği sayıları bu
                        sorguda elde edilemedi. Aşağıdaki SPN kanıtları geçerlidir.
                    </p>
                </div>
            </div>
        }
        else
        {
            <SoTraversalNotice Traversal="_evidence.Traversal" />
        }

        <div class="so-metrics">
            <SoMetric Label="SPN sayısı"
                      Value="@_evidence.ServicePrincipalNameCount.ToString()"
                      Hint="@(_evidence.ServicePrincipalNamesTruncated ? "Liste kısaltıldı, sayı tamdır" : null)"
                      Tone="@(_evidence.ServicePrincipalNameCount > 0
                               ? SoMetric.MetricTone.Lead
                               : SoMetric.MetricTone.Plain)" />
            <SoMetric Label="Doğrudan grup"
                      Value="@DirectoryView.Count(_evidence.DirectGroupCount)"
                      Available="@(_evidence.DirectGroupCount is not null)" />
            <SoMetric Label="İç içe grup"
                      Value="@DirectoryView.Count(_evidence.TransitiveGroupCount)"
                      Available="@(_evidence.TransitiveGroupCount is not null)" />
        </div>

        <SoFieldGrid MinColumnWidth="260px">
            <SoField Label="@DirectoryView.ObjectTypeLabel">
                @DirectoryView.AccountTypeEvidenceLabel(_evidence.AccountTypeEvidence)
            </SoField>
            <SoField Label="@DirectoryView.ManagedByLabel">
                @if (string.IsNullOrWhiteSpace(_evidence.ManagedBy))
                {
                    <span class="so-unknown">@DirectoryView.NotDefinedText</span>
                }
                else
                {
                    <span class="so-wrap">@_evidence.ManagedBy</span>
                }
            </SoField>
            <SoField Label="Parola son değiştirilme zamanı">
                @DirectoryView.Timestamp(_evidence.PasswordLastSetUtc)
            </SoField>
            <SoField Label="Parola yaşı">@DirectoryView.Days(_evidence.PasswordAgeDays)</SoField>
            <SoField Label="Hesap bitiş tarihi">
                @if (_evidence.AccountExpiresUtc is null)
                {
                    <span class="so-unknown">@DirectoryView.NotDefinedText</span>
                }
                else
                {
                    @DirectoryView.Timestamp(_evidence.AccountExpiresUtc)
                }
            </SoField>
        </SoFieldGrid>

        <h3 class="so-subhead">
            Service Principal Name (SPN)
            <span class="so-count-chip">@_evidence.ServicePrincipalNameCount</span>
        </h3>
        <p class="so-panel-text so-panel-text--sm">@DirectoryView.SpnHelp</p>

        @if (_evidence.ServicePrincipalNameCount == 0)
        {
            @* Successful empty evidence. Never an error, and never a conclusion about the account. *@
            <p class="so-panel-text so-panel-text--sm so-unknown">
                Bu hesap üzerinde tanımlı SPN bulunmuyor.
            </p>
        }
        else
        {
            <ul class="so-spn-list">
                @foreach (string spn in _evidence.ServicePrincipalNames)
                {
                    <li><code class="so-code so-code--sm">@spn</code></li>
                }
            </ul>

            @if (_evidence.ServicePrincipalNamesTruncated)
            {
                @* Count and list disagree by design. Saying so prevents someone counting the visible
                   rows and reporting a smaller number than the account actually carries. *@
                <p class="so-panel-text so-panel-text--sm so-note-caution">
                    Toplam @_evidence.ServicePrincipalNameCount SPN'den yalnızca ilk
                    @_evidence.ServicePrincipalNames.Count tanesi gösteriliyor; liste sunucu tarafında
                    sınırlandırıldı. Sayı tam, liste eksiktir.
                </p>
            }
        }
    </section>
}

@code {
    /// <summary>Exact account, as the server normalized it.</summary>
    [Parameter, EditorRequired]
    public string Account { get; set; } = string.Empty;

    private DirectoryServiceEvidenceResponse? _evidence;
    private UiProblem? _problem;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadAsync(refresh: false);

    private async Task LoadAsync(bool refresh)
    {
        _loading = true;
        _problem = null;
        StateHasChanged();

        try
        {
            _evidence = await Directory.GetServiceEvidenceAsync(Account, null, refresh, CancellationToken.None);
        }
        catch (SecureOpsApiException ex)
        {
            _evidence = null;
            _problem = ex.Problem;
            Logger.LogDebug("Service evidence unavailable. Code: {Code}.", ex.Problem.Code);
        }
        finally
        {
            _loading = false;
        }
    }
}
