@*
    Neutral placeholder for "nothing here yet" and "nothing matched".

    Distinct from SoProblemPanel on purpose: an empty result is a normal outcome, not a failure, and
    styling it as an alert trains operators to ignore real alerts.
*@

<div class="so-empty">
    <span class="so-empty-icon" aria-hidden="true">
        <MudIcon Icon="@Icon" />
    </span>
    <p class="so-empty-title">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="so-empty-text">@Description</p>
    }
    @if (Actions is not null)
    {
        <div class="so-empty-actions">@Actions</div>
    }
</div>

@code {
    /// <summary>Short statement of what is absent.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional guidance on how to populate the view.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>Icon reinforcing the empty condition.</summary>
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Outlined.Inbox;

    /// <summary>Optional actions, such as a link to the form that produces results.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
