@if (Type == "datetime-local")
{ <AnnouncementTimeField Key="@Key" Label="@Label" Value="@Value" ValueChanged="ValueChanged" /> }
else
{
<label class="so-announcement-field" for="@($"announcement-{Key}")">@Label
    @if (Type == "textarea")
    { <textarea id="@($"announcement-{Key}")" rows="3" maxlength="4000" value="@Value" @oninput="ChangeAsync"></textarea> }
    else
    { <input id="@($"announcement-{Key}")" type="@Type" maxlength="@(Key == "Subject" ? 200 : 4000)" value="@Value" @oninput="ChangeAsync" /> }
</label>
}
@code {
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    private Task ChangeAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
