@using SecureOps.Shared.Contracts.InUse

<div class="so-inuse-reporter">
    <strong>@(Value?.RfcReference ?? "RFC yok")</strong>
    @if (Value is { } value)
    {
        <span> · @State(value.EffectiveState(DateTimeOffset.UtcNow))</span>
        @if (!string.IsNullOrWhiteSpace(value.Display))
        { <div>@(value.EffectiveState(DateTimeOffset.UtcNow) == "ExactMatch" ? "" : "Önceki kanıt: ")@InUseDisplayText.Decode(value.Display)</div> }
        else { <div>Bildiren bilgisi yok</div> }
        @if (Detailed)
        {
            <div>Servis öğesi: @value.ServiceItemId</div>
            <div>Kişi referansı: @(value.UserReference ?? "Yok")</div>
            <details><summary>Doğrulama kanıtı</summary>
            <div>Bağlı OR: @(value.RequestCode ?? "Çözümlenmedi") · @(value.RequestId ?? "Kimlik yok")</div>
            <div>Son doğrulama: @(value.LastVerifiedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Yok")</div>
            </details>
        }
    }
    else { <span> · Sorgulanmadı</span> }
</div>

@code {
    [Parameter] public InUseRelatedRequestReporter? Value { get; set; }
    [Parameter] public bool Detailed { get; set; }
    private static string State(string state) => state switch
    {
        "ExactMatch" => "Doğrulandı", "MissingRfc" => "RFC boş", "Stale" => "Güncel değil",
        "NotFoundOrNotVisible" => "Bulunamadı veya görünür değil", "AmbiguousMatch" => "Belirsiz eşleşme",
        "IdentityMismatch" => "Kimlik uyuşmazlığı", "Forbidden" => "Erişim reddedildi",
        "Failed" => "Okuma başarısız", _ => "Sorgulanmadı"
    };
}
