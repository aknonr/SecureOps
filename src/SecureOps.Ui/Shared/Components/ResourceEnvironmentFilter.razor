@using SecureOps.Shared.Contracts.Resources
@implements IDisposable
@inject IResourceApiClient ResourceApi

<div class="so-resource-filter so-resource-environment-filter so-field">
    <span class="so-field-label">Ortam</span>
    <MudAutocomplete T="string" Value="Value" ValueChanged="ValueChanged" SearchFunc="SearchAsync"
                     aria-label="Ortam" Placeholder="Tüm ortamlar" Variant="Variant.Outlined"
                     Margin="Margin.Dense" Dense="true" Clearable="true" ResetValueOnEmptyText="true"
                     CoerceText="true" MinCharacters="0" MaxItems="100" DebounceInterval="250"
                     ListClass="so-resource-environment-options"
                     Error="@(_problem is not null)" ErrorText="Ortamlar yüklenemedi; yeniden arayın.">
        <NoItemsTemplate><span class="so-panel-text">Eşleşen ortam yok</span></NoItemsTemplate>
    </MudAutocomplete>
    @if (_hasMore)
    {
        <span class="so-panel-text so-panel-text--sm" role="status">Daha fazla ortam var; ortam adını yazarak daraltın.</span>
    }
    @if (_problem is not null)
    {
        <SoProblemPanel Problem="_problem" />
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Guid? CategoryId { get; set; }
    [Parameter] public bool IncludeArchived { get; set; }
    private CancellationTokenSource? _cancellation;
    private int _sequence;
    private bool _hasMore;
    private UiProblem? _problem;

    private async Task<IEnumerable<string>> SearchAsync(string search, CancellationToken cancellationToken)
    {
        int sequence = ++_sequence;
        _cancellation?.Cancel();
        _cancellation?.Dispose();
        _cancellation = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        CancellationToken token = _cancellation.Token;
        _problem = null;
        _hasMore = false;
        try
        {
            ResourceEnvironmentOptions result = await ResourceApi.GetEnvironmentsAsync(
                new(search?.Length > 40 ? search[..40] : search, CategoryId, IncludeArchived), token);
            if (sequence != _sequence) return [];
            _hasMore = result.HasMore;
            return result.Values;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { return []; }
        catch (SecureOpsApiException exception)
        {
            if (sequence == _sequence) _problem = exception.Problem;
            return [];
        }
        finally
        {
            // SearchFunc is a delegate, not an EventCallback that rerenders this parent.
            if (sequence == _sequence) await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        ++_sequence;
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }
}
