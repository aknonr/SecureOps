@* Renders one report payload (live or stored snapshot) exactly as computed by the single server metric
   implementation. Team rows describe workload, not people; there is no ranking. *@
@using SecureOps.Domain.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts

<section class="so-panel" aria-labelledby="sa-report-summary">
    <div class="so-panel-head">
        <h2 id="sa-report-summary" class="so-panel-title">@Title</h2>
        <span class="so-panel-text--sm">@(Report.Period == ReportPeriods.Week ? "Hafta" : Report.Period == ReportPeriods.Month ? "Ay" : "Dönem"): @Report.WeekStart.ToString("dd.MM.yyyy") – @Report.WeekEndExclusive.AddDays(-1).ToString("dd.MM.yyyy") · Kesim: @ServiceAccountUiText.Instant(Report.AsOf) · @Report.ScopeLabel · @Report.MetricDefinitionVersion</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <SoMetric Label="Tekil hesap" Value="@S.UniqueAccounts.ToString()" />
        <SoMetric Label="Sahip ekibi olan" Value="@S.AccountsWithOwnerTeam.ToString()" />
        <SoMetric Label="Sorumlu kişisi olan" Value="@S.AccountsWithAssignedPerson.ToString()" />
        <SoMetric Label="Tekil sorumlu kişi" Value="@S.UniqueResponsiblePersons.ToString()" />
        <SoMetric Label="Açık talep" Value="@S.OpenRequests.ToString()" />
        <SoMetric Label="Tarihli açık plan (talep / hesap)" Value="@($"{S.DatedOpenPlanRequests} / {S.DatedOpenPlanAccounts}")" />
        <SoMetric Label="Tarih bekleyen" Value="@S.AwaitingDateRequests.ToString()" />
        <SoMetric Label="Plan bitişi geçen" Value="@S.OverdueRequests.ToString()" />
        <SoMetric Label="Gerçekleşen işlem bildirimi" Value="@S.PerformedActionReports.ToString()" />
        <SoMetric Label="Doğrulanmış kapanış (hesap)" Value="@S.VerifiedClosureAccounts.ToString()" />
        <SoMetric Label="Geçerli e-posta / tarihsiz / taslak" Value="@($"{S.ValidMails} / {S.UndatedMails} / {S.DraftMailsExcluded}")" />
        <SoMetric Label="Açık bulgu" Value="@S.OpenFindings.ToString()" />
    </div>
</section>

<section class="so-panel" aria-labelledby="sa-report-week">
    <h2 id="sa-report-week" class="so-panel-title">@(Report.Period == ReportPeriods.Week ? "Haftalık hareket" : "Dönem hareketi")</h2>
    <MudSimpleTable Dense="true" Bordered="true">
        <thead><tr><th scope="col">Kayıt</th><th scope="col">@(Report.Period == ReportPeriods.Week ? "Bu hafta" : "Dönem içi")</th><th scope="col">Daha önce</th><th scope="col">Sonra (kesimden önce)</th><th scope="col">Kesimden sonra</th><th scope="col">Tarihsiz</th><th scope="col">Toplam</th><th scope="col">Mutabakat</th></tr></thead>
        <tbody>
            @foreach ((string label, PlacementCounts c) in Placements)
            {
                <tr>
                    <th scope="row">@label</th><td>@c.InPeriod</td><td>@c.Earlier</td><td>@c.LaterBeforeCutoff</td><td>@c.AfterCutoff</td><td>@c.UnknownDate</td><td>@c.Total</td>
                    <td>@(c.Reconciles ? "Tutarlı" : "Tutarsız")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <p class="so-panel-text--sm mt-1">Dönem içinde giden / gelen e-posta: @Report.Weekly.OutgoingMailsInPeriod / @Report.Weekly.IncomingMailsInPeriod</p>
    @if (Report.Weekly.ActionsInPeriod.Count > 0)
    {
        <MudTable Items="Report.Weekly.ActionsInPeriod" Dense="true" Breakpoint="Breakpoint.Sm" T="ReportActionLine" Class="mt-2">
            <HeaderContent><MudTh>Hesap</MudTh><MudTh>İşlem</MudTh><MudTh>Sonuç</MudTh><MudTh>Tarih</MudTh><MudTh>Yapan ekip</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Hesap">@context.Account</MudTd><MudTd DataLabel="İşlem">@context.Action</MudTd><MudTd DataLabel="Sonuç">@context.Result</MudTd>
                <MudTd DataLabel="Tarih">@ServiceAccountUiText.Date(context.Date)</MudTd><MudTd DataLabel="Yapan ekip">@(context.PerformerTeam ?? "Bilinmiyor")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</section>

<section class="so-panel" aria-labelledby="sa-report-plans">
    <h2 id="sa-report-plans" class="so-panel-title">Tarihli açık planlar</h2>
    @if (Report.DatedPlans.Count == 0) { <SoEmptyState Title="Tarihli açık plan yok" /> }
    else
    {
        <MudTable Items="Report.DatedPlans" Dense="true" Breakpoint="Breakpoint.Sm" T="PlanLine">
            <HeaderContent><MudTh>Hesap</MudTh><MudTh>İş</MudTh><MudTh>Başlangıç</MudTh><MudTh>Bitiş</MudTh><MudTh>Hedef ekip</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Hesap">@context.Account</MudTd><MudTd DataLabel="İş">@context.Action</MudTd>
                <MudTd DataLabel="Başlangıç">@context.Start.ToString("dd.MM.yyyy")</MudTd>
                <MudTd DataLabel="Bitiş">@context.End.ToString("dd.MM.yyyy")@(context.Overdue ? " · geçti" : "")</MudTd>
                <MudTd DataLabel="Hedef ekip">@(context.TargetTeam ?? "Yok")</MudTd>
            </RowTemplate>
        </MudTable>
    }
</section>

@if (Report.Directorate is { } directorate)
{
    <section class="so-panel" aria-labelledby="sa-report-directorate">
        <h2 id="sa-report-directorate" class="so-panel-title">Direktörlük görünümü</h2>
        <p class="so-panel-text--sm">Her satır bir ekip: sahip olunan hesaplar ve ekibe yönelik açık işler. Kişi bazlı sayı veya sıralama yoktur.</p>
        @if (directorate.Count == 0) { <SoEmptyState Title="Ekip verisi yok" /> }
        else
        {
            <MudTable Items="directorate" Dense="true" Breakpoint="Breakpoint.Sm" T="DirectorateRow">
                <HeaderContent><MudTh>Organizasyon</MudTh><MudTh>Ekip</MudTh><MudTh>Sahip olunan hesap</MudTh><MudTh>Muhatap açık talep</MudTh><MudTh>Geciken</MudTh>
                    <MudTh>Tarih bekleyen</MudTh><MudTh>Kurala aykırı</MudTh><MudTh>Bekleyen gMSA</MudTh><MudTh>Risk adayı</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Organizasyon">@context.Organization</MudTd><MudTd DataLabel="Ekip">@context.Team</MudTd>
                    <MudTd DataLabel="Sahip olunan hesap">@context.OwnedAccounts</MudTd><MudTd DataLabel="Muhatap açık talep">@context.OpenRequestsAsTarget</MudTd>
                    <MudTd DataLabel="Geciken">@context.OverdueAsTarget</MudTd><MudTd DataLabel="Tarih bekleyen">@context.AwaitingDateAsTarget</MudTd>
                    <MudTd DataLabel="Kurala aykırı">@context.AgainstRule</MudTd><MudTd DataLabel="Bekleyen gMSA">@context.GmsaPending</MudTd>
                    <MudTd DataLabel="Risk adayı">@context.RiskCandidates</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </section>
}
else
{
    <section class="so-panel" aria-labelledby="sa-report-teams">
        <h2 id="sa-report-teams" class="so-panel-title">Ekip iş yükü</h2>
        @if (Report.TeamWorkload.Count == 0) { <SoEmptyState Title="Ekip verisi yok" /> }
        else
        {
            <MudTable Items="Report.TeamWorkload" Dense="true" Breakpoint="Breakpoint.Sm" T="TeamWorkloadRow">
                <HeaderContent><MudTh>Ekip</MudTh><MudTh>Sahip olunan hesap</MudTh><MudTh>Hedef olunan açık talep</MudTh><MudTh>Plan bitişi geçen</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Ekip">@context.Team</MudTd><MudTd DataLabel="Sahip olunan hesap">@context.OwnedAccounts</MudTd>
                    <MudTd DataLabel="Hedef olunan açık talep">@context.OpenRequestsAsTarget</MudTd><MudTd DataLabel="Plan bitişi geçen">@context.OverdueAsTarget</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </section>
}

<section class="so-panel" aria-labelledby="sa-report-handover">
    <h2 id="sa-report-handover" class="so-panel-title">Devir ve gMSA</h2>
    <div class="d-flex flex-wrap gap-2">
        <SoMetric Label="Devir bildirimi" Value="@Report.Handover.Reported.ToString()" />
        <SoMetric Label="Kabul / ret" Value="@($"{Report.Handover.Accepted} / {Report.Handover.Rejected}")" />
        <SoMetric Label="gMSA hedefi / tamamlanan / bekleyen" Value="@($"{Report.Handover.GmsaTargeted} / {Report.Handover.GmsaCompleted} / {Report.Handover.GmsaPending}")" />
    </div>
    @if (Report.Handover.PendingBySuitability.Count > 0)
    {
        <p class="so-panel-text--sm mt-1">Bekleyen gMSA uygunluğu: @string.Join(", ", Report.Handover.PendingBySuitability.Select(n => $"{n.Label}: {n.Count}"))</p>
    }
    <p class="so-panel-text--sm mt-2">@Report.Legacy.Label: adı geçen sorumlu @Report.Legacy.NamedAccounts, takipçi yedeği @Report.Legacy.FollowupFallbackAccounts, birleşik @Report.Legacy.CombinedAccounts hesap / @Report.Legacy.CombinedPeople kişi.</p>
    @if (Report.Notes.Count > 0)
    {
        <ul class="mt-1">@foreach (string note in Report.Notes) { <li class="so-panel-text--sm">@note</li> }</ul>
    }
</section>

@if (Report.Rules is { } rules)
{
    <section class="so-panel" aria-labelledby="sa-report-rules">
        <h2 id="sa-report-rules" class="so-panel-title">Bilgi bankası kuralları</h2>
        <div class="d-flex flex-wrap gap-2">
            <SoMetric Label="Değerlendirilen hesap" Value="@rules.Assessed.ToString()" />
            <SoMetric Label="Kurala aykırı (plansız)" Value="@rules.AgainstRule.ToString()" />
            @foreach (NamedCount path in rules.ByPath.Where(p => p.Count > 0)) { <SoMetric Label="@path.Label" Value="@path.Count.ToString()" /> }
        </div>
        <p class="so-panel-text--sm mt-1">Durum: @string.Join(" · ", rules.ByConformance.Select(c => $"{c.Label} {c.Count}")) · kural sürümü @rules.RuleSetVersion</p>
        @if (rules.Lines.Count > 0)
        {
            <MudTable Items="rules.Lines" Dense="true" Breakpoint="Breakpoint.Sm" T="RuleLine" Class="mt-2">
                <HeaderContent><MudTh>Hesap</MudTh><MudTh>Sahip ekip</MudTh><MudTh>Önerilen yol</MudTh><MudTh>Durum</MudTh><MudTh>Neden</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Hesap">@context.Account</MudTd><MudTd DataLabel="Sahip ekip">@(context.OwnerTeam ?? "—")</MudTd>
                    <MudTd DataLabel="Önerilen yol">@context.Path<div class="so-panel-text--sm">@context.RuleCodes</div></MudTd>
                    <MudTd DataLabel="Durum">@context.Conformance</MudTd><MudTd DataLabel="Neden"><span class="so-panel-text--sm">@context.Reason</span></MudTd>
                </RowTemplate>
            </MudTable>
        }
    </section>
}

@if (Report.Funnel is { } funnel)
{
    int top = Math.Max(1, funnel.Stages.Max(st => st.Count));
    <section class="so-panel" aria-labelledby="sa-report-funnel">
        <h2 id="sa-report-funnel" class="so-panel-title">gMSA hunisi (@funnel.Population hesap)</h2>
        <table class="sa-bars" aria-describedby="sa-report-funnel">
            <thead><tr><th scope="col">Aşama</th><th scope="col">Hesap</th><th scope="col">Beklenen</th></tr></thead>
            <tbody>
                @foreach (FunnelStage stage in funnel.Stages)
                {
                    <tr>
                        <th scope="row">@stage.Label</th>
                        <td><span class="sa-bar" style="--sa-bar:@Percent(stage.Count, top)" title="@($"{stage.Label}: {stage.Count}")" aria-hidden="true"></span><span class="sa-bar-value">@stage.Count</span></td>
                        <td class="so-panel-text--sm">@stage.Expected</td>
                    </tr>
                }
                <tr><th scope="row">Uygun değil</th><td><span class="sa-bar-value">@funnel.Ineligible</span></td><td class="so-panel-text--sm">Huniden ayrı sayılır.</td></tr>
            </tbody>
        </table>
        <p class="so-panel-text--sm mt-1">@funnel.Note</p>
    </section>
}

@if (Report.Trend is { } trend)
{
    int peak = Math.Max(1, trend.Points.Max(p => p.OpenAtWeekEnd));
    <section class="so-panel" aria-labelledby="sa-report-trend">
        <h2 id="sa-report-trend" class="so-panel-title">Trend (son @trend.Points.Count hafta)</h2>
        <table class="sa-bars" aria-describedby="sa-report-trend">
            <thead><tr><th scope="col">Hafta</th><th scope="col">Hafta sonu açık talep</th><th scope="col">Geciken</th><th scope="col">Doğrulanmış kapanış</th><th scope="col">Gerçekleşen işlem</th></tr></thead>
            <tbody>
                @foreach (TrendPoint point in trend.Points)
                {
                    <tr>
                        <th scope="row">@point.WeekStart.ToString("dd.MM.yyyy")</th>
                        <td><span class="sa-bar" style="--sa-bar:@Percent(point.OpenAtWeekEnd, peak)" title="@($"{point.WeekStart:dd.MM}: {point.OpenAtWeekEnd} açık")" aria-hidden="true"></span><span class="sa-bar-value">@point.OpenAtWeekEnd</span></td>
                        <td>@point.OverdueAtWeekEnd</td><td>@point.VerifiedClosures</td><td>@point.PerformedActions</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="so-panel-text--sm mt-1">@trend.Note@(trend.UnknownCloseTime > 0 ? $" Kapanış zamanı bilinmeyen talep: {trend.UnknownCloseTime}." : "")</p>
    </section>
}

@if (Report.Risk is { } risk)
{
    <section class="so-panel" aria-labelledby="sa-report-risk">
        <h2 id="sa-report-risk" class="so-panel-title">Risk adayları (@risk.Candidates)</h2>
        <p class="so-panel-text--sm">@string.Join(" · ", risk.ByCategory.Select(c => $"{c.Label}: {c.Count}"))</p>
        @if (risk.Lines.Count == 0) { <SoEmptyState Title="Risk adayı yok" /> }
        else
        {
            <MudTable Items="risk.Lines" Dense="true" Breakpoint="Breakpoint.Sm" T="RiskLine">
                <HeaderContent><MudTh>Hesap</MudTh><MudTh>Sahip ekip</MudTh><MudTh>Neden</MudTh><MudTh>Kaynak tarihi</MudTh><MudTh>Son oturum</MudTh><MudTh>Son parola</MudTh><MudTh>Açık talep</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Hesap">@context.Account</MudTd><MudTd DataLabel="Sahip ekip">@(context.OwnerTeam ?? "—")</MudTd>
                    <MudTd DataLabel="Neden">@context.Categories</MudTd><MudTd DataLabel="Kaynak tarihi">@ServiceAccountUiText.Date(context.SourceDate)</MudTd>
                    <MudTd DataLabel="Son oturum">@ServiceAccountUiText.Date(context.LastLogon, "Yok")</MudTd>
                    <MudTd DataLabel="Son parola">@ServiceAccountUiText.Date(context.PasswordLastSet, "Yok")</MudTd><MudTd DataLabel="Açık talep">@context.OpenRequests</MudTd>
                </RowTemplate>
            </MudTable>
        }
        <p class="so-panel-text--sm mt-1">@risk.Note</p>
    </section>
}

@if (Report.Rules is null)
{
    <p class="so-panel-text--sm">Bu nüsha @Report.MetricDefinitionVersion metrik sürümüyle kaydedildi; kural, huni, trend, risk ve direktörlük bölümleri bu sürümde yoktur.</p>
}

@code {
    /// <summary>Report payload.</summary>
    [Parameter] public ServiceAccountReport Report { get; set; } = default!;

    /// <summary>Heading.</summary>
    [Parameter] public string Title { get; set; } = "Özet";

    private ReportSummary S => Report.Summary;

    private static string Percent(int value, int max) =>
        (value * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private IEnumerable<(string, PlacementCounts)> Placements =>
    [
        ("Gerçekleşen işlem bildirimi", Report.Weekly.Actions),
        ("Doğrulanmış kapanış", Report.Weekly.VerifiedClosures),
        ("Geçerli e-posta", Report.Weekly.Mails)
    ];
}
