@* Expected work (requests). A request closes only by an explicit command whose rule the API checks: completion
   needs a matching performed action (and a verified closure for deletion/gMSA handover); other outcomes need a reason. *@
@using SecureOps.Domain.ServiceAccounts
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts

<section class="so-panel" aria-labelledby="sa-requests">
    <div class="so-panel-head"><h2 id="sa-requests" class="so-panel-title">Beklenen işler</h2></div>
    @if (Detail.Requests.Count == 0)
    {
        <SoEmptyState Title="Kayıtlı iş yok" Description="Bu hesap için beklenen bir iş açılmadı." />
    }
    else
    {
        <MudTable Items="Detail.Requests" Dense="true" Breakpoint="Breakpoint.Sm" T="RequestView">
            <HeaderContent><MudTh>İş</MudTh><MudTh>Durum</MudTh><MudTh>Hedef / takip</MudTh><MudTh>Plan</MudTh><MudTh>Yazışma</MudTh><MudTh>İşlem</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="İş">@context.ActionLabel<div class="so-panel-text--sm">@ServiceAccountUiText.References(context.References)</div>
                    @if (context.RequestedGmsaName is { } gmsaName)
                    {
                        <div class="so-panel-text--sm sa-wrap-anywhere">İstenen gMSA adı: @gmsaName (@ServiceAccountGmsaName.Length(gmsaName)/@ServiceAccountGmsaName.Limit)</div>
                    }
                </MudTd>
                <MudTd DataLabel="Durum">
                    @if (context.Status == "Open")
                    {
                        @if (context.Overdue) { <SoStatusBadge Label="Plan bitişi geçti" Tone="SoStatusBadge.BadgeTone.Critical" Icon="@Icons.Material.Filled.Warning" /> }
                        else if (context.AwaitingDate) { <SoStatusBadge Label="Tarih bekleniyor" Tone="SoStatusBadge.BadgeTone.Caution" Icon="@Icons.Material.Filled.EventBusy" /> }
                        else { <SoStatusBadge Label="Açık" Tone="SoStatusBadge.BadgeTone.Info" Icon="@Icons.Material.Filled.PendingActions" /> }
                    }
                    else
                    {
                        <SoStatusBadge Label="@("Kapalı · " + ServiceAccountUiText.Outcome(context.CloseOutcome))" Tone="SoStatusBadge.BadgeTone.Neutral" Icon="@Icons.Material.Filled.CheckCircleOutline" />
                        @if (context.CloseReason is not null) { <div class="so-panel-text--sm">@context.CloseReason</div> }
                    }
                </MudTd>
                <MudTd DataLabel="Hedef / takip">
                    @(context.TargetTeam?.Label ?? "Hedef ekip yok")
                    <div class="so-panel-text--sm">Takipçi: @(context.FollowupPerson?.Label ?? "yok") · Muhatap: @(context.ContactPerson?.Label ?? "yok")</div>
                </MudTd>
                <MudTd DataLabel="Plan">
                    @(context.PlanStart is null && context.PlanEnd is null ? "Tarih yok" : $"{ServiceAccountUiText.Date(context.PlanStart, "?")} – {ServiceAccountUiText.Date(context.PlanEnd, "?")}")
                    <div class="so-panel-text--sm">Sonraki takip: @ServiceAccountUiText.Date(context.NextFollowupOn, "yok")</div>
                </MudTd>
                <MudTd DataLabel="Yazışma">İlk gönderim: @ServiceAccountUiText.Date(context.FirstSentOn, "yok")<div class="so-panel-text--sm">Son yanıt: @ServiceAccountUiText.Date(context.LastReplyOn, "yok")</div></MudTd>
                <MudTd DataLabel="İşlem">
                    @if (context.Status == "Open" && Detail.Permissions.CanWorkRequest(context.Id))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Select(context))" aria-expanded="@((_selected?.Id == context.Id).ToString().ToLowerInvariant())">@(Detail.Permissions.Work ? "Güncelle / kapat" : "Güncelle")</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @if (_selected is { } selected && Detail.Permissions.CanWorkRequest(selected.Id))
    {
        <section class="so-panel mt-2" aria-label="@($"{selected.ActionLabel} talebini güncelle")">
            <h3 class="so-panel-title">@selected.ActionLabel talebi</h3>
            <MudGrid Spacing="2">
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_edit.NextFollowupOn" Label="Sonraki takip" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_edit.PlanStart" Label="Plan başlangıcı" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_edit.PlanEnd" Label="Plan bitişi" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_edit.PlanAnnouncedOn" Label="Planın bildirildiği gün" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_edit.FirstSentOn" Label="İlk gönderim" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_edit.LastReplyOn" Label="Son yanıt" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6"><SaPersonPicker Label="Takipçi kişi" @bind-Value="_edit.FollowupPersonId" /></MudItem>
                @if (IsGmsaWork(selected.ActionType))
                {
                    <MudItem xs="12" md="6"><SaGmsaNameField @bind-Value="_edit.RequestedGmsaName" Available="@Detail.RequestedGmsaNameAvailable" /></MudItem>
                }
                <MudItem xs="12"><MudTextField @bind-Value="_edit.Notes" Label="Not" MaxLength="4000" Lines="2" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6" Class="d-flex flex-wrap gap-3">
                    <MudCheckBox T="bool" @bind-Value="_edit.ClearPlan" Label="Plan tarihlerini temizle" />
                    <MudCheckBox T="bool" @bind-Value="_edit.ClearFollowup" Label="Sonraki takibi temizle" />
                    @if (IsGmsaWork(selected.ActionType) && selected.RequestedGmsaName is not null && Detail.RequestedGmsaNameAvailable)
                    {
                        <MudCheckBox T="bool" @bind-Value="_edit.ClearGmsaName" Label="İstenen gMSA adını temizle" />
                    }
                </MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.Reason" Label="Gerekçe (temizleme için zorunlu)" MaxLength="1000" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            <MudButton OnClick="UpdateAsync" Disabled="Busy" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Talebi güncelle</MudButton>

            @if (Detail.Permissions.Work)
            {
            <h3 class="so-panel-title mt-4">Talebi kapat</h3>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_closeOutcome" Label="Sonuç" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("Completed")">Tamamlandı (gerçekleşen işlem gerekir)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("NotNeeded")">Gerek kalmadı</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Cancelled")">İptal</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="8"><MudTextField @bind-Value="_closeReason" Label="Gerekçe" MaxLength="1000" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Kapatma, talebi açık işler ve hatırlatmalar listesinden çıkarır. Hesap kaydı silinmez.</MudAlert>
            <MudButton OnClick="CloseAsync" Disabled="Busy" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2">Talebi kapat</MudButton>
            }
            else
            {
                <p class="so-panel-text--sm mt-2">Talebin kapatılması hesaptan sorumlu ekipte; işlem bildiriminiz kapanış için değerlendirilir.</p>
            }
        </section>
    }

    @if (Detail.Permissions.Work)
    {
        <SaDisclosure Class="mt-2" Title="Yeni iş (talep) aç">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_create.ActionType" Label="Beklenen iş" Variant="Variant.Outlined">
                        @foreach ((string value, string label) in ServiceAccountUiText.Actions) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="Guid?" @bind-Value="_create.TargetTeamId" Label="Hedef ekip" Clearable="true" Variant="Variant.Outlined">
                        @foreach (TeamView team in Teams) { <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4"><SaPersonPicker Label="Takipçi kişi" @bind-Value="_create.FollowupPersonId" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_create.PlanStart" Label="Plan başlangıcı" DateFormat="dd.MM.yyyy" Clearable="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_create.PlanEnd" Label="Plan bitişi" DateFormat="dd.MM.yyyy" Clearable="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudDatePicker Editable="true" @bind-Date="_create.NextFollowupOn" Label="Sonraki takip" DateFormat="dd.MM.yyyy" Clearable="true" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="3"><MudTextField @bind-Value="_create.OrNumber" Label="@(_create.ActionType == "Deletion" ? "OR numarası (silme kapanışı için gerekli)" : "OR numarası")" MaxLength="64" Variant="Variant.Outlined" /></MudItem>
                @if (IsGmsaWork(_create.ActionType))
                {
                    <MudItem xs="12" md="6"><SaGmsaNameField @bind-Value="_create.RequestedGmsaName" Available="@Detail.RequestedGmsaNameAvailable" /></MudItem>
                }
                <MudItem xs="12"><MudTextField @bind-Value="_create.Notes" Label="Not" MaxLength="4000" Lines="2" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            <MudButton OnClick="CreateAsync" Disabled="Busy" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Talebi aç</MudButton>
        </SaDisclosure>
    }
</section>

@code {
    private RequestView? _selected;
    private EditModel _edit = new();
    private CreateModel _create = new();
    private string _closeOutcome = "Completed";
    private string? _closeReason;
    private int _seenRevision = -1;

    /// <summary>Account detail.</summary>
    [Parameter] public AccountDetail Detail { get; set; } = default!;

    /// <summary>Team choices.</summary>
    [Parameter] public IReadOnlyList<TeamView> Teams { get; set; } = [];

    /// <summary>Call in flight.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Page revision; a new value means the last command was saved.</summary>
    [Parameter] public int Revision { get; set; }

    /// <summary>Command sink.</summary>
    [Parameter] public EventCallback<SaCommand> OnCommand { get; set; }

    protected override void OnParametersSet()
    {
        if (_seenRevision != Revision)
        {
            _seenRevision = Revision;
            (_selected, _edit, _create, _closeOutcome, _closeReason) = (null, new(), new(), "Completed", null);
        }
        else if (_selected is not null)
        {
            // Keep typed input but follow the server's current version (for example after a conflict reload).
            _selected = Detail.Requests.FirstOrDefault(r => r.Id == _selected.Id && r.Status == "Open");
        }
    }

    private void Select(RequestView request)
    {
        _selected = _selected?.Id == request.Id ? null : request;
        _edit = new EditModel
        {
            NextFollowupOn = ServiceAccountUiText.ToPicker(request.NextFollowupOn),
            PlanStart = ServiceAccountUiText.ToPicker(request.PlanStart),
            PlanEnd = ServiceAccountUiText.ToPicker(request.PlanEnd),
            PlanAnnouncedOn = ServiceAccountUiText.ToPicker(request.PlanAnnouncedOn),
            FirstSentOn = ServiceAccountUiText.ToPicker(request.FirstSentOn),
            LastReplyOn = ServiceAccountUiText.ToPicker(request.LastReplyOn),
            FollowupPersonId = request.FollowupPerson?.Id,
            Notes = request.Notes,
            RequestedGmsaName = request.RequestedGmsaName
        };
    }

    private Task UpdateAsync()
    {
        RequestView request = _selected!;
        List<string> clear = [];
        if (_edit.ClearPlan) { clear.Add("plan"); }
        if (_edit.ClearFollowup) { clear.Add("nextFollowupOn"); }
        if (_edit.ClearGmsaName) { clear.Add("requestedGmsaName"); }
        UpdateWorkRequest body = new(request.Version,
            FollowupPersonId: Changed(_edit.FollowupPersonId, request.FollowupPerson?.Id),
            PlanStart: _edit.ClearPlan ? null : Changed(ServiceAccountUiText.ToDate(_edit.PlanStart), request.PlanStart),
            PlanEnd: _edit.ClearPlan ? null : Changed(ServiceAccountUiText.ToDate(_edit.PlanEnd), request.PlanEnd),
            PlanAnnouncedOn: Changed(ServiceAccountUiText.ToDate(_edit.PlanAnnouncedOn), request.PlanAnnouncedOn),
            NextFollowupOn: _edit.ClearFollowup ? null : Changed(ServiceAccountUiText.ToDate(_edit.NextFollowupOn), request.NextFollowupOn),
            FirstSentOn: Changed(ServiceAccountUiText.ToDate(_edit.FirstSentOn), request.FirstSentOn),
            LastReplyOn: Changed(ServiceAccountUiText.ToDate(_edit.LastReplyOn), request.LastReplyOn),
            Notes: string.IsNullOrWhiteSpace(_edit.Notes) || _edit.Notes == request.Notes ? null : _edit.Notes.Trim(),
            ClearFields: clear.Count > 0 ? clear : null,
            Reason: string.IsNullOrWhiteSpace(_edit.Reason) ? null : _edit.Reason.Trim(),
            RequestedGmsaName: _edit.ClearGmsaName || string.IsNullOrWhiteSpace(_edit.RequestedGmsaName) || _edit.RequestedGmsaName.Trim() == request.RequestedGmsaName
                ? null : _edit.RequestedGmsaName.Trim());
        return OnCommand.InvokeAsync(new SaCommand(HttpMethod.Patch, $"/requests/{request.Id}", body));
    }

    private Task CloseAsync() => OnCommand.InvokeAsync(new SaCommand(HttpMethod.Post, $"/requests/{_selected!.Id}/close",
        new CloseWorkRequest(_selected.Version, _closeOutcome, string.IsNullOrWhiteSpace(_closeReason) ? null : _closeReason.Trim())));

    private Task CreateAsync() => OnCommand.InvokeAsync(new SaCommand(HttpMethod.Post, $"/accounts/{Detail.Summary.Id}/requests",
        new CreateWorkRequest(_create.ActionType, _create.TargetTeamId, _create.FollowupPersonId, null, ServiceAccountUiText.ToDate(_create.PlanStart),
            ServiceAccountUiText.ToDate(_create.PlanEnd), null, ServiceAccountUiText.ToDate(_create.NextFollowupOn), null, null,
            string.IsNullOrWhiteSpace(_create.Notes) ? null : _create.Notes.Trim(),
            string.IsNullOrWhiteSpace(_create.OrNumber) ? null : [new SaExternalRef("OR", _create.OrNumber.Trim())],
            IsGmsaWork(_create.ActionType) && !string.IsNullOrWhiteSpace(_create.RequestedGmsaName) ? _create.RequestedGmsaName.Trim() : null)));

    /// <summary>The requested gMSA name belongs to gMSA work only (the server enforces the same).</summary>
    private static bool IsGmsaWork(string actionType) => actionType is "GmsaHandover" or "GmsaConversion";

    /// <summary>Only a changed, non-empty value is sent: blank never erases (clearing is explicit).</summary>
    private static T? Changed<T>(T? value, T? current) where T : struct => value is { } v && !v.Equals(current) ? v : null;

    private sealed class EditModel
    {
        public DateTime? NextFollowupOn { get; set; }
        public DateTime? PlanStart { get; set; }
        public DateTime? PlanEnd { get; set; }
        public DateTime? PlanAnnouncedOn { get; set; }
        public DateTime? FirstSentOn { get; set; }
        public DateTime? LastReplyOn { get; set; }
        public Guid? FollowupPersonId { get; set; }
        public string? Notes { get; set; }
        public bool ClearPlan { get; set; }
        public bool ClearFollowup { get; set; }
        public bool ClearGmsaName { get; set; }
        public string? RequestedGmsaName { get; set; }
        public string? Reason { get; set; }
    }

    private sealed class CreateModel
    {
        public string ActionType { get; set; } = "Evaluate";
        public Guid? TargetTeamId { get; set; }
        public Guid? FollowupPersonId { get; set; }
        public DateTime? PlanStart { get; set; }
        public DateTime? PlanEnd { get; set; }
        public DateTime? NextFollowupOn { get; set; }
        public string? OrNumber { get; set; }
        public string? RequestedGmsaName { get; set; }
        public string? Notes { get; set; }
    }
}
