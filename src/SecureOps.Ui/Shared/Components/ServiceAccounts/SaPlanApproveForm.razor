@* Approval of exactly one preview: the person confirms they looked at this version and digest, gives the OCO number (format only, never
   looked up in ITSM) and the maintenance window with an explicit UTC offset, and a reason. The request carries the preview version and
   SHA-256, so a changed plan is refused as stale. The page shows this form only when the server says the caller may approve.
   A missing or unreadable field is marked on the field itself (aria-invalid + message under it), not only in one summary line. *@
@using SecureOps.Domain.ServiceAccounts
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts

<div class="sa-plan-approve">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_oco" Label="OCO numarası" MaxLength="64" Immediate="true" Variant="Variant.Outlined" Required="true"
                          Error="@(OcoError is not null || Has("oco"))" ErrorText="@(OcoError ?? Msg("oco"))"
                          HelperText="Sunucu doğrular ve BÜYÜK HARFE çevirip kaydeder (en çok 64 karakter; A–Z 0–9 - _ . /; harf veya rakamla başlar, en az bir rakam). ITSM'de sorgulanmaz." />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_start" Label="Bakım penceresi başlangıcı" InputType="InputType.DateTimeLocal" Variant="Variant.Outlined" Required="true"
                          Error="@Has("start")" ErrorText="@Msg("start")" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_end" Label="Bakım penceresi bitişi" InputType="InputType.DateTimeLocal" Variant="Variant.Outlined" Required="true"
                          Error="@Has("end")" ErrorText="@Msg("end")" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_offset" Label="UTC farkı" MaxLength="6" Immediate="true" Variant="Variant.Outlined"
                          Error="@Has("offset")" ErrorText="@Msg("offset")"
                          HelperText="Varsayılan İstanbul (+03:00); pencere saatleri bu farkla kaydedilir." />
        </MudItem>
        <MudItem xs="12" md="8">
            <MudTextField T="string" @bind-Value="_reason" Label="Onay gerekçesi" MaxLength="1000" Lines="2" Immediate="true" Variant="Variant.Outlined" Required="true"
                          Error="@Has("reason")" ErrorText="@Msg("reason")" />
        </MudItem>
    </MudGrid>
    <div role="alert">
        @if (_error is not null) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_error</MudAlert> }
    </div>
    <SoConfirmStatement Text="@($"Önizleme sürüm {Plan.Preview!.Version} (özet {ChangePlanPresentation.ShortDigest(Plan.Preview.Sha256)}…) satırlarını ve işaret sayılarını inceledim; bu sürümü onaylıyorum.")"
                        Checked="_acknowledged" CheckedChanged="@(v => _acknowledged = v)" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="SubmitAsync" Disabled="@(Busy || !_acknowledged)" aria-describedby="sa-approve-why">Önizlemeyi onayla</MudButton>
    @if (!_acknowledged) { <p id="sa-approve-why" class="so-panel-text--sm mt-1">Düğme pasif: önce yukarıdaki “inceledim” onay kutusunu işaretleyin.</p> }
</div>

@code {
    private string _oco = string.Empty;
    private string _start = string.Empty;
    private string _end = string.Empty;
    private string _offset = DefaultOffset();
    private string _reason = string.Empty;
    private bool _acknowledged;
    private string? _error;
    private readonly Dictionary<string, string> _fieldErrors = [];

    /// <summary>The previewed plan being approved.</summary>
    [Parameter, EditorRequired] public ChangePlanView Plan { get; set; } = default!;

    /// <summary>A command is running.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>The server's refusal of the OCO number (400 field <c>ocoNumber</c>), shown under the field; the client has no format rule of its own.</summary>
    [Parameter] public string? OcoError { get; set; }

    /// <summary>Sends the approval; the form keeps its values until the page confirms the save.</summary>
    [Parameter, EditorRequired] public EventCallback<ApproveChangePlanRequest> OnApprove { get; set; }

    /// <summary>Istanbul's offset as the starting point (these screens show Turkish time everywhere); the person can change it.</summary>
    private static string DefaultOffset()
    {
        TimeSpan offset = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, ReportCalendar.Istanbul).Offset;
        return (offset < TimeSpan.Zero ? "-" : "+") + offset.Duration().ToString(@"hh\:mm");
    }

    private bool Has(string field) => _fieldErrors.ContainsKey(field);

    private string? Msg(string field) => _fieldErrors.GetValueOrDefault(field);

    private async Task SubmitAsync()
    {
        _error = null;
        _fieldErrors.Clear();
        if (Plan.Preview is not { } preview)
        {
            _error = "Önizleme yok; önce önizleme oluşturulmalı.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_oco)) { _fieldErrors["oco"] = "OCO numarası gerekli."; }
        if (string.IsNullOrWhiteSpace(_reason)) { _fieldErrors["reason"] = "Onay gerekçesi gerekli."; }

        string offset = _offset.Trim();
        bool offsetOk = AnnouncementTime.ValidOffset(offset);
        if (!offsetOk) { _fieldErrors["offset"] = "UTC farkını +03:00 biçiminde girin."; }

        DateTimeOffset start = default, end = default;
        bool startOk = offsetOk && TryInstant(_start, offset, out start);
        bool endOk = offsetOk && TryInstant(_end, offset, out end);
        if (string.IsNullOrWhiteSpace(_start)) { _fieldErrors["start"] = "Başlangıç tarih-saati gerekli."; }
        else if (offsetOk && !startOk) { _fieldErrors["start"] = "Başlangıcı tarih-saat olarak girin."; }
        if (string.IsNullOrWhiteSpace(_end)) { _fieldErrors["end"] = "Bitiş tarih-saati gerekli."; }
        else if (offsetOk && !endOk) { _fieldErrors["end"] = "Bitişi tarih-saat olarak girin."; }
        if (startOk && endOk && end <= start) { _fieldErrors["end"] = "Bitiş, başlangıçtan sonra olmalı."; }

        if (_fieldErrors.Count > 0)
        {
            _error = $"Onaylanmadı: {_fieldErrors.Count} alan eksik veya hatalı; mesajlar alanların altında.";
            return;
        }

        await OnApprove.InvokeAsync(new ApproveChangePlanRequest(preview.Version, preview.Sha256, _oco.Trim(), start, end, _reason.Trim()));
    }

    private static bool TryInstant(string local, string offset, out DateTimeOffset instant) =>
        AnnouncementTime.TryRead(local.Trim() + (local.Trim().Length == 16 ? ":00" : string.Empty) + offset, out instant) && local.Trim().Length >= 16;
}
