@* Draws one ReportChart from the report payload; it computes nothing new. Bars are HTML so labels stay readable at 390 px;
   the trend line is an SVG polyline under HTML markers so text never scales with the plot. Identity is never colour alone:
   series have distinct marker shapes and printed values, and every chart has a table view. *@
@using System.Globalization
@using SecureOps.Domain.ServiceAccounts

<figure class="sa-chart" aria-labelledby="@($"{_id}-title")">
    <figcaption id="@($"{_id}-title")" class="sa-chart-title">@Chart.Title</figcaption>
    @if (Chart.Series.Count > 1)
    {
        <ul class="sa-chart-legend" aria-hidden="true">
            @for (int s = 0; s < Chart.Series.Count; s++)
            {
                ReportChartSeries series = Chart.Series[s];
                <li>
                    <span class="sa-key sa-key--@(s + 1)"></span>@series.Name
                    @if (Chart.Kind == ReportChartKind.Line && series.Values.Count > 0) { <span class="sa-chart-last">· son @Format(series.Values[^1])</span> }
                </li>
            }
        </ul>
    }

    @if (Chart.IsEmpty)
    {
        <p class="sa-chart-empty">Bu dönemde gösterilecek değer yok; tüm değerler 0.</p>
    }
    else if (Chart.Kind == ReportChartKind.Line)
    {
        long top = NiceTop(Chart.Peak);
        <div class="sa-line" aria-hidden="true">
            <div class="sa-line-grid">
                <span style="bottom:100%">@Format(top)</span><span style="bottom:50%">@Format(top / 2)</span><span style="bottom:0">0</span>
            </div>
            <div class="sa-line-plot">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
                    <line class="sa-line-rule" x1="0" y1="50" x2="100" y2="50" />
                    @for (int s = Chart.Series.Count - 1; s >= 0; s--)
                    {
                        <polyline class="sa-stroke--@(s + 1)" points="@Points(Chart.Series[s].Values, top)" />
                    }
                </svg>
                @for (int s = 0; s < Chart.Series.Count; s++)
                {
                    ReportChartSeries series = Chart.Series[s];
                    @for (int i = 0; i < series.Values.Count; i++)
                    {
                        <span class="sa-mark sa-mark--@(s + 1)" style="left:@X(i, series.Values.Count);bottom:@Y(series.Values[i], top)"
                              title="@($"{series.Name} · {Chart.Categories[i]}: {Format(series.Values[i])}")"></span>
                    }
                }
            </div>
            <div class="sa-line-axis">
                @for (int i = 0; i < Chart.Categories.Count; i++) { <span style="left:@X(i, Chart.Categories.Count)">@Chart.Categories[i]</span> }
            </div>
        </div>
    }
    else
    {
        long top = Chart.Peak;
        <ul class="sa-hbars" aria-hidden="true">
            @for (int i = 0; i < Chart.Categories.Count; i++)
            {
                <li class="sa-hbar-group">
                    <span class="sa-hbar-label">@Chart.Categories[i]</span>
                    <span class="sa-hbar-rows">
                        @for (int s = 0; s < Chart.Series.Count; s++)
                        {
                            long value = Chart.Series[s].Values[i];
                            <span class="sa-hbar-row" title="@($"{Chart.Categories[i]} · {Chart.Series[s].Name}: {Format(value)}")">
                                <span class="sa-hbar-track"><span class="sa-hbar-fill sa-fill--@(s + 1)" style="width:@Percent(value, top)"></span></span>
                                <span class="sa-hbar-value">@Format(value)</span>
                            </span>
                        }
                    </span>
                </li>
            }
        </ul>
    }

    <details class="sa-chart-data" open="@Chart.IsEmpty">
        <summary>Tablo olarak göster</summary>
        <div class="sa-chart-table-wrap">
            <table class="sa-chart-table">
                <caption class="sr-only">@Chart.Title</caption>
                <thead><tr><th scope="col">@(Chart.Kind == ReportChartKind.Line ? "Hafta başı" : "Kalem")</th>@foreach (ReportChartSeries series in Chart.Series) { <th scope="col">@series.Name</th> }</tr></thead>
                <tbody>
                    @for (int i = 0; i < Chart.Categories.Count; i++)
                    {
                        <tr><th scope="row">@Chart.Categories[i]</th>@foreach (ReportChartSeries series in Chart.Series) { <td>@Format(series.Values[i])</td> }</tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
    @if (Chart.Note is { Length: > 0 } note) { <p class="sa-chart-note">@note</p> }
</figure>

@code {
    private static int _sequence;
    private readonly string _id = "sa-chart-" + Interlocked.Increment(ref _sequence).ToString(CultureInfo.InvariantCulture);

    /// <summary>Chart built by <see cref="ReportCharts"/> from the same payload as the tables.</summary>
    [Parameter, EditorRequired] public ReportChart Chart { get; set; } = default!;

    private static string Format(long value) => value.ToString(CultureInfo.InvariantCulture);

    private static string Percent(long value, long top) =>
        (value * 100.0 / top).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string X(int index, int count) =>
        (count == 1 ? 50.0 : index * 100.0 / (count - 1)).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string Y(long value, long top) => Percent(value, top);

    private static string Points(IReadOnlyList<long> values, long top) => string.Join(' ', values.Select((v, i) =>
        (values.Count == 1 ? 50.0 : i * 100.0 / (values.Count - 1)).ToString("0.##", CultureInfo.InvariantCulture) + "," +
        (100 - v * 100.0 / top).ToString("0.##", CultureInfo.InvariantCulture)));

    /// <summary>Rounds the axis top up to an even 1-10 × 10^k step so the mid gridline is a whole, readable number.</summary>
    internal static long NiceTop(long peak)
    {
        long magnitude = 1;
        while (magnitude * 10 <= peak) { magnitude *= 10; }
        foreach (long step in new long[] { 1, 2, 4, 5, 6, 8, 10 })
        {
            if (step * magnitude >= peak && step * magnitude % 2 == 0) { return step * magnitude; }
        }

        return 10 * magnitude;
    }
}
