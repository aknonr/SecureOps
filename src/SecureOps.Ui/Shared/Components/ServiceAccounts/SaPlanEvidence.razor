@* Evidence attached to the plan itself (change record screenshot, mail, maintenance notes): same file types and size bound as account
   evidence; the server also checks the file signature. Upload exists only when the server's plan permissions allow it, and a
   server without migration 034 refuses honestly (nothing is saved). Downloads are authorized and audited by the API. *@
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts

<div class="sa-plan-evidence">
    <h3 class="sa-plan-evidence-title">Plan kanıtı</h3>
    @if (Plan.Evidence is not { Count: > 0 } files)
    {
        <p class="so-panel-text--sm" role="note">Bu plana eklenmiş kanıt dosyası yok.</p>
    }
    else
    {
        <MudTable Items="files" Dense="true" Breakpoint="Breakpoint.Sm" T="EvidenceView" Class="sa-plan-table">
            <HeaderContent><MudTh>Dosya</MudTh><MudTh>Boyut</MudTh><MudTh>Eklenme</MudTh><MudTh>İndir</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Dosya">@context.FileName<div class="so-panel-text--sm">@(context.Label ?? "")</div></MudTd>
                <MudTd DataLabel="Boyut">@($"{context.SizeBytes / 1024.0:0.#} KB")</MudTd>
                <MudTd DataLabel="Eklenme">@ChangePlanPresentation.Instant(context.CreatedAt)</MudTd>
                <MudTd DataLabel="İndir">
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" Disabled="Busy" OnClick="@(() => OnDownload.InvokeAsync(context.Id))">İndir</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @if (Plan.Permissions.UploadEvidence)
    {
        <SaDisclosure Class="mt-2" Title="Plana kanıt dosyası ekle">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_label" Label="Açıklama" MaxLength="200" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="6">
                    <label class="so-panel-text" for="sa-plan-evidence-file">@SaEvidenceFileRules.Hint</label>
                    <InputFile @key="_inputKey" id="sa-plan-evidence-file" OnChange="ChooseAsync" accept="@SaEvidenceFileRules.Accept" />
                </MudItem>
            </MudGrid>
            <div role="alert">
                @if (_fileError is not null) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_fileError</MudAlert> }
            </div>
            <MudButton OnClick="UploadAsync" Disabled="@(Busy || _file is null)" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Dosyayı yükle</MudButton>
        </SaDisclosure>
    }
    else if (Plan.Status is "Approved" or "InProgress" or "Completed")
    {
        <p class="so-panel-text--sm mt-1" role="note">Kanıt ekleme yetkiniz görünmüyor (Çalışma yetkisi ve planın tüm hesaplarında sorumlu dayanak gerekir).</p>
    }
</div>

@code {
    private (string Name, string Type, byte[] Content)? _file;
    private string? _label, _fileError;
    private int _inputKey;

    /// <summary>The plan (evidence list and permissions come from the server).</summary>
    [Parameter, EditorRequired] public ChangePlanView Plan { get; set; } = default!;

    /// <summary>A call is running.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Sends the file; true when the server saved it (the form then clears). After a refusal the chosen file and label stay.</summary>
    [Parameter, EditorRequired] public Func<SaEvidenceUpload, Task<bool>> OnUpload { get; set; } = default!;

    /// <summary>Download sink (evidence id).</summary>
    [Parameter] public EventCallback<Guid> OnDownload { get; set; }

    private async Task ChooseAsync(InputFileChangeEventArgs args)
    {
        (_file, _fileError) = (null, null);
        IBrowserFile file = args.File;
        if (SaEvidenceFileRules.Refusal(file.Name, file.Size) is { } refusal)
        {
            _fileError = refusal;
            return;
        }

        SaEvidenceFileRules.TryGetContentType(file.Name, out string type);
        using MemoryStream buffer = new();
        await using Stream stream = file.OpenReadStream(SaEvidenceFileRules.MaxBytes);
        await stream.CopyToAsync(buffer);
        _file = (file.Name, type, buffer.ToArray());
    }

    private async Task UploadAsync()
    {
        (string name, string type, byte[] content) = _file!.Value;
        if (await OnUpload(new SaEvidenceUpload("ChangePlan", Plan.Id, name, type, content, string.IsNullOrWhiteSpace(_label) ? null : _label.Trim())))
        {
            (_file, _label, _fileError) = (null, null, null);
            _inputKey++;
        }
    }
}
