@*
    The loading state, in the product's own visual language.

    A small aircraft follows a curved route: the flown portion is brand red, the remainder is a
    neutral track. It is drawn as inline SVG with CSS animation — no image, no animation library, no
    external request — so it costs nothing to load and follows the theme through the same tokens as
    everything else.

    It reports progress; it does not measure it. The route length is not tied to how far along a
    request is, because the server does not report that, and a bar that appeared to track real
    progress would be inventing information. What it communicates is "this is working, wait".

    Accessibility is not the animation. The role, the live region, and the message carry the state,
    so an operator who cannot see motion — or has asked not to be shown any — gets the same
    information. Under prefers-reduced-motion the aircraft parks at the origin and nothing travels.
*@

<div class="so-flight @(Bare ? "so-flight--bare" : null)" role="status" aria-live="polite" aria-busy="true">
    <div class="so-flight-card">
        <svg class="so-flight-svg" viewBox="0 0 520 190" role="presentation" aria-hidden="true" focusable="false">
            <defs>
                <radialGradient id="so-loading-hub" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#e8394e" stop-opacity="0.92" />
                    <stop offset="100%" stop-color="#e8394e" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="so-loading-aircraft" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="60%" stop-color="#e5eaf0" />
                    <stop offset="100%" stop-color="#aeb9c6" />
                </linearGradient>
            </defs>

            <image class="so-flight-map" href="brand/world-land.svg" x="20" y="6" width="480" height="165"
                   preserveAspectRatio="xMidYMid meet" />

            <path class="so-flight-track" d="@RoutePath" />
            <path class="so-flight-flown" d="@RoutePath" />

            <circle class="so-flight-hub-glow" cx="246" cy="66" r="22" fill="url(#so-loading-hub)" />
            <circle class="so-flight-node" cx="246" cy="66" r="4" />

            <image class="so-flight-emblem" href="brand/approved/thy-emblem-256.png"
                   x="326" y="28" width="46" height="46" />

            <g class="so-flight-plane">
                <g transform="scale(0.72)">
                    <path class="so-flight-plane-shadow"
                          d="M36 0 C33 -3 29 -4 24 -4 L10 -4 L-6 -25 L-13 -25 L-4 -4 L-20 -4 L-29 -12 L-34 -12 L-29 -3 L-34 -2 L-34 2 L-29 3 L-34 12 L-29 12 L-20 4 L-4 4 L-13 25 L-6 25 L10 4 L24 4 C29 4 33 3 36 0 Z" />
                    <path fill="url(#so-loading-aircraft)"
                          d="M36 0 C33 -3 29 -4 24 -4 L10 -4 L-6 -25 L-13 -25 L-4 -4 L-20 -4 L-29 -12 L-34 -12 L-29 -3 L-34 -2 L-34 2 L-29 3 L-34 12 L-29 12 L-20 4 L-4 4 L-13 25 L-6 25 L10 4 L24 4 C29 4 33 3 36 0 Z" />
                    <path class="so-flight-plane-tail" d="M-30 -3 L-25 -14 L-19 -14 L-20 -3 Z" />
                </g>
            </g>
        </svg>

        <div class="so-flight-copy">
            <p class="so-flight-title">Yükleniyor...</p>
            <p class="so-flight-message">@Message</p>
        </div>

        <span class="so-flight-activity" aria-hidden="true"><span></span></span>
    </div>
</div>

@code {
    // A single shallow arc. Deliberately gentle: a steep climb reads as a departure graphic, and
    // this is a progress indicator that happens to be aviation-shaped, not an illustration.
    private const string RoutePath = "M 246 66 Q 340 142 468 82";

    /// <summary>Message describing what is being fetched.</summary>
    /// <remarks>
    /// Should name the work rather than the mechanism — "AD grup bilgileri getiriliyor…" tells an
    /// operator what is happening; "İstek gönderiliyor…" does not.
    /// </remarks>
    [Parameter]
    public string Message { get; set; } = "Yükleniyor…";

    /// <summary>Renders inline within a panel instead of as a standalone block.</summary>
    [Parameter]
    public bool Bare { get; set; }
}
