@*
    Account menu in the app bar.

    Replaces the previous plain role caption. The trigger shows who is signed in — not what they are
    allowed to do — because permissions belong to the account page where they can be shown in full and
    with context.
*@

@implements IDisposable
@inject ICurrentAccessProvider AccessProvider

<MudMenu AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         Dense="true"
         PopoverClass="so-user-menu-popover">
    <ActivatorContent>
        @* MudBlazor 9: a custom activator opens the menu itself through MenuContext. *@
        <button type="button" class="so-user-trigger" title="@User.DisplayName" aria-label="Hesap menüsü"
                aria-haspopup="menu" @onclick="@(args => context.ToggleAsync(args))">
            <span class="so-avatar" aria-hidden="true">@User.Initials</span>
            <span class="so-user-trigger-text">
                <span class="so-user-trigger-name">@User.DisplayName</span>
                @if (_statusCaption is not null)
                {
                    <span class="so-user-trigger-meta">@_statusCaption</span>
                }
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="so-user-trigger-caret" />
        </button>
    </ActivatorContent>

    <ChildContent>
        <div class="so-user-menu-head">
            <span class="so-avatar so-avatar--lg" aria-hidden="true">@User.Initials</span>
            <div>
                <p class="so-user-menu-name">@User.DisplayName</p>
                <p class="so-user-menu-account">@User.AccountName</p>
            </div>
        </div>

        @if (_snapshot is not null)
        {
            <div class="so-user-menu-status">
                <SoStatusBadge Label="@AccessStatusLabel"
                               Tone="@AccessStatusTone"
                               Icon="@AccessStatusIcon" />
                @if (_snapshot.IsResolved && _snapshot.Roles.Count > 0)
                {
                    <span class="so-user-menu-roles">@RoleSummary</span>
                }
            </div>
        }

        <MudDivider Class="my-1" />

        <MudMenuItem Href="account" Icon="@Icons.Material.Filled.AccountCircle">Hesabım</MudMenuItem>
        <MudMenuItem Href="access/me" Icon="@Icons.Material.Filled.VerifiedUser">Erişimim</MudMenuItem>

        <MudDivider Class="my-1" />

        @* Operators choose between the daytime and deep corporate presentations. *@
        <div class="so-appearance-label">Görünüm</div>
        @foreach ((AppearanceMode mode, string label, string icon) in Appearances)
        {
            AppearanceMode captured = mode;
            <MudMenuItem Icon="@icon"
                         OnClick="@(() => OnSelectMode.InvokeAsync(captured))"
                         Class="@(mode == Mode ? "so-appearance--active" : null)">
                @label
                @if (mode == Mode)
                {
                    <span class="sr-only">(seçili)</span>
                }
            </MudMenuItem>
        }

        <MudDivider Class="my-1" />

        @* A plain link, not an interactive callback: sign-out must clear the cookie through a real
           server round-trip, which a circuit-scoped click handler cannot do. *@
        <MudMenuItem Href="auth/sign-out" ForceLoad="true" Icon="@Icons.Material.Filled.Logout">
            Oturumu kapat
        </MudMenuItem>
    </ChildContent>
</MudMenu>

@code {
    /// <summary>Signed-in principal shown in the trigger and menu head.</summary>
    [Parameter, EditorRequired]
    public SignedInUser User { get; set; } = default!;

    /// <summary>Active appearance mode.</summary>
    [Parameter]
    public AppearanceMode Mode { get; set; }

    /// <summary>Invoked when the operator picks an appearance.</summary>
    [Parameter]
    public EventCallback<AppearanceMode> OnSelectMode { get; set; }

    private static readonly (AppearanceMode Mode, string Label, string Icon)[] Appearances =
    [
        (AppearanceMode.Light, "Aydınlık", Icons.Material.Filled.LightMode),
        (AppearanceMode.Dark, "Koyu", Icons.Material.Filled.DarkMode)
    ];

    private AccessSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _snapshot = await AccessProvider.GetAsync();
    }

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    // Only non-approved states earn a caption under the name; showing "Approved" on every page would
    // be noise, while pending and disabled are states the operator must not miss.
    private string? _statusCaption => _snapshot switch
    {
        { IsPending: true } => "Onay bekliyor",
        { IsDisabled: true } => "Devre dışı",
        { IsResolved: false } => "Erişim doğrulanamadı",
        _ => null
    };

    private string AccessStatusLabel => _snapshot switch
    {
        { IsApproved: true } => "Erişim onaylı",
        { IsPending: true } => "Erişim onayı bekleniyor",
        { IsDisabled: true } => "Erişim devre dışı",
        _ => "Erişim durumu bilinmiyor"
    };

    private SoStatusBadge.BadgeTone AccessStatusTone => _snapshot switch
    {
        { IsApproved: true } => SoStatusBadge.BadgeTone.Positive,
        { IsPending: true } => SoStatusBadge.BadgeTone.Caution,
        { IsDisabled: true } => SoStatusBadge.BadgeTone.Critical,
        _ => SoStatusBadge.BadgeTone.Neutral
    };

    private string AccessStatusIcon => _snapshot switch
    {
        { IsApproved: true } => Icons.Material.Filled.CheckCircle,
        { IsPending: true } => Icons.Material.Filled.HourglassTop,
        { IsDisabled: true } => Icons.Material.Filled.NoAccounts,
        _ => Icons.Material.Filled.HelpOutline
    };

    private string RoleSummary =>
        string.Join(", ", _snapshot!.Roles.Select(AccessLabels.RoleLabel));

    public void Dispose() => AccessProvider.Changed -= OnAccessChanged;
}
