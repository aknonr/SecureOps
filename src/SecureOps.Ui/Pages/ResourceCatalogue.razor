@page "/admin/resources"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.Extensions.Logging
@using SecureOps.Domain.Resources
@using SecureOps.Shared.Contracts.Resources
@inject IResourceApiClient ResourceApi
@inject ICurrentAccessProvider AccessProvider
@inject IDialogService Dialogs
@inject ILogger<ResourceCatalogue> Logger

<PageTitle>Bağlantı Yönetimi · @WasasBrand.Name</PageTitle>

<div class="so-page so-page--wide so-resource-page so-resource-management">
    <SoPageHeader Title="Bağlantı Yönetimi" Lead="Ortak uygulama bağlantılarını yayımlayın, kategorileri düzenleyin ve kullanım dışı kayıtları arşivleyin.">
        <Actions>
            <MudButton Href="resources" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Link">Uygulama Bağlantıları</MudButton>
            <MudTooltip Text="Yenile"><MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Yenile"
                Disabled="_busy" OnClick="ReloadAsync" /></MudTooltip>
        </Actions>
    </SoPageHeader>
    @if (_access is null) { <SoLoading Message="Yetkileriniz doğrulanıyor…" /> }
    else if (!_access.IsResolved) { <SoProblemPanel Problem="_access.Problem!" OnRetry="ReloadAccessAsync" /> }
    else if (!_access.Can(Capabilities.ResourcesManage) || !_access.Can(Capabilities.ResourcesView))
    {
        <section class="so-panel so-panel--blocked">
            <h2 class="so-panel-title">Bu alana erişim yetkiniz yok</h2>
            <p class="so-panel-text">Bağlantı yönetimi ayrıca atanmış yetki gerektirir. Unvan tek başına bu yetkiyi sağlamaz. <MudLink Href="access/me">Erişimim</MudLink> sayfasından mevcut yetkilerinizi kontrol edin.</p>
        </section>
    }
    else
    {
        <ResourceHelp Surface="management" CanManage="true" Preferences="_guidePreferences"
                      PreferencesChanged="GuidePreferencesChanged" Disabled="_busy" />
        @if (_problem is not null) { <SoProblemPanel Problem="_problem" OnRetry="ReloadAsync" RetryLabel="Güncel kayıtları yükle" /> }
        <div class="so-management-toolbar">
            <div class="so-resource-tabs" role="group" aria-label="Yönetim görünümü" data-guide="management-tabs">
                <MudButton StartIcon="@Icons.Material.Filled.Link" Class="@(!_showCategories ? "is-selected" : null)"
                           aria-pressed="@(!_showCategories)" OnClick="@(() => _showCategories = false)">Bağlantılar</MudButton>
                <MudButton StartIcon="@Icons.Material.Outlined.Folder" Class="@(_showCategories ? "is-selected" : null)"
                           aria-pressed="@_showCategories" OnClick="@(() => _showCategories = true)">Kategoriler</MudButton>
            </div>
            <div data-guide="archive-filter">
                <MudCheckBox T="bool" Value="_includeArchived" ValueChanged="ToggleArchivedAsync" Label="Arşivlenenleri göster" Dense="true" />
            </div>
        </div>
        @if (_showCategories)
        {
            <section aria-label="Kategori yönetimi">
                <div class="so-resource-results-head">
                    <h2>Kategoriler <span class="so-count-chip">@_categories.Count</span></h2>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               data-guide="new-entry" OnClick="CreateCategoryAsync" Disabled="_busy">Yeni kategori</MudButton>
                </div>
                @if (_busy && _categories.Count == 0) { <SoLoading Message="Kategoriler yükleniyor…" /> }
                else if (_categories.Count == 0) { <SoEmptyState Title="Henüz kategori yok" Description="Bağlantılarınızı düzenlemek için ilk kategoriyi oluşturun." Icon="@Icons.Material.Outlined.FolderOpen" /> }
                else
                {
                    <div class="so-table-scroll">
                        <table class="so-plain-table so-management-table">
                            <caption class="sr-only">Ortak bağlantı kategorileri</caption>
                            <thead><tr><th scope="col">Kategori</th><th scope="col" class="so-management-secondary">Sıra</th><th scope="col">Görünürlük</th><th scope="col">Durum</th><th scope="col"><span class="sr-only">İşlem</span></th></tr></thead>
                            <tbody>
                                @foreach (ResourceCategory category in _categories)
                                {
                                    <tr>
                                        <th scope="row">@category.Name</th>
                                        <td class="so-management-secondary">@category.DisplayOrder</td>
                                        <td>@(category.ManagersOnly ? "Yönetim yetkisi olanlar" : "Tüm yetkili kullanıcılar")</td>
                                        <td><SoStatusBadge Label="@(category.Archived ? "Arşivlenmiş" : "Etkin")" Tone="@(category.Archived ? SoStatusBadge.BadgeTone.Neutral : SoStatusBadge.BadgeTone.Positive)" /></td>
                                        <td><MudButton StartIcon="@Icons.Material.Outlined.Edit" Size="Size.Small" Disabled="_busy"
                                            aria-label="@($"{category.Name}: Düzenle")" OnClick="@(() => EditCategoryAsync(category))">Düzenle</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else
        {
            <section aria-label="Bağlantı yönetimi">
                <div class="so-management-search">
                    <MudTextField T="string" Value="_search" ValueChanged="SearchChangedAsync" Label="Bağlantı ara" aria-label="Bağlantı ara"
                                  Immediate="true" DebounceInterval="350" MaxLength="100" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Clearable="true" Class="so-resource-search" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" data-guide="new-entry"
                               OnClick="CreateLinkAsync" Disabled="@(_busy || !_categories.Any(c => !c.Archived))">Yeni bağlantı</MudButton>
                </div>
                @if (!_categories.Any(c => !c.Archived) && !_busy)
                {
                    <p class="so-panel-text">Bağlantı eklemek için etkin bir kategori gerekir.</p>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="CreateCategoryAsync">Kategori oluştur</MudButton>
                }
                @if (_page is null && _problem is null) { <SoLoading Message="Bağlantılar yükleniyor…" /> }
                else if (_page is { Items.Count: 0 }) { <SoEmptyState Title="Bağlantı bulunamadı" Description="Aramanızı değiştirin veya yeni bağlantı ekleyin." Icon="@Icons.Material.Outlined.LinkOff" /> }
                else if (_page is not null)
                {
                    <div class="so-resource-results-head"><span role="status">@_page.Total bağlantı @(_busy ? "· Güncelleniyor…" : null)</span></div>
                    <div class="so-table-scroll">
                        <table class="so-plain-table so-management-table">
                            <caption class="sr-only">Ortak uygulama bağlantıları</caption>
                            <thead><tr><th scope="col">Bağlantı</th><th scope="col" class="so-management-secondary">Kategori</th><th scope="col" class="so-management-secondary">Ortam</th><th scope="col">Durum</th><th scope="col"><span class="sr-only">İşlem</span></th></tr></thead>
                            <tbody>
                                @foreach (ResourceLink link in _page.Items)
                                {
                                    <tr>
                                        <th scope="row"><span class="so-set-body"><strong>@link.Name</strong><span class="so-resource-host">@ResourceView.Host(link)</span></span></th>
                                        <td class="so-management-secondary">@CategoryName(link.CategoryId)</td>
                                        <td class="so-management-secondary">@(ResourceView.Placement(link) ?? "Belirtilmedi")</td>
                                        <td><SoStatusBadge Label="@(link.Archived ? "Arşivlenmiş" : link.Active ? "Etkin" : "Pasif")"
                                            Tone="@(link.Archived ? SoStatusBadge.BadgeTone.Neutral : link.Active ? SoStatusBadge.BadgeTone.Positive : SoStatusBadge.BadgeTone.Caution)" /></td>
                                        <td><MudButton StartIcon="@Icons.Material.Outlined.Edit" Size="Size.Small" Disabled="_busy"
                                            aria-label="@($"{link.Name}: Düzenle")" OnClick="@(() => EditLinkAsync(link))">Düzenle</MudButton></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (TotalPages > 1 || _page.Page > 1)
                    {
                        <div class="so-pager">
                            <MudButton StartIcon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_busy || _page.Page <= 1)" OnClick="@(() => GoToPageAsync(_page.Page - 1))">Önceki</MudButton>
                            <span class="so-pager-state">Sayfa @_page.Page / @TotalPages</span>
                            <MudButton EndIcon="@Icons.Material.Filled.ChevronRight" Disabled="@(_busy || _page.Page >= TotalPages)" OnClick="@(() => GoToPageAsync(_page.Page + 1))">Sonraki</MudButton>
                        </div>
                    }
                }
            </section>
        }
        <p class="so-panel-text so-panel-text--sm so-resource-footer">Arşivlenen kayıtlar normal listelerden gizlenir; kişisel gruplardaki kayıtlı seçimler korunur.</p>
    }
</div>

@code {
    private AccessSnapshot? _access;
    private IReadOnlyList<ResourceCategory> _categories = [];
    private ResourcePage? _page;
    private UiProblem? _problem;
    private bool _busy;
    private bool _includeArchived;
    private bool _showCategories;
    private ResourcePreferencesResponse? _guidePreferences;
    private void GuidePreferencesChanged(ResourcePreferencesResponse preferences) => _guidePreferences = preferences;
    private string _search = string.Empty;
    private int _pageNumber = 1;
    private int _requestId;
    private CancellationTokenSource? _searchCancellation;

    private int TotalPages =>
        _page is null || _page.PageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_page.PageSize));

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _access = await AccessProvider.GetAsync(CancellationToken.None);

        if (_access.Can(Capabilities.ResourcesManage))
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAccessAsync()
    {
        _access = await AccessProvider.RefreshAsync(CancellationToken.None);

        if (_access.Can(Capabilities.ResourcesManage))
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _problem = null;
        await LoadCategoriesAsync();
        await LoadLinksAsync();
        try { _guidePreferences = await ResourceApi.GetPreferencesAsync(CancellationToken.None); }
        catch (SecureOpsApiException exception) { _problem = exception.Problem; }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            _categories = await ResourceApi.GetCategoriesAsync(_includeArchived, CancellationToken.None);
        }
        catch (SecureOpsApiException ex)
        {
            _problem = ex.Problem;
            Logger.LogDebug("Category load failed. Code: {Code}.", ex.Problem.Code);
        }
    }

    private async Task LoadLinksAsync()
    {
        int id = ++_requestId;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        CancellationToken token = _searchCancellation.Token;
        _busy = true;
        StateHasChanged();

        try
        {
            ResourcePage page = await ResourceApi.QueryLinksAsync(
                new ResourceQuery(
                    Search: string.IsNullOrWhiteSpace(_search) ? null : _search,
                    IncludeArchived: _includeArchived,
                    Page: _pageNumber,
                    PageSize: 50),
                token);

            if (id != _requestId)
            {
                return;
            }

            _page = page;
            _pageNumber = page.Page;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Superseded searches do not publish a failure.
        }
        catch (SecureOpsApiException ex)
        {
            if (id != _requestId)
            {
                return;
            }

            _problem = ex.Problem;
            Logger.LogDebug("Catalogue query failed. Code: {Code}.", ex.Problem.Code);
        }
        finally
        {
            if (id == _requestId)
            {
                _busy = false;
                StateHasChanged();
            }
        }
    }

    private Task ToggleArchivedAsync(bool value)
    {
        _includeArchived = value;
        _pageNumber = 1;
        return ReloadAsync();
    }

    private Task SearchChangedAsync(string value)
    {
        _search = value ?? string.Empty;
        _pageNumber = 1;
        return LoadLinksAsync();
    }

    private Task GoToPageAsync(int page)
    {
        _pageNumber = Math.Max(1, page);
        return LoadLinksAsync();
    }

    private string CategoryName(Guid id) =>
        _categories.FirstOrDefault(category => category.Id == id)?.Name ?? "—";

    private Task CreateCategoryAsync() => ShowCategoryDialogAsync(null);

    private Task EditCategoryAsync(ResourceCategory category) => ShowCategoryDialogAsync(category);

    private async Task ShowCategoryDialogAsync(ResourceCategory? category)
    {
        DialogParameters parameters = new()
        {
            { nameof(ResourceCategoryDialog.Category), category },
            { nameof(ResourceCategoryDialog.Save), (Func<SaveResourceCategoryRequest, Task<UiProblem?>>)(request =>
                SaveAsync(() => category is null
                    ? ResourceApi.CreateCategoryAsync(request, CancellationToken.None)
                    : ResourceApi.SaveCategoryAsync(category.Id, request, CancellationToken.None))) }
        };

        IDialogReference dialog = await Dialogs.ShowAsync<ResourceCategoryDialog>(
            "Kategori", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, DisableBackdropClick = true, CloseOnEscapeKey = false });
        await dialog.Result;
    }

    private Task CreateLinkAsync() => ShowLinkDialogAsync(null);

    private Task EditLinkAsync(ResourceLink link) => ShowLinkDialogAsync(link);

    private async Task ShowLinkDialogAsync(ResourceLink? link)
    {
        DialogParameters parameters = new()
        {
            { nameof(ResourceLinkDialog.Link), link },
            { nameof(ResourceLinkDialog.Categories), _categories },
            { nameof(ResourceLinkDialog.Save), (Func<SaveResourceLinkRequest, Task<UiProblem?>>)(request =>
                SaveAsync(() => link is null
                    ? ResourceApi.CreateLinkAsync(request, CancellationToken.None)
                    : ResourceApi.SaveLinkAsync(link.Id, request, CancellationToken.None))) }
        };

        IDialogReference dialog = await Dialogs.ShowAsync<ResourceLinkDialog>(
            "Bağlantı", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, DisableBackdropClick = true, CloseOnEscapeKey = false });
        await dialog.Result;
    }

    // One place for every catalogue write. On a version conflict the current state is reloaded and
    // the problem stays on screen: the operator sees what somebody else saved before deciding
    // whether to reapply their change, and nothing is resubmitted automatically.
    private async Task<UiProblem?> SaveAsync(Func<Task> save)
    {
        if (_busy)
        {
            return UiProblemFactory.FromResponse(409, null);
        }

        _busy = true;
        _problem = null;
        StateHasChanged();

        try
        {
            await save();
            await ReloadAsync();
            return null;
        }
        catch (SecureOpsApiException ex)
        {
            _problem = ex.Problem;
            Logger.LogDebug(
                "Catalogue save failed. Code: {Code}. CorrelationId: {CorrelationId}.",
                ex.Problem.Code,
                ex.Problem.CorrelationId);

            await ReloadAsync();
            _problem = ex.Problem;
            return ex.Problem;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnAccessChanged() => InvokeAsync(async () =>
    {
        _access = await AccessProvider.GetAsync(CancellationToken.None);
        StateHasChanged();
    });

    public void Dispose()
    {
        AccessProvider.Changed -= OnAccessChanged;
        ++_requestId;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
    }
}
