@page "/resources"
@attribute [Authorize]
@implements IDisposable
@using SecureOps.Domain.Resources
@using SecureOps.Shared.Contracts.Resources
@inject IResourceApiClient ResourceApi
@inject ICurrentAccessProvider AccessProvider
@inject IDialogService Dialogs

<PageTitle>Uygulama Bağlantıları · @WasasBrand.Name</PageTitle>

<div class="so-page so-page--wide so-resource-page">
    <SoPageHeader Title="Uygulama Bağlantıları" Lead="İhtiyacınız olan uygulamayı bulun; sık kullandıklarınızı favorilere veya kişisel gruplara ekleyin.">
        <Actions>
            <MudButton Href="resources/sets" StartIcon="@Icons.Material.Outlined.Folder" Variant="Variant.Outlined"
                       data-guide="groups-link">Bağlantı Gruplarım</MudButton>
            <MudTooltip Text="Yenile"><MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Yenile"
                Disabled="@(_query.Loading || _busy)" OnClick="ReloadAsync" /></MudTooltip>
        </Actions>
    </SoPageHeader>

    @if (_access is null) { <SoLoading Message="Yetkileriniz doğrulanıyor…" /> }
    else if (!_access.IsResolved) { <SoProblemPanel Problem="_access.Problem!" OnRetry="ReloadAccessAsync" /> }
    else if (!_access.Can(Capabilities.ResourcesView))
    {
        <section class="so-panel so-panel--blocked">
            <h2 class="so-panel-title">Bu alana erişim yetkiniz yok</h2>
            <p class="so-panel-text">Uygulama bağlantıları için görüntüleme yetkisi gerekir. <MudLink Href="access/me">Erişimim</MudLink> sayfasından hesabınızın durumunu kontrol edin.</p>
        </section>
    }
    else
    {
        <ResourceHelp Preferences="_preferences" PreferencesChanged="PreferencesChanged" CanManage="@_access.Can(Capabilities.ResourcesManage)" Disabled="_busy" />
        <section class="so-resource-discovery" aria-label="Bağlantı arama ve filtreler">
            <div class="so-resource-filters" data-guide="resource-search">
                <MudTextField T="string" Value="_search" ValueChanged="SearchChangedAsync" Label="Bağlantı ara" aria-label="Bağlantı ara"
                              Placeholder="Ad, amaç veya etiket" Immediate="true" DebounceInterval="350" MaxLength="100"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="so-resource-search" />
                <MudSelect T="Guid?" Value="_categoryId" ValueChanged="CategoryChangedAsync" Label="Kategori" aria-label="Kategori"
                           Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Class="so-resource-filter">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Tüm kategoriler</MudSelectItem>
                    @foreach (ResourceCategory category in _categories) { <MudSelectItem T="Guid?" Value="@category.Id">@category.Name</MudSelectItem> }
                </MudSelect>
                <ResourceEnvironmentFilter @key="_categoryId" Value="@_environment" ValueChanged="EnvironmentChangedAsync" CategoryId="_categoryId" />
            </div>
            <div class="so-resource-viewbar">
                <div class="so-resource-tabs" role="group" aria-label="Bağlantı görünümü" data-guide="favourites">
                    <MudButton Variant="Variant.Text" Class="@(!_favouritesOnly ? "is-selected" : null)" aria-pressed="@(!_favouritesOnly)"
                               OnClick="@(() => SetFavouritesAsync(false))">Tüm bağlantılar</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.StarBorder" Class="@(_favouritesOnly ? "is-selected" : null)"
                               aria-pressed="@_favouritesOnly" OnClick="@(() => SetFavouritesAsync(true))" Disabled="@(_preferences is null)">
                        Favorilerim <span class="so-count-chip">@(_preferences?.Favourites.Count ?? 0)</span>
                    </MudButton>
                </div>
                @if (HasFilters) { <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ClearFiltersAsync">Filtreleri temizle</MudButton> }
            </div>
        </section>

        @if (_actionProblem is not null) { <SoProblemPanel Problem="_actionProblem" /> }
        @if (_preferencesProblem is not null) { <SoProblemPanel Problem="_preferencesProblem" OnRetry="LoadPreferencesAsync" /> }
        @if (_categoriesProblem is not null) { <SoProblemPanel Problem="_categoriesProblem" OnRetry="LoadCategoriesAsync" /> }

        <section class="so-resource-results" aria-label="Bağlantılar" aria-busy="@_query.Loading">
            @if (!_favouritesOnly && _query.Problem is not null) { <SoProblemPanel Problem="_query.Problem" OnRetry="SearchAsync" RetryLabel="Yeniden yükle" /> }
            else if (CurrentPage is not { } result) { <SoLoading Message="Bağlantılar getiriliyor…" /> }
            else
            {
                <div class="so-resource-results-head">
                    <span role="status">@result.Total bağlantı @(_query.Loading ? "· Güncelleniyor…" : null)</span>
                    <div class="so-resource-filters">
                        <MudSelect T="int" Value="_pageSize" ValueChanged="PageSizeChangedAsync" Label="Sayfa boyutu" aria-label="Sayfa boyutu"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="so-page-size">
                            @foreach (int size in ResourceView.PageSizes) { <MudSelectItem T="int" Value="@size">@size</MudSelectItem> }
                        </MudSelect>
                    </div>
                </div>
                @if (result.Items.Count == 0)
                {
                    <SoEmptyState Title="@(_favouritesOnly && !HasFilters ? "Henüz favoriniz yok" : HasFilters ? "Eşleşen bağlantı yok" : "Henüz yayımlanmış bağlantı yok")"
                                  Description="@(_favouritesOnly ? "Tek bir bağlantıyı hızlı bulmak için Favorilere ekle eylemini kullanın." : "Aramanızı değiştirebilir veya daha sonra tekrar kontrol edebilirsiniz.")"
                                  Icon="@Icons.Material.Outlined.LinkOff" />
                    <MudButton OnClick="DiscoverAsync" StartIcon="@Icons.Material.Filled.Search">Tüm bağlantılara dön</MudButton>
                }
                else
                {
                    <ul class="so-resource-list">
                        @foreach (ResourceLink link in result.Items)
                        {
                            <ResourceLinkRow @key="link.Id" Link="link" CategoryName="@_categories.FirstOrDefault(c => c.Id == link.CategoryId)?.Name"
                                Favourite="@ResourceView.IsFavourite(_preferences, link.Id)" Disabled="@(_busy || _preferences is null)"
                                OnFavourite="@(() => ToggleFavouriteAsync(link))" OnAdd="@(() => AddToSetAsync(link))" />
                        }
                    </ul>
                }
                @if (result.Total > _pageSize || result.Page > 1)
                {
                    <div class="so-pager">
                        <MudButton StartIcon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_query.Loading || result.Page <= 1)"
                                   OnClick="@(() => GoToPageAsync(result.Page - 1))">Önceki</MudButton>
                        <span class="so-pager-state">Sayfa @result.Page / @Math.Max(1, (int)Math.Ceiling(result.Total / (double)_pageSize))</span>
                        <MudButton EndIcon="@Icons.Material.Filled.ChevronRight" Disabled="@(_query.Loading || result.Page * _pageSize >= result.Total)"
                                   OnClick="@(() => GoToPageAsync(result.Page + 1))">Sonraki</MudButton>
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private AccessSnapshot? _access;
    private ResourcePreferencesResponse? _preferences;
    private IReadOnlyList<ResourceCategory> _categories = [];
    private readonly ResourceQueryState _query = new();
    private UiProblem? _actionProblem, _preferencesProblem, _categoriesProblem;
    private bool _busy, _favouritesOnly;
    private string _search = string.Empty, _environment = string.Empty;
    private Guid? _categoryId;
    private int _pageSize = 25, _pageNumber = 1;
    private bool HasFilters => !string.IsNullOrWhiteSpace(_search) || _categoryId is not null || !string.IsNullOrWhiteSpace(_environment);
    private ResourceQuery Query => new(Search: _search, CategoryId: _categoryId, Environment: _environment, Page: _pageNumber, PageSize: _pageSize);
    private ResourcePage? CurrentPage => _favouritesOnly ? ResourceView.FavouritePage(_preferences, Query) : _query.Page;

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _access = await AccessProvider.GetAsync();
        if (_access.Can(Capabilities.ResourcesView)) await ReloadAsync();
    }

    private async Task ReloadAccessAsync()
    {
        _access = await AccessProvider.RefreshAsync(CancellationToken.None);
        if (_access.Can(Capabilities.ResourcesView)) await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await LoadCategoriesAsync();
        await LoadPreferencesAsync();
        await SearchAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        try { _categories = await ResourceApi.GetCategoriesAsync(false, CancellationToken.None); _categoriesProblem = null; }
        catch (SecureOpsApiException exception) { _categories = []; _categoriesProblem = exception.Problem; }
    }

    private async Task LoadPreferencesAsync()
    {
        try { _preferences = await ResourceApi.GetPreferencesAsync(CancellationToken.None); _preferencesProblem = null; }
        catch (SecureOpsApiException exception) { _preferences = null; _preferencesProblem = exception.Problem; }
    }

    private void PreferencesChanged(ResourcePreferencesResponse preferences) => _preferences = preferences;
    private Task SearchChangedAsync(string value) { _search = value ?? string.Empty; _pageNumber = 1; return SearchAsync(); }
    private Task CategoryChangedAsync(Guid? value) { _categoryId = value; _environment = string.Empty; _pageNumber = 1; return SearchAsync(); }
    private Task EnvironmentChangedAsync(string value) { _environment = value ?? string.Empty; _pageNumber = 1; return SearchAsync(); }
    private Task PageSizeChangedAsync(int value) { _pageSize = value; _pageNumber = 1; return SearchAsync(); }
    private Task GoToPageAsync(int value) { _pageNumber = Math.Max(1, value); return SearchAsync(); }
    private Task SetFavouritesAsync(bool value) { _favouritesOnly = value; _pageNumber = 1; return SearchAsync(); }
    private Task ClearFiltersAsync() { _search = _environment = string.Empty; _categoryId = null; _pageNumber = 1; return SearchAsync(); }
    private Task DiscoverAsync() { _favouritesOnly = false; return ClearFiltersAsync(); }

    private async Task SearchAsync()
    {
        if (_favouritesOnly) return;
        Task pending = _query.LoadAsync(Query, ResourceApi.QueryLinksAsync);
        StateHasChanged();
        await pending;
    }

    private async Task ToggleFavouriteAsync(ResourceLink link)
    {
        if (_preferences is null || _busy) return;
        _busy = true;
        _actionProblem = null;
        try
        {
            _preferences = await ResourceApi.SetFavouriteAsync(link.Id, !ResourceView.IsFavourite(_preferences, link.Id), _preferences.Version, CancellationToken.None);
            if (_favouritesOnly && CurrentPage is { Items.Count: 0, Page: > 1 }) _pageNumber--;
        }
        catch (SecureOpsApiException exception) { _actionProblem = exception.Problem; await LoadPreferencesAsync(); }
        finally { _busy = false; }
    }

    private async Task AddToSetAsync(ResourceLink link)
    {
        if (_preferences is null || _busy) return;
        DialogParameters parameters = new()
        {
            { nameof(ResourceSetPickerDialog.Link), link },
            { nameof(ResourceSetPickerDialog.Preferences), _preferences },
            { nameof(ResourceSetPickerDialog.Save), (Func<Guid?, SaveShiftSetRequest, Task<UiProblem?>>)SaveGroupAsync }
        };
        IDialogReference dialog = await Dialogs.ShowAsync<ResourceSetPickerDialog>("Gruba ekle", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, DisableBackdropClick = true, CloseOnEscapeKey = false });
        await dialog.Result;
    }

    private async Task<UiProblem?> SaveGroupAsync(Guid? id, SaveShiftSetRequest request)
    {
        if (_busy) return UiProblemFactory.FromResponse(409, null);
        _busy = true;
        _actionProblem = null;
        try
        {
            _preferences = id is { } groupId ? await ResourceApi.SaveSetAsync(groupId, request, CancellationToken.None)
                : await ResourceApi.CreateSetAsync(request, CancellationToken.None);
            return null;
        }
        catch (SecureOpsApiException exception) { _actionProblem = exception.Problem; await LoadPreferencesAsync(); return exception.Problem; }
        finally { _busy = false; }
    }

    private void OnAccessChanged() => InvokeAsync(async () => { _access = await AccessProvider.GetAsync(); StateHasChanged(); });
    public void Dispose() { AccessProvider.Changed -= OnAccessChanged; _query.Dispose(); }
}
