@page "/resources"
@attribute [Authorize]
@implements IDisposable
@using SecureOps.Domain.Resources
@using SecureOps.Shared.Contracts.Resources
@inject IResourceApiClient ResourceApi
@inject ICurrentAccessProvider AccessProvider
@inject IDialogService Dialogs

<PageTitle>Uygulama Bağlantıları · @WasasBrand.Name</PageTitle>

<div class="so-page so-page--wide so-resource-page so-workspace so-workspace--@Layout.View so-workspace--@Layout.Density">
    <SoPageHeader Title="Uygulama Bağlantıları">
        <Actions>
            <MudButton Href="resources/sets" StartIcon="@Icons.Material.Outlined.Folder" Variant="Variant.Outlined" data-guide="groups-link">Kişisel bağlantı gruplarım</MudButton>
            <MudIconButton Icon="@Icons.Material.Outlined.DashboardCustomize" aria-label="Çalışma alanını düzenle" title="Çalışma alanını düzenle"
                           data-guide="personalize" Disabled="@(_busy || _preferences is null)" OnClick="OpenLayoutAsync" />
            <MudTooltip Text="Yenile"><MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Yenile"
                Disabled="@(_query.Loading || _busy || _reloading)" OnClick="ReloadAsync" /></MudTooltip>
        </Actions>
    </SoPageHeader>

    @if (_access is null) { <SoLoading Message="Yetkileriniz doğrulanıyor…" /> }
    else if (!_access.IsResolved) { <SoProblemPanel Problem="_access.Problem!" OnRetry="ReloadAccessAsync" /> }
    else if (!_access.Can(Capabilities.ResourcesView))
    {
        <section class="so-panel so-panel--blocked">
            <h2 class="so-panel-title">Bu alana erişim yetkiniz yok</h2>
            <p class="so-panel-text">Uygulama bağlantıları için görüntüleme yetkisi gerekir. <MudLink Href="access/me">Erişimim</MudLink> sayfasından hesabınızın durumunu kontrol edin.</p>
        </section>
    }
    else
    {
        <nav class="so-workspace-shortcuts" aria-label="Çalışma alanı kısayolları">
            @foreach (string key in Layout.Shortcuts.Where(k => k is not ("links" or "groups") && ResourceWorkspaceView.Permitted(_access, k)))
            { <a href="@ResourceWorkspaceView.Href(key)">@ResourceWorkspaceView.Label(key)</a> }
        </nav>
        <ResourceHelp Preferences="_preferences" PreferencesChanged="PreferencesChanged" CanManage="@_access.Can(Capabilities.ResourcesManage)" Disabled="_busy" />
        <section class="so-resource-discovery" aria-label="Bağlantı arama ve filtreler">
            <div class="so-resource-filters" data-guide="resource-search">
                <div class="so-field so-resource-search"><span class="so-field-label">Bağlantı ara</span>
                <MudTextField T="string" Value="@_search" ValueChanged="SearchChangedAsync" aria-label="Bağlantı ara"
                              Placeholder="Ad, amaç veya etiket" Immediate="true" DebounceInterval="350" MaxLength="100"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </div>
                <label class="so-field"><span>Kategori</span><select value="@_categoryId" @onchange="e => CategoryChangedAsync(Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null)">
                    <option value="">Tüm kategoriler</option>
                    @foreach (ResourceCategory category in _categories) { <option value="@category.Id">@category.Name</option> }
                </select></label>
                <ResourceEnvironmentFilter @key="_categoryId" Value="@_environment" ValueChanged="EnvironmentChangedAsync" CategoryId="_categoryId" />
            </div>
            <div class="so-resource-viewbar">
                <div class="so-resource-tabs" role="group" aria-label="Bağlantı görünümü" data-guide="favourites">
                    <MudButton Variant="Variant.Text" Class="@(!_favouritesOnly ? "is-selected" : null)" aria-pressed="@(!_favouritesOnly)"
                               OnClick="@(() => SetFavouritesAsync(false))">Tüm bağlantılar</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.StarBorder" Class="@(_favouritesOnly ? "is-selected" : null)"
                               aria-pressed="@_favouritesOnly" OnClick="@(() => SetFavouritesAsync(true))" Disabled="@(_preferences is null)">
                        Favorilerim <span class="so-count-chip">@(_preferences?.Favourites.Count ?? 0)</span>
                    </MudButton>
                </div>
                @if (HasFilters) { <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ClearFiltersAsync">Filtreleri temizle</MudButton> }
            </div>
        </section>

        @if (_actionProblem is not null) { <SoProblemPanel Problem="_actionProblem" /> }
        @if (_reloading) { <SoLoading Message="Bağlantılar ve kişisel tercihler yenileniyor…" /> }
        @if (_actionNotice is not null) { <p class="so-workspace-notice" role="status">@_actionNotice</p> }
        @if (_preferencesProblem is not null) { <SoProblemPanel Problem="_preferencesProblem" OnRetry="LoadPreferencesAsync" /> }
        @if (_categoriesProblem is not null) { <SoProblemPanel Problem="_categoriesProblem" OnRetry="LoadCategoriesAsync" /> }

        <section class="so-resource-results" aria-label="Bağlantılar" aria-busy="@_query.Loading">
            @if (!_favouritesOnly && _query.Problem is not null) { <SoProblemPanel Problem="_query.Problem" OnRetry="SearchAsync" RetryLabel="Yeniden yükle" /> }
            else if (CurrentPage is not { } result) { <SoLoading Message="Bağlantılar getiriliyor…" /> }
            else
            {
                <div class="so-resource-results-head">
                    <span role="status">@result.Total bağlantı @(_query.Loading ? "· Güncelleniyor…" : null)</span>
                    <label class="so-selection-choice"><input type="checkbox" checked="@_selection.All" disabled="@(_query.Loading || result.Items.Count == 0 || _busy)"
                        @onchange="e => SelectPage(e.Value is true)" />Bu sayfadakileri seç</label>
                </div>
                @if (_selection.Ids.Count > 0)
                {
                    <div class="so-selection-bar" data-guide="selection-actions" aria-label="Seçili bağlantı işlemleri">
                        <strong role="status">@_selection.Ids.Count bağlantı seçili</strong>
                        @if (_resolvedLinks is null)
                        { <MudButton StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="PrepareSelectedAsync" Disabled="_busy">@(_busy ? "Erişim denetleniyor…" : "Açmak için hazırla")</MudButton> }
                        else
                        { <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="ClearResolved" Disabled="_busy">Seçimi değiştir</MudButton> }
                        <MudButton StartIcon="@Icons.Material.Filled.PlaylistAdd" data-guide="save-personal-group" OnClick="AddSelectedAsync" Disabled="@(_busy || _preferences is null)">Seçilenleri grubuma kaydet</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Seçimi temizle" title="Seçimi temizle" OnClick="() => SelectPage(false)" Disabled="_busy" />
                    </div>
                }
                @if (_resolvedLinks is not null) { <ResolvedResourceLinks @key="_resolvedLinks" Links="_resolvedLinks" /> }
                @if (result.Items.Count == 0)
                {
                    <SoEmptyState Title="@(_favouritesOnly && !HasFilters ? "Henüz favoriniz yok" : HasFilters ? "Eşleşen bağlantı yok" : "Henüz yayımlanmış bağlantı yok")"
                                  Description="@(_favouritesOnly ? "Tek bir bağlantıyı hızlı bulmak için Favorilere ekle eylemini kullanın." : "Aramanızı değiştirebilir veya daha sonra tekrar kontrol edebilirsiniz.")"
                                  Icon="@Icons.Material.Outlined.LinkOff" />
                    <MudButton OnClick="DiscoverAsync" StartIcon="@Icons.Material.Filled.Search">Tüm bağlantılara dön</MudButton>
                }
                else if (_resolvedLinks is null)
                {
                    <ul class="so-resource-list">
                        @foreach (ResourceLink link in result.Items)
                        {
                            <ResourceLinkRow @key="link.Id" Link="link" CategoryName="@_categories.FirstOrDefault(c => c.Id == link.CategoryId)?.Name"
                                Favourite="@ResourceView.IsFavourite(_preferences, link.Id)" Disabled="@(_busy || _preferences is null)"
                                Selected="@_selection.Contains(link.Id)" SelectionDisabled="@(_query.Loading || _busy)"
                                SelectedChanged="value => SelectLink(link.Id, value)"
                                OnFavourite="@(() => ToggleFavouriteAsync(link))" OnAdd="@(() => AddToSetAsync(link))" />
                        }
                    </ul>
                }
                    <div class="so-pager so-resource-pagination" data-guide="pagination">
                        <label class="so-field"><span>Sayfa boyutu</span><select value="@_pageSize" disabled="@(_busy || _query.Loading)" @onchange="e => PageSizeChangedAsync(int.Parse(e.Value!.ToString()!))">
                            @foreach (int size in ResourceView.PageSizes) { <option value="@size">@size</option> }
                        </select></label>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Önceki" title="Önceki" Disabled="@(_query.Loading || result.Page <= 1)"
                                   OnClick="@(() => GoToPageAsync(result.Page - 1))" />
                        <span class="so-pager-state">Sayfa @result.Page / @Math.Max(1, (int)Math.Ceiling(result.Total / (double)_pageSize))</span>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Sonraki" title="Sonraki" Disabled="@(_query.Loading || result.Page * _pageSize >= result.Total)"
                                   OnClick="@(() => GoToPageAsync(result.Page + 1))" />
                    </div>
            }
        </section>
    }
</div>

@code {
    private AccessSnapshot? _access;
    private ResourcePreferencesResponse? _preferences;
    private IReadOnlyList<ResourceCategory> _categories = [];
    private readonly ResourceQueryState _query = new();
    private UiProblem? _actionProblem, _preferencesProblem, _categoriesProblem;
    private bool _busy, _favouritesOnly, _reloading;
    private readonly ResourceSelectionState _selection = new();
    private readonly ResourceResolutionState<IReadOnlyList<ResourceLink>> _opening = new();
    private IReadOnlyList<ResourceLink>? _resolvedLinks => _opening.Value;
    private string? _actionNotice;
    private ResourceWorkspaceLayout Layout => _preferences?.WorkspaceLayout ?? ResourceWorkspaceLayout.Default;
    private string _search = string.Empty, _environment = string.Empty;
    private Guid? _categoryId;
    private int _pageSize = 25, _pageNumber = 1;
    private bool HasFilters => !string.IsNullOrWhiteSpace(_search) || _categoryId is not null || !string.IsNullOrWhiteSpace(_environment);
    private ResourceQuery Query => new(Search: _search, CategoryId: _categoryId, Environment: _environment, Page: _pageNumber, PageSize: _pageSize);
    private ResourcePage? CurrentPage => _favouritesOnly ? ResourceView.FavouritePage(_preferences, Query) : _query.Page;

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _access = await AccessProvider.GetAsync();
        if (_access.Can(Capabilities.ResourcesView)) await ReloadAsync();
    }

    private async Task ReloadAccessAsync()
    {
        ClearResolved();
        _access = await AccessProvider.RefreshAsync(CancellationToken.None);
        if (_access.Can(Capabilities.ResourcesView)) await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_reloading) return;
        ClearResolved();
        _reloading = true;
        try
        {
            await LoadCategoriesAsync();
            StateHasChanged();
            await LoadPreferencesAsync();
            StateHasChanged();
            await SearchAsync();
        }
        finally { _reloading = false; }
    }

    private async Task LoadCategoriesAsync()
    {
        try { _categories = await ResourceApi.GetCategoriesAsync(false, CancellationToken.None); _categoriesProblem = null; }
        catch (SecureOpsApiException exception) { _categories = []; _categoriesProblem = exception.Problem; }
    }

    private async Task LoadPreferencesAsync()
    {
        try { _preferences = await ResourceApi.GetPreferencesAsync(CancellationToken.None); _pageSize = Layout.PageSize; _preferencesProblem = null; }
        catch (SecureOpsApiException exception) { _preferences = null; _preferencesProblem = exception.Problem; }
    }

    private void PreferencesChanged(ResourcePreferencesResponse preferences) => _preferences = preferences;
    private Task SearchChangedAsync(string value) { _search = value ?? string.Empty; _pageNumber = 1; return SearchAsync(); }
    private Task CategoryChangedAsync(Guid? value) { _categoryId = value; _environment = string.Empty; _pageNumber = 1; return SearchAsync(); }
    private Task EnvironmentChangedAsync(string value) { _environment = value ?? string.Empty; _pageNumber = 1; return SearchAsync(); }
    private async Task PageSizeChangedAsync(int value)
    {
        _pageSize = value;
        _pageNumber = 1;
        if (_preferences is not null) await SaveLayoutAsync(new(Layout with { PageSize = value }, _preferences.Version));
        await SearchAsync();
    }
    private Task GoToPageAsync(int value) { _pageNumber = Math.Max(1, value); return SearchAsync(); }
    private Task SetFavouritesAsync(bool value) { _favouritesOnly = value; _pageNumber = 1; return SearchAsync(); }
    private Task ClearFiltersAsync() { _search = _environment = string.Empty; _categoryId = null; _pageNumber = 1; return SearchAsync(); }
    private Task DiscoverAsync() { _favouritesOnly = false; return ClearFiltersAsync(); }

    private async Task SearchAsync()
    {
        _selection.Clear();
        ClearResolved();
        if (_favouritesOnly) { _selection.SetPage(CurrentPage?.Items.Select(link => link.Id) ?? []); return; }
        Task pending = _query.LoadAsync(Query, ResourceApi.QueryLinksAsync);
        StateHasChanged();
        await pending;
        if (!_query.Loading && _query.Problem is null) _selection.SetPage(CurrentPage?.Items.Select(link => link.Id) ?? []);
    }

    private void ClearResolved() { _opening.Clear(); _actionNotice = null; }
    private void SelectLink(Guid id, bool value) { _selection.Toggle(id, value); ClearResolved(); }
    private void SelectPage(bool value) { _selection.SelectPage(value); ClearResolved(); }

    private async Task PrepareSelectedAsync()
    {
        if (_busy || _selection.Ids.Count == 0) return;
        _busy = true;
        _actionProblem = null;
        long generation = _opening.Clear();
        Guid[] selected = [.. _selection.Ids];
        try
        {
            var links = await ResourceApi.ResolveLinksAsync(new(selected), CancellationToken.None);
            if (_opening.Accept(generation, links))
                _actionNotice = links.Count < selected.Length ? "Seçimin bir bölümü şu anda kullanılamıyor; yalnızca güncel uygun bağlantılar hazırlandı." : null;
        }
        catch (SecureOpsApiException exception) { if (_opening.IsCurrent(generation)) _actionProblem = exception.Problem; }
        finally { _busy = false; }
    }

    private Task AddSelectedAsync() => AddLinksAsync(CurrentPage?.Items.Where(link => _selection.Contains(link.Id)).ToArray() ?? []);

    private async Task OpenLayoutAsync()
    {
        if (_preferences is null || _access is null || _busy) return;
        DialogParameters parameters = new()
        {
            { nameof(ResourceLayoutDialog.Preferences), _preferences }, { nameof(ResourceLayoutDialog.Access), _access },
            { nameof(ResourceLayoutDialog.Save), (Func<SaveResourceLayoutRequest, Task<UiProblem?>>)SaveLayoutAsync }
        };
        IDialogReference dialog = await Dialogs.ShowAsync<ResourceLayoutDialog>("Çalışma alanını düzenle", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, DisableBackdropClick = true, CloseOnEscapeKey = false });
        if (!(await dialog.Result).Canceled) { _pageNumber = 1; await SearchAsync(); }
    }

    private async Task<UiProblem?> SaveLayoutAsync(SaveResourceLayoutRequest request)
    {
        if (_busy) return UiProblemFactory.FromResponse(409, null);
        _busy = true;
        _actionProblem = null;
        try
        {
            _preferences = await ResourceApi.SaveLayoutAsync(request, CancellationToken.None);
            _pageSize = Layout.PageSize;
            _actionNotice = "Çalışma alanı tercihleriniz kaydedildi.";
            return null;
        }
        catch (SecureOpsApiException exception) { _actionProblem = exception.Problem; return exception.Problem; }
        finally { _busy = false; }
    }

    private async Task ToggleFavouriteAsync(ResourceLink link)
    {
        if (_preferences is null || _busy) return;
        _busy = true;
        _actionProblem = null;
        try
        {
            _preferences = await ResourceApi.SetFavouriteAsync(link.Id, !ResourceView.IsFavourite(_preferences, link.Id), _preferences.Version, CancellationToken.None);
            if (_favouritesOnly && CurrentPage is { Items.Count: 0, Page: > 1 }) _pageNumber--;
            if (_favouritesOnly) await SearchAsync();
        }
        catch (SecureOpsApiException exception) { _actionProblem = exception.Problem; await LoadPreferencesAsync(); }
        finally { _busy = false; }
    }

    private Task AddToSetAsync(ResourceLink link) => AddLinksAsync([link]);

    private async Task AddLinksAsync(IReadOnlyList<ResourceLink> links)
    {
        if (_preferences is null || _busy || links.Count == 0) return;
        DialogParameters parameters = new()
        {
            { nameof(ResourceSetPickerDialog.Links), links },
            { nameof(ResourceSetPickerDialog.Preferences), _preferences },
            { nameof(ResourceSetPickerDialog.RefreshPreferences), (Func<Task<ResourcePreferencesResponse>>)RefreshGroupPreferencesAsync },
            { nameof(ResourceSetPickerDialog.Save), (Func<Guid?, SaveShiftSetRequest, Task<UiProblem?>>)SaveGroupAsync }
        };
        IDialogReference dialog = await Dialogs.ShowAsync<ResourceSetPickerDialog>("Seçilenleri grubuma kaydet", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, DisableBackdropClick = true, CloseOnEscapeKey = false });
        await dialog.Result;
    }

    private async Task<ResourcePreferencesResponse> RefreshGroupPreferencesAsync()
    {
        _preferences = await ResourceApi.GetPreferencesAsync(CancellationToken.None);
        _actionProblem = null;
        return _preferences;
    }

    private async Task<UiProblem?> SaveGroupAsync(Guid? id, SaveShiftSetRequest request)
    {
        if (_busy) return UiProblemFactory.FromResponse(409, null);
        _busy = true;
        _actionProblem = null;
        try
        {
            _preferences = id is { } groupId ? await ResourceApi.SaveSetAsync(groupId, request, CancellationToken.None)
                : await ResourceApi.CreateSetAsync(request, CancellationToken.None);
            _actionNotice = $"Seçtiğiniz bağlantılar kişisel grubunuza kaydedildi: {request.Name}.";
            return null;
        }
        catch (SecureOpsApiException exception) { _actionProblem = exception.Problem; await LoadPreferencesAsync(); return exception.Problem; }
        finally { _busy = false; }
    }

    private void OnAccessChanged() => InvokeAsync(async () =>
    {
        _selection.Clear();
        ClearResolved();
        StateHasChanged();
        _access = await AccessProvider.GetAsync();
        if (_access.Can(Capabilities.ResourcesView)) await ReloadAsync();
        else _preferences = null;
        StateHasChanged();
    });
    public void Dispose() { ClearResolved(); AccessProvider.Changed -= OnAccessChanged; _query.Dispose(); }
}
