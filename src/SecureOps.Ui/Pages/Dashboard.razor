@page "/"
@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject ICurrentAccessProvider AccessProvider
@inject ISignedInUserService Users
@inject IIdentityLookupApiClient IdentityClient
@inject IManagementReportingApiClient Reporting
@inject ILogger<Dashboard> Logger

<PageTitle>@WasasBrand.Title(_managementView ? "Yönetim Panosu" : "Genel Bakış")</PageTitle>

@*
    Two boards behind one route.

    An operator sees what they can do right now. A holder of Reporting.ManagementView additionally
    sees the backend-authoritative management report, which is the visual centre of the product for
    the people who have to answer for it.

    The split is on the capability the API reports, never on a role name and never on which screens
    happen to be reachable: being able to run an identity lookup or move a record to Jira says
    nothing about being entitled to cross-user analytics. Hiding the section is only a courtesy —
    the reporting endpoints re-check the capability and audit every privileged read.

    Every figure below comes from GET /api/v1/reporting/management/summary. Nothing is computed
    here. Bar widths and stack heights are proportions of those same counts, which is a way of
    drawing them, not a new measurement.
*@

<div class="so-page so-page--wide">
    <SoPageHeader Title="@(_managementView ? "Yönetim Panosu" : "Genel Bakış")"
                  Lead="@_greeting">
        <Actions>
            @if (_managementView)
            {
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@_reportLoading"
                           OnClick="ReloadReportAsync">
                    Yenile
                </MudButton>
            }
        </Actions>
    </SoPageHeader>

    @if (_snapshot is null)
    {
        <SoLoading Message="Erişim bilgileriniz yükleniyor…" />
    }
    else if (!_snapshot.IsResolved)
    {
        <SoProblemPanel Problem="_snapshot.Problem!" OnRetry="RefreshAsync" />
    }
    else if (_snapshot.IsPending)
    {
        <section class="so-panel so-panel--notice">
            <SoStatusBadge Label="Erişim onayı bekleniyor"
                           Tone="SoStatusBadge.BadgeTone.Caution"
                           Icon="@Icons.Material.Filled.HourglassTop" />
            <h2 class="so-panel-title">Erişim talebiniz onay bekliyor</h2>
            <p class="so-panel-text">
                Kimliğiniz doğrulandı ve erişim talebiniz kaydedildi. Bir yönetici talebinizi
                sonuçlandırdığında operasyon ekranları bu sayfada görünür hale gelecek.
            </p>
            <div class="so-panel-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">
                    Durumu yenile
                </MudButton>
                <MudButton Href="access/me" Variant="Variant.Text" Color="Color.Default">
                    Erişim ayrıntıları
                </MudButton>
            </div>
        </section>
    }
    else if (_snapshot.IsDisabled)
    {
        <section class="so-panel so-panel--notice so-panel--blocked">
            <SoStatusBadge Label="Erişim devre dışı"
                           Tone="SoStatusBadge.BadgeTone.Critical"
                           Icon="@Icons.Material.Filled.NoAccounts" />
            <h2 class="so-panel-title">Uygulama erişiminiz devre dışı</h2>
            <p class="so-panel-text">
                WASAS operasyon ekranlarını kullanamazsınız. Erişiminizin yeniden açılması için
                platform yöneticinize başvurun.
            </p>
        </section>
    }
    else if (_managementView)
    {
        <SoWindowPicker @bind-Preset="_preset"
                        Applied="_report?.Window"
                        Busy="_reportLoading"
                        OnWindowChanged="LoadReportAsync" />

        @if (_reportProblem is not null)
        {
            <SoProblemPanel Problem="_reportProblem" OnRetry="ReloadReportAsync" RetryLabel="Yeniden yükle" />
        }
        else if (_report is null || _coverage is null)
        {
            <SoLoading Message="Rapor hazırlanıyor…" Variant="SoLoading.LoadingVariant.Block" />
        }
        else if (!ManagementReportView.HasEvidence(_report))
        {
            <SoCoverageNotice Coverage="_coverage" />

            @* With coverage resolved, an empty window can finally be described honestly: a measured
               absence of activity, or an absence of records. Before G-17 both looked identical. *@
            <SoEmptyState Title="@(_coverage.ZeroIsMeasured ? "Bu aralıkta işlem yapılmamış" : "Bu aralıkta kayıtlı kanıt yok")"
                          Description="@(_coverage.ZeroIsMeasured
                              ? "Kalıcı kayıt bu aralığın tamamını kapsıyor ve hiçbir raporlanabilir işlem kaydedilmemiş. Bu ölçülmüş bir sıfırdır."
                              : "Seçilen aralık için kalıcı kayıt bulunmuyor. Sıfır olarak yorumlamayın.")"
                          Icon="@Icons.Material.Outlined.QueryStats" />

            <SoLimitationList Items="_report.Limitations" />
        }
        else
        {
            @* Above the figures, not below them: whether a zero on this page is a measurement is
               something the reader has to know before reading any of them. *@
            <SoCoverageNotice Coverage="_coverage" ShowWhenComplete="true" />

            @* -- executive summary ------------------------------------------------------- *@
            <section class="so-panel so-panel--primary">
                <p class="so-eyebrow">Özet</p>
                <div class="so-exec">
                    <SoMetric Label="Kimlik sorgusu"
                              Value="@ManagementReportView.Count(_report.IdentityLookup.TotalLookups)"
                              Hint="Sonuçlanmış sorgular"
                              Tone="SoMetric.MetricTone.Lead" />
                    <SoMetric Label="Etkin operatör"
                              Value="@ManagementReportView.Count(_report.PlatformAdoption.UniqueActiveUsersInWindow)"
                              Hint="Aralıkta işlem yapan"
                              Tone="SoMetric.MetricTone.Lead" />
                    <SoMetric Label="Jira kaydı oluşturuldu"
                              Value="@ManagementReportView.Count(_report.OperationalWorkflow.JiraCreated)"
                              Hint="Aralıkta bu duruma geçen kayıt"
                              Tone="SoMetric.MetricTone.Lead" />
                    <SoMetric Label="Tamamlanan iş akışı"
                              Value="@ManagementReportView.Count(_report.OperationalWorkflow.Completed)"
                              Hint="Aktarımı biten kayıt"
                              Tone="SoMetric.MetricTone.Positive" />
                    <SoMetric Label="Yetkisiz erişim denemesi"
                              Value="@ManagementReportView.Count(_report.SecurityAndQuality.AuthorizationFailures)"
                              Hint="Yetki kontrolünde reddedilen"
                              Tone="@(_report.SecurityAndQuality.AuthorizationFailures > 0
                                       ? SoMetric.MetricTone.Caution
                                       : SoMetric.MetricTone.Plain)" />
                </div>
            </section>

            @* -- attention areas --------------------------------------------------------- *@
            <section class="so-panel">
                <div class="so-panel-head">
                    <h2 class="so-panel-title">İlgi gerektiren alanlar</h2>
                </div>

                @if (_attention.Count == 0)
                {
                    <div class="so-status-row">
                        <SoStatusBadge Label="Açık bulgu yok"
                                       Tone="SoStatusBadge.BadgeTone.Positive"
                                       Icon="@Icons.Material.Filled.CheckCircle" />
                        <span class="so-status-text">
                            Bu aralıkta mutabakat, hata, çakışma veya yetki reddi kaydı bulunmuyor.
                        </span>
                    </div>
                }
                else
                {
                    <ul class="so-attention">
                        @foreach (ManagementReportView.AttentionItem item in _attention)
                        {
                            <li class="so-attention-item @AttentionClass(item.Tone)">
                                <span class="so-attention-count">@ManagementReportView.Count(item.Count)</span>
                                <div class="so-attention-body">
                                    <span class="so-attention-title">@item.Title</span>
                                    <p class="so-attention-text">@item.Detail</p>
                                </div>
                                @if (item.Tone == ManagementReportView.AttentionTone.Urgent
                                     && _snapshot.Can(Capabilities.OperationalRecordsView))
                                {
                                    <MudButton Href="operational-records" Variant="Variant.Text"
                                               Color="Color.Primary" Size="Size.Small"
                                               EndIcon="@Icons.Material.Filled.ChevronRight">
                                        Kayıtlar
                                    </MudButton>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <div class="so-report-grid">
                @* -- AD / PAM activity ---------------------------------------------------- *@
                <section class="so-panel so-panel--span">
                    <div class="so-panel-head">
                        <h2 class="so-panel-title">AD / PAM etkinliği</h2>
                        @if (_snapshot.Can(Capabilities.IdentityLookup))
                        {
                            <MudButton Href="identity-lookup" Variant="Variant.Text" Color="Color.Default"
                                       Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight">
                                Kimlik sorgulama
                            </MudButton>
                        }
                    </div>

                    <div class="so-metrics">
                        <SoMetric Label="Toplam sorgu"
                                  Value="@ManagementReportView.Count(_report.IdentityLookup.TotalLookups)"
                                  Tone="SoMetric.MetricTone.Lead" />
                        <SoMetric Label="Başarılı"
                                  Value="@ManagementReportView.Count(_report.IdentityLookup.SuccessfulLookups)"
                                  Tone="SoMetric.MetricTone.Positive" />
                        <SoMetric Label="Bulunamadı"
                                  Value="@ManagementReportView.Count(_report.IdentityLookup.NotFound)" />
                        <SoMetric Label="Geçersiz / reddedildi"
                                  Value="@ManagementReportView.Count(_report.IdentityLookup.RejectedOrInvalid)"
                                  Hint="Biçim kuralına uymayan giriş" />
                        <SoMetric Label="Sağlayıcı erişilemedi"
                                  Value="@ManagementReportView.Count(_report.IdentityLookup.ProviderUnavailable)"
                                  Hint="Hata ve zaman aşımı"
                                  Tone="@(_report.IdentityLookup.ProviderUnavailable > 0
                                           ? SoMetric.MetricTone.Caution
                                           : SoMetric.MetricTone.Plain)" />
                        <SoMetric Label="Yetkisiz sorgu"
                                  Value="@ManagementReportView.Count(_report.IdentityLookup.AuthorizationDenied)" />
                        <SoMetric Label="Benzersiz operatör"
                                  Value="@ManagementReportView.Count(_report.IdentityLookup.UniqueActiveOperators)"
                                  Hint="Sorgu çalıştıran kişi sayısı" />
                    </div>

                    <h3 class="so-subhead">Günlük dağılım</h3>
                    @if (ManagementReportView.HasTrend(_report))
                    {
                        <SoTrendChart Points="_report.IdentityLookup.Trend" />
                    }
                    else
                    {
                        <p class="so-panel-text so-panel-text--sm">
                            Bu aralıkta günlük dağılımı oluşturacak sonuçlanmış sorgu yok.
                        </p>
                    }
                </section>

                @* -- operational record to Jira ------------------------------------------- *@
                <section class="so-panel so-panel--span">
                    <div class="so-panel-head">
                        <h2 class="so-panel-title">Operasyonel kayıt → Jira</h2>
                        @if (_snapshot.Can(Capabilities.OperationalRecordsView))
                        {
                            <MudButton Href="operational-records" Variant="Variant.Text" Color="Color.Default"
                                       Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight">
                                Kayıtlar
                            </MudButton>
                        }
                    </div>

                    <div class="so-metrics">
                        <SoMetric Label="İçe alındı"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.RecordsImported)" />
                        <SoMetric Label="Uygun"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Eligible)" />
                        <SoMetric Label="Önizlendi"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Previewed)" />
                        <SoMetric Label="Jira oluşturuldu"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.JiraCreated)"
                                  Tone="SoMetric.MetricTone.Lead" />
                        <SoMetric Label="Tamamlandı"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Completed)"
                                  Tone="SoMetric.MetricTone.Positive" />
                    </div>

                    <h3 class="so-subhead">Durdurulan ve önlenen işlemler</h3>
                    <div class="so-metrics">
                        <SoMetric Label="Kaynak değişmiş"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.SourceChangedPrevented)"
                                  Hint="Aktarım korunarak durduruldu" />
                        <SoMetric Label="Kaynak kapalı / bulunamadı"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.ClosedOrMissingPrevented)"
                                  Hint="Aktarım korunarak durduruldu" />
                        <SoMetric Label="Mükerrer oluşturma önlendi"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.DuplicateCreatePrevented)"
                                  Hint="Bu sürümden itibaren ölçülüyor" />
                        <SoMetric Label="Başarısız adım"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Failures)"
                                  Tone="@(_report.OperationalWorkflow.Failures > 0
                                           ? SoMetric.MetricTone.Critical
                                           : SoMetric.MetricTone.Plain)" />
                        <SoMetric Label="Mutabakat gerekiyor"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.ReconciliationRequired)"
                                  Hint="Otomatik yeniden deneme kapalı"
                                  Tone="@(_report.OperationalWorkflow.ReconciliationRequired > 0
                                           ? SoMetric.MetricTone.Critical
                                           : SoMetric.MetricTone.Plain)" />
                    </div>

                    <h3 class="so-subhead">Yeniden deneme sonuçları</h3>
                    <div class="so-metrics">
                        <SoMetric Label="İstendi"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Retries.Requested)" />
                        <SoMetric Label="Başarılı"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Retries.Succeeded)"
                                  Tone="SoMetric.MetricTone.Positive" />
                        <SoMetric Label="Başarısız"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Retries.Failed)" />
                        <SoMetric Label="Aralık sonunda açık"
                                  Value="@ManagementReportView.Count(_report.OperationalWorkflow.Retries.UnresolvedAtWindowEnd)"
                                  Hint="Sonraki aralıkta sonuçlanmış olabilir" />
                    </div>

                    <h3 class="so-subhead">Ölçülebilen süreler</h3>
                    <p class="so-panel-text so-panel-text--sm">
                        Bu süreler iş akışının sistemde geçirdiği toplam süredir; bekleme ve yeniden
                        denemeleri içerir. Aktif çalışma süresi, kazanılan zaman veya kişisel
                        performans ölçüsü değildir.
                    </p>

                    <div class="so-table-scroll">
                        <table class="so-plain-table">
                            <thead>
                                <tr>
                                    <th scope="col">Aralık</th>
                                    <th scope="col">Örnek</th>
                                    <th scope="col">En kısa</th>
                                    <th scope="col">Ortalama</th>
                                    <th scope="col">En uzun</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (ManagementReportView.DurationView duration in ManagementReportView.Durations(_report))
                                {
                                    <tr>
                                        <th scope="row" title="@duration.Definition">@duration.Label</th>
                                        @if (duration.HasSamples)
                                        {
                                            <td>@ManagementReportView.Count(duration.SampleCount)</td>
                                            <td>@duration.Minimum</td>
                                            <td>@duration.Average</td>
                                            <td>@duration.Maximum</td>
                                        }
                                        else
                                        {
                                            <td colspan="4" class="so-cell-unavailable">
                                                @ManagementReportView.UnavailableText
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

                @* -- adoption -------------------------------------------------------------- *@
                <section class="so-panel">
                    <div class="so-panel-head">
                        <h2 class="so-panel-title">Platform kullanımı</h2>
                        @* The only entry point to the operator detail, and deliberately so. Reached
                           from here it inherits this page's window, coverage notice, and
                           limitations — the context that stops per-actor counts being read as a
                           ranking. It is not in the primary navigation. *@
                        <MudButton Href="reporting/operators" Variant="Variant.Text" Color="Color.Default"
                                   Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight">
                            Operatör Raporu
                        </MudButton>
                    </div>

                    <div class="so-metrics">
                        <SoMetric Label="Aralıktaki etkin kullanıcı"
                                  Value="@ManagementReportView.Count(_report.PlatformAdoption.UniqueActiveUsersInWindow)"
                                  Tone="SoMetric.MetricTone.Lead" />
                        <SoMetric Label="Günlük etkin"
                                  Value="@ManagementReportView.Count(_report.PlatformAdoption.DailyActiveUsers)"
                                  Hint="Son 1 gün" />
                        <SoMetric Label="Haftalık etkin"
                                  Value="@ManagementReportView.Count(_report.PlatformAdoption.WeeklyActiveUsers)"
                                  Hint="Son 7 gün" />
                        <SoMetric Label="Aylık etkin"
                                  Value="@ManagementReportView.Count(_report.PlatformAdoption.MonthlyActiveUsers)"
                                  Hint="Son 30 gün" />
                    </div>

                    <h3 class="so-subhead">İş akışına göre işlemler</h3>
                    <SoCountBars Items="_report.PlatformAdoption.OperationsByWorkflow"
                                 LabelFor="ManagementReportView.WorkflowLabel"
                                 EmptyText="Bu aralıkta iş akışı işlemi kaydedilmedi." />

                    <h3 class="so-subhead">Erişim etkinliği</h3>
                    <SoCountBars Items="_report.PlatformAdoption.AccessRequestActivity"
                                 LabelFor="ManagementReportView.AccessActionLabel"
                                 EmptyText="Bu aralıkta erişim işlemi kaydedilmedi." />

                    <p class="so-panel-text so-panel-text--sm">
                        Günlük/haftalık/aylık değerler rapor bitişinde biten hareketli pencerelerdir.
                        Kullanım için günlük ayrıntı serisi bu sürümde sunulmuyor.
                    </p>
                </section>

                @* -- session governance ----------------------------------------------------- *@
                <section class="so-panel">
                    <div class="so-panel-head">
                        <h2 class="so-panel-title">Oturum yönetişimi</h2>
                        @if (_snapshot.Can(Capabilities.AccessManageUsers))
                        {
                            <MudButton Href="admin/sessions" Variant="Variant.Text" Color="Color.Default"
                                       Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight">
                                Aktif oturumlar
                            </MudButton>
                        }
                    </div>

                    <div class="so-metrics">
                        <SoMetric Label="Başlatılan oturum"
                                  Value="@ManagementReportView.Count(_report.SessionGovernance.Started)"
                                  Tone="SoMetric.MetricTone.Lead" />
                        <SoMetric Label="Kullanıcı çıkışı"
                                  Value="@ManagementReportView.Count(_report.SessionGovernance.LoggedOut)" />
                        <SoMetric Label="Boşta zaman aşımı"
                                  Value="@ManagementReportView.Count(_report.SessionGovernance.IdleTimedOut)" />
                        <SoMetric Label="Mutlak süre doldu"
                                  Value="@ManagementReportView.Count(_report.SessionGovernance.AbsoluteTimedOut)" />
                        <SoMetric Label="Yönetici iptali"
                                  Value="@ManagementReportView.Count(_report.SessionGovernance.Revoked)"
                                  Tone="@(_report.SessionGovernance.Revoked > 0
                                           ? SoMetric.MetricTone.Caution
                                           : SoMetric.MetricTone.Plain)" />
                        <SoMetric Label="Erişim kapatıldığı için"
                                  Value="@ManagementReportView.Count(_report.SessionGovernance.AccessDisabledTerminations)" />
                        <SoMetric Label="Yetki değiştiği için"
                                  Value="@ManagementReportView.Count(_report.SessionGovernance.AccessChangedTerminations)"
                                  Hint="Yetki değişimi oturumu sonlandırır" />
                    </div>
                </section>

                @* -- security and quality --------------------------------------------------- *@
                <section class="so-panel">
                    <div class="so-panel-head">
                        <h2 class="so-panel-title">Güvenlik ve kalite</h2>
                    </div>

                    <div class="so-metrics">
                        <SoMetric Label="Yetki reddi"
                                  Value="@ManagementReportView.Count(_report.SecurityAndQuality.AuthorizationFailures)"
                                  Tone="@(_report.SecurityAndQuality.AuthorizationFailures > 0
                                           ? SoMetric.MetricTone.Caution
                                           : SoMetric.MetricTone.Plain)" />
                        <SoMetric Label="Eşzamanlılık çakışması"
                                  Value="@ManagementReportView.Count(_report.SecurityAndQuality.ConcurrencyConflicts)" />
                        <SoMetric Label="Mutabakat olayı"
                                  Value="@ManagementReportView.Count(_report.SecurityAndQuality.ReconciliationEvents)"
                                  Tone="@(_report.SecurityAndQuality.ReconciliationEvents > 0
                                           ? SoMetric.MetricTone.Critical
                                           : SoMetric.MetricTone.Plain)" />
                        <SoMetric Label="Sağlayıcı erişilemedi"
                                  Value="@ManagementReportView.Count(_report.SecurityAndQuality.ProviderUnavailableEvents)" />
                        <SoMetric Label="Hız sınırı reddi"
                                  Value="@ManagementReportView.Count(_report.SecurityAndQuality.RateLimitEvents)"
                                  Available="@(_report.SecurityAndQuality.RateLimitEvents is not null)"
                                  Hint="Hız sınırı reddi henüz denetim kaydına yazılmıyor" />
                    </div>
                </section>
            </div>

            <SoLimitationList Items="_report.Limitations" />

            @if (_available.Count > 0)
            {
                <section class="so-panel">
                    <p class="so-eyebrow">Hızlı erişim</p>
                    <ul class="so-quick">
                        @foreach (OperatorTask task in _available)
                        {
                            <li>
                                <a class="so-quick-link" href="@task.Route">
                                    <MudIcon Icon="@task.Icon" aria-hidden="true" />
                                    @task.Title
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    }
    else
    {
        <div class="so-dash">
            <div class="so-dash-main">
                <section class="so-panel so-panel--primary">
                    <p class="so-eyebrow">Şu an kullanılabilir</p>

                    @if (_available.Count == 0)
                    {
                        <SoEmptyState Title="Henüz yetkilendirilmiş bir işlem yok"
                                      Description="Hesabınız onaylı, ancak bir operasyon yetkisi tanımlanmamış. Yöneticinizden ihtiyacınız olan yetkileri talep edebilirsiniz."
                                      Icon="@Icons.Material.Outlined.LockPerson">
                            <Actions>
                                <MudButton Href="access/me" Variant="Variant.Outlined" Color="Color.Primary">
                                    Erişimimi görüntüle
                                </MudButton>
                            </Actions>
                        </SoEmptyState>
                    }
                    else
                    {
                        <ul class="so-task-list">
                            @foreach (OperatorTask task in _available)
                            {
                                <li class="so-task">
                                    <span class="so-task-icon" aria-hidden="true">
                                        <MudIcon Icon="@task.Icon" />
                                    </span>
                                    <div class="so-task-body">
                                        <a class="so-task-title" href="@task.Route">@task.Title</a>
                                        <p class="so-task-text">@task.Description</p>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                             Class="so-task-chevron" aria-hidden="true" />
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="so-panel">
                    <div class="so-panel-head">
                        <h2 class="so-panel-title">Sistem durumu</h2>
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">
                            Yenile
                        </MudButton>
                    </div>

                    @if (_providerHealth is not null)
                    {
                        <div class="so-status-row">
                            <SoStatusBadge Label="Erişilebilir"
                                           Tone="SoStatusBadge.BadgeTone.Positive"
                                           Icon="@Icons.Material.Filled.CheckCircle" />
                            <span class="so-status-text">
                                Dizin sağlayıcısı yanıt veriyor. Kimlik sorgulama kullanılabilir.
                            </span>
                        </div>

                        @if (!_providerHealth.RealDirectoryProviderEnabled)
                        {
                            <p class="so-panel-text so-panel-text--sm">
                                Bu ortamda kurumsal dizin bağlantısı henüz etkin değil; sonuçlar test
                                sağlayıcısından gelir.
                            </p>
                        }
                    }
                    else if (_providerProblem is not null)
                    {
                        <div class="so-status-row">
                            <SoStatusBadge Label="Durum bilinmiyor"
                                           Tone="SoStatusBadge.BadgeTone.Caution"
                                           Icon="@Icons.Material.Filled.HelpOutline" />
                            <span class="so-status-text">@_providerProblem.Title</span>
                        </div>
                        <p class="so-panel-text so-panel-text--sm">
                            Sorgu çalıştırabilirsiniz; sorun sürerse ilgili ekrandaki hata mesajı yol gösterir.
                        </p>
                    }
                    else
                    {
                        <SoLoading Message="Sistem durumu kontrol ediliyor…" Bare="true" />
                    }
                </section>
            </div>

            <aside class="so-dash-side">
                <section class="so-panel">
                    <p class="so-eyebrow">Erişiminiz</p>
                    <div class="so-panel-inline">
                        <SoStatusBadge Label="Onaylı"
                                       Tone="SoStatusBadge.BadgeTone.Positive"
                                       Icon="@Icons.Material.Filled.CheckCircle" />
                        @foreach (string role in _snapshot.Roles)
                        {
                            <SoStatusBadge Label="@AccessLabels.RoleLabel(role)"
                                           Tone="SoStatusBadge.BadgeTone.Info"
                                           Title="@AccessLabels.RoleDescription(role)" />
                        }
                    </div>
                    <p class="so-panel-text so-panel-text--sm">
                        @_snapshot.Capabilities.Count yetki tanımlı.
                    </p>
                    <MudButton Href="access/me" Variant="Variant.Text" Color="Color.Default" Size="Size.Small">
                        Ayrıntılar
                    </MudButton>
                </section>

                <section class="so-panel">
                    <p class="so-eyebrow">Sonraki fazlar</p>
                    <ul class="so-roadmap">
                        <li>
                            <span class="so-roadmap-name">Salt okunur tanılama</span>
                            <SoStatusBadge Label="Planlandı" Tone="SoStatusBadge.BadgeTone.Neutral" />
                        </li>
                        <li>
                            <span class="so-roadmap-name">Denetim ve uyum görünümü</span>
                            <SoStatusBadge Label="Planlandı" Tone="SoStatusBadge.BadgeTone.Neutral" />
                        </li>
                    </ul>
                    <p class="so-panel-text so-panel-text--sm">
                        Kimlik sorguları bugün de API üzerinden kayıt altına alınır.
                    </p>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    /// <summary>A capability-gated entry point offered on the dashboard.</summary>
    /// <param name="Title">Action name.</param>
    /// <param name="Description">What the action is for.</param>
    /// <param name="Route">Target route.</param>
    /// <param name="Icon">Leading icon.</param>
    private sealed record OperatorTask(string Title, string Description, string Route, string Icon);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private AccessSnapshot? _snapshot;
    private string _greeting = "WASAS operasyon platformu.";
    private IReadOnlyList<OperatorTask> _available = [];

    private IdentityProviderHealthResponse? _providerHealth;
    private UiProblem? _providerProblem;

    private bool _managementView;
    private ReportingWindowPreset _preset = ReportingWindowPreset.Last7Days;
    private ReportingWindowRequest _window = ReportingWindowSelection.ForPreset(ReportingWindowPreset.Last7Days);
    private ManagementReportResponse? _report;
    private IReadOnlyList<ManagementReportView.AttentionItem> _attention = [];
    private ManagementReportView.CoverageView? _coverage;
    private UiProblem? _reportProblem;
    private bool _reportLoading;

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;

        if (AuthenticationStateTask is not null)
        {
            AuthenticationState state = await AuthenticationStateTask;
            SignedInUser user = Users.Describe(state.User);
            _greeting = $"{user.DisplayName} olarak oturum açtınız.";
        }

        await LoadAsync(force: false);
    }

    private Task RefreshAsync() => LoadAsync(force: true);

    private async Task LoadAsync(bool force)
    {
        _snapshot = force
            ? await AccessProvider.RefreshAsync()
            : await AccessProvider.GetAsync();

        _available = BuildTasks(_snapshot);
        _managementView = _snapshot.IsApproved && _snapshot.Can(Capabilities.ManagementReportingView);

        if (!_snapshot.IsApproved)
        {
            return;
        }

        if (_managementView)
        {
            await LoadReportAsync(_window);
        }
        else
        {
            await LoadProviderHealthAsync();
        }
    }

    private Task ReloadReportAsync() => LoadReportAsync(_window);

    private async Task LoadReportAsync(ReportingWindowRequest window)
    {
        _window = window;
        _reportLoading = true;
        _reportProblem = null;
        StateHasChanged();

        try
        {
            _report = await Reporting.GetSummaryAsync(window, CancellationToken.None);
            _attention = ManagementReportView.Attention(_report);
            _coverage = ManagementReportView.Coverage(_report.Coverage);
        }
        catch (SecureOpsApiException ex)
        {
            // The previous report is dropped rather than left on screen under a new window label:
            // stale figures under a changed date range are worse than no figures at all.
            _report = null;
            _attention = [];
            _coverage = null;
            _reportProblem = ex.Problem;
            Logger.LogDebug("Management summary unavailable. Code: {Code}.", ex.Problem.Code);
        }
        finally
        {
            _reportLoading = false;
        }
    }

    // Answers "can I actually work right now" before the operator discovers a dead directory by
    // running a query. A failure here is reported as unknown status rather than as a page error: the
    // lookup screen may still work, and its own error handling is the authority on that.
    private async Task LoadProviderHealthAsync()
    {
        _providerHealth = null;
        _providerProblem = null;

        try
        {
            _providerHealth = await IdentityClient.GetProviderHealthAsync(CancellationToken.None);
        }
        catch (SecureOpsApiException ex)
        {
            _providerProblem = ex.Problem;
            Logger.LogDebug("Identity provider health unavailable. Code: {Code}.", ex.Problem.Code);
        }
    }

    // Built from granted capabilities rather than a fixed list, so the dashboard shows what this
    // operator can actually do instead of advertising screens that would refuse them.
    private static IReadOnlyList<OperatorTask> BuildTasks(AccessSnapshot snapshot)
    {
        List<OperatorTask> tasks = [];

        if (snapshot.Can(Capabilities.IdentityLookup))
        {
            tasks.Add(new OperatorTask(
                "PAM / AD kimlik sorgulama",
                "Tek bir hesabı inceleme amacıyla, kayıt altına alınan bir akışla sorgulayın.",
                "identity-lookup",
                Icons.Material.Filled.ManageSearch));
        }

        if (snapshot.Can(Capabilities.OperationalRecordsView))
        {
            tasks.Add(new OperatorTask(
                "Operasyonel kayıtlar",
                "Kaynak kayıtları inceleyin ve uygun olanları Jira'ya aktarın.",
                "operational-records",
                Icons.Material.Filled.Assignment));
        }

        return tasks;
    }

    private static string AttentionClass(ManagementReportView.AttentionTone tone) => tone switch
    {
        ManagementReportView.AttentionTone.Urgent => "so-attention-item--urgent",
        ManagementReportView.AttentionTone.Notable => "so-attention-item--notable",
        _ => "so-attention-item--guarded"
    };

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AccessProvider.Changed -= OnAccessChanged;
}
