@page "/operational-records"
@attribute [Authorize]
@implements IDisposable
@inject ICurrentAccessProvider AccessProvider
@inject IOperationalRecordApiClient Records
@inject IIdentityLookupApiClient Identity

<PageTitle>Operasyonel Kayıtlar · SecureOps</PageTitle>

@*
    The Operational Record → Jira workspace.

    Two things about this list are easy to get wrong:

    GET /operational-records is a *source refresh*, not a passive read — it imports and classifies
    from the source and is rate-limited. So there is no polling here, and Yenile is a deliberate
    action the operator takes, not something the page does on a timer.

    Grouping is by "does this need me", not by workflow order. An operator scanning the list is
    asking which records are stuck or unresolved, and a stage-ordered list buries those among the
    completed ones.
*@

<div class="so-page">
    <SoPageHeader Title="Operasyonel Kayıtlar"
                  Lead="Turuncu Hat üzerinden gelen uygun operasyon kayıtlarını inceleyebilir, Jira kaydı taslağını kontrol edebilir ve uygun kayıtları Jira'ya aktarabilirsiniz.">
        <Actions>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_loading"
                       OnClick="LoadAsync">
                Yenile
            </MudButton>
        </Actions>
    </SoPageHeader>

    @if (_access is null)
    {
        <SoLoading Message="Yetkileriniz doğrulanıyor…" />
    }
    else if (!_access.IsResolved)
    {
        <SoProblemPanel Problem="_access.Problem!" OnRetry="RefreshAccessAsync" />
    }
    else if (!_access.Can(Capabilities.OperationalRecordsView))
    {
        <section class="so-panel so-panel--blocked">
            <h2 class="so-panel-title">Bu alana erişim yetkiniz yok</h2>
            <p class="so-panel-text">
                Operasyonel kayıtları görüntülemek için
                <code class="so-code">@Capabilities.OperationalRecordsView</code> yetkisi gerekir.
                Hesabınızda tanımlı yetkileri
                <MudLink Href="access/me">Erişimim</MudLink> sayfasından görebilirsiniz.
            </p>
        </section>
    }
    else
    {
        @* Reported by the records themselves. If the configured providers are simulated, the
           operator must know that before opening anything, not after pressing a create button. *@
        <SoSimulationBanner Active="@_simulationMode" Notice="@_simulationNotice" />

        <section class="so-panel so-panel--tabs">
            <div class="so-tabs" role="tablist" aria-label="Kayıt grubu">
                @foreach (RecordGroup group in _groups)
                {
                    RecordGroup captured = group;
                    <button type="button"
                            role="tab"
                            class="so-tab @(group == _group ? "so-tab--active" : null)"
                            aria-selected="@(group == _group)"
                            @onclick="() => _group = captured">
                        @GroupLabel(group)
                        <span class="so-tab-count">@Count(group)</span>
                    </button>
                }
            </div>
        </section>

        @if (_problem is not null)
        {
            <SoProblemPanel Problem="_problem" OnRetry="LoadAsync" RetryLabel="Yeniden yükle" />
        }

        <section class="so-panel">
            @if (_loading)
            {
                <SoLoading Message="Kaynak kayıtlar yenileniyor…" Bare="true" />
            }
            else if (_records is null)
            {
                <SoEmptyState Title="Liste yüklenemedi"
                              Description="Yenile ile yeniden deneyebilirsiniz."
                              Icon="@Icons.Material.Outlined.CloudOff" />
            }
            else if (_records.Count == 0)
            {
                @* Distinguish "the source returned nothing" from "your filter matched nothing";
                   they look identical otherwise and send the operator looking in the wrong place. *@
                <SoEmptyState Title="Kaynak kayıt yok"
                              Description="Yapılandırılmış kaynak şu anda aktarılacak kayıt döndürmüyor."
                              Icon="@Icons.Material.Outlined.Inbox" />
            }
            else if (Filtered.Count == 0)
            {
                <SoEmptyState Title="@($"{GroupLabel(_group)} kayıt yok")"
                              Description="Diğer grupları görmek için yukarıdaki sekmeleri kullanın."
                              Icon="@Icons.Material.Outlined.FilterAltOff" />
            }
            else
            {
                <ul class="so-record-list">
                    @foreach (OperationalRecordResponse record in Filtered)
                    {
                        <li>
                            <a class="so-record-row" href="@($"operational-records/{record.Id}")">
                                <span class="so-record-main">
                                    <span class="so-record-head">
                                        <code class="so-record-code">@record.OrCode</code>
                                        @if (OperationalRecordView.NeedsAttention(record))
                                        {
                                            <span class="so-record-flag" title="Operatör ilgisi gerekiyor">
                                                <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Size="Size.Small" />
                                            </span>
                                        }
                                    </span>
                                    <span class="so-record-title">@record.Title</span>
                                    <span class="so-record-meta">
                                        <span>Kaynak: @record.SourceRecordId</span>
                                        @if (!string.IsNullOrWhiteSpace(record.Environment))
                                        {
                                            <span>· @record.Environment</span>
                                        }
                                        <span>· @record.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    </span>
                                </span>

                                <span class="so-record-states">
                                    @* The backend's stable category leads. The workflow stage stays
                                       underneath it as detail, because "Jira oluşturuldu" and
                                       "Tamamlandı" answer different questions. *@
                                    <SoStatusBadge Label="@OperationalRecordView.PresentationLabel(record.PresentationState)"
                                                   Tone="@OperationalRecordView.PresentationTone(record.PresentationState)"
                                                   Icon="@OperationalRecordView.PresentationIcon(record.PresentationState)" />

                                    <span class="so-chip so-chip--quiet" title="İş akışı aşaması">
                                        @OperationalRecordView.StateLabel(record.WorkflowState)
                                    </span>

                                    @if (OperationalRecordView.HasJira(record))
                                    {
                                        <span class="so-chip so-chip--quiet" title="Jira kaydı">
                                            @record.JiraIssueKey
                                        </span>
                                    }

@{
                                        OperationalRecordView.Ownership owner =
                                            OperationalRecordView.OwnershipOf(record, DateTimeOffset.UtcNow, _actor);
                                    }
                                    @* A lapsed claim is history, not ownership, so it earns no badge
                                       in a list an operator scans for what is blocked. *@
                                    @if (owner is OperationalRecordView.Ownership.Mine
                                            or OperationalRecordView.Ownership.Other)
                                    {
                                        <SoStatusBadge Label="@OwnerLabel(owner)"
                                                       Tone="@OwnerTone(owner)"
                                                       Icon="@Icons.Material.Filled.Lock" />
                                    }

                                    @if (record.ReconciliationRequired)
                                    {
                                        <SoStatusBadge Label="Doğrulama gerekiyor"
                                                       Tone="SoStatusBadge.BadgeTone.Caution"
                                                       Icon="@Icons.Material.Filled.HelpOutline" />
                                    }
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>

        <p class="so-panel-text so-panel-text--sm">
            Bu liste her yenilemede kaynak sistemden içe aktarım yapar ve hız sınırına tabidir;
            otomatik yenileme yapılmaz.
        </p>
    }
</div>

@code {
    /// <summary>Grouping that answers "does this need me", rather than workflow order.</summary>
    private enum RecordGroup
    {
        /// <summary>Stuck, failed, or unresolved.</summary>
        NeedsAttention,

        /// <summary>An action is currently possible.</summary>
        Actionable,

        /// <summary>In flight or not yet ready.</summary>
        InProgress,

        /// <summary>Transfer finished.</summary>
        Completed
    }

    private static readonly RecordGroup[] _groups =
    [
        RecordGroup.NeedsAttention,
        RecordGroup.Actionable,
        RecordGroup.InProgress,
        RecordGroup.Completed
    ];

    private AccessSnapshot? _access;
    private IReadOnlyList<OperationalRecordResponse>? _records;
    private UiProblem? _problem;
    private RecordGroup _group = RecordGroup.NeedsAttention;
    private bool _loading;
    private string? _actor;

    // Reported per record by the API. Any simulated record means the configured providers are
    // simulated, so the banner is shown for the page rather than per row.
    private bool _simulationMode;
    private string? _simulationNotice;

    private IReadOnlyList<OperationalRecordResponse> Filtered =>
        _records is null ? [] : _records.Where(r => GroupOf(r) == _group).ToArray();

    private int Count(RecordGroup group) =>
        _records is null ? 0 : _records.Count(r => GroupOf(r) == group);

    // The backend owns this categorisation now. Re-deriving it from workflow state and action
    // availability meant the list could disagree with the record screen about what a record needs,
    // and every new workflow state had to be classified in two places.
    //
    // An unrecognised category is grouped as needing attention because a record has to appear
    // somewhere and that is the conservative bucket. The label stays honest about not knowing.
    private static RecordGroup GroupOf(OperationalRecordResponse record) => record.PresentationState switch
    {
        OperationalRecordPresentationStates.Actionable => RecordGroup.Actionable,
        OperationalRecordPresentationStates.InProgress => RecordGroup.InProgress,
        OperationalRecordPresentationStates.Completed => RecordGroup.Completed,
        _ => RecordGroup.NeedsAttention
    };

    // Landing on an empty tab while five records wait one tab over is how an operator concludes
    // there is nothing to do. The priority order is the order of the tabs, so this only ever moves
    // forward to the first group that actually has work, and it runs on load rather than on every
    // render so it never overrides a tab the operator chose themselves.
    private void SelectGroupWithWork()
    {
        if (Count(_group) > 0)
        {
            return;
        }

        foreach (RecordGroup group in _groups)
        {
            if (Count(group) > 0)
            {
                _group = group;
                return;
            }
        }
    }

    private static string GroupLabel(RecordGroup group) =>
        OperationalRecordView.PresentationLabel(PresentationCode(group));

    private static string PresentationCode(RecordGroup group) => group switch
    {
        RecordGroup.Actionable => OperationalRecordPresentationStates.Actionable,
        RecordGroup.InProgress => OperationalRecordPresentationStates.InProgress,
        RecordGroup.Completed => OperationalRecordPresentationStates.Completed,
        _ => OperationalRecordPresentationStates.NeedsAttention
    };

private static string OwnerLabel(OperationalRecordView.Ownership owner) => owner switch
    {
        OperationalRecordView.Ownership.Mine => "Sizde",
        OperationalRecordView.Ownership.Other => "Başka operatörde",
        OperationalRecordView.Ownership.Lapsed => "Önceki kilit sona erdi",
        _ => "Serbest"
    };

    // "Mine" is informational; only somebody else's claim is a caution, because that is the one
    // that will stop an action.
    private static SoStatusBadge.BadgeTone OwnerTone(OperationalRecordView.Ownership owner) => owner switch
    {
        OperationalRecordView.Ownership.Other => SoStatusBadge.BadgeTone.Caution,
        OperationalRecordView.Ownership.Mine => SoStatusBadge.BadgeTone.Info,
        _ => SoStatusBadge.BadgeTone.Neutral
    };

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _access = await AccessProvider.GetAsync(CancellationToken.None);

        if (_access.Can(Capabilities.OperationalRecordsView))
        {
            await ResolveActorAsync();
            await LoadAsync();
        }
    }

    /// <summary>
    /// Reads the operator's identity <i>as the API names it</i>, for comparison against
    /// <c>claimedBy</c>.
    /// </summary>
    /// <remarks>
    /// The cookie principal is not usable here: the API records the actor as
    /// <c>demo:platform-admin</c> where the browser session says <c>platform-admin</c>, so
    /// comparing the cookie name would report every record as another operator's. A failure is
    /// swallowed — without an actor the UI simply cannot claim any record is the current
    /// operator's, which is the safe fallback rather than a reason to fail the page.
    /// </remarks>
    private async Task ResolveActorAsync()
    {
        try
        {
            _actor = (await Identity.GetCurrentIdentityAsync(CancellationToken.None)).Name;
        }
        catch (SecureOpsApiException)
        {
            _actor = null;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _problem = null;
        StateHasChanged();

        try
        {
            _records = await Records.ListAsync(CancellationToken.None);
            SelectGroupWithWork();

            _simulationMode = _records.Any(record => record.SimulationMode);
            _simulationNotice = _records
                .FirstOrDefault(record => !string.IsNullOrWhiteSpace(record.SimulationNotice))
                ?.SimulationNotice;
        }
        catch (SecureOpsApiException ex)
        {
            _problem = ex.Problem;
            _records = null;

            // Cleared on failure: a stale "no real write" promise next to an unknown list state
            // would be a claim the page can no longer support.
            _simulationMode = false;
            _simulationNotice = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAccessAsync()
    {
        _access = await AccessProvider.RefreshAsync(CancellationToken.None);
        StateHasChanged();
    }

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AccessProvider.Changed -= OnAccessChanged;
}
