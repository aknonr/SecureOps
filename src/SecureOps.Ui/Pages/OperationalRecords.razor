@page "/operational-records"
@attribute [Authorize]
@implements IDisposable
@inject ICurrentAccessProvider AccessProvider
@inject IOperationalRecordApiClient Records

<PageTitle>Operasyonel Kayıtlar · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide">
    <SoPageHeader Title="Operasyonel Kayıtlar">
        <Actions><MudButton StartIcon="@Icons.Material.Filled.Sync" Variant="Variant.Outlined" Disabled="@(_refreshing || _loading || _access?.Can(Capabilities.OperationalRecordsView) != true)"
            OnClick="RefreshSourceAsync">Kaynağı yenile</MudButton></Actions>
    </SoPageHeader>
    @if (_access is null) { <SoLoading Message="Yetkileriniz doğrulanıyor…" /> }
    else if (!_access.IsResolved) { <SoProblemPanel Problem="_access.Problem!" OnRetry="RefreshAccessAsync" /> }
    else if (!_access.Can(Capabilities.OperationalRecordsView))
    {
        <section class="so-panel--blocked"><h2 class="so-panel-title">Bu alana erişim yetkiniz yok</h2><p>Operasyonel kayıt görüntüleme yetkisi gerekir. <a href="access/me">Erişimim</a></p></section>
    }
    else
    {
        <div class="so-record-filters" data-guide="record-filters">
            <div class="so-field"><span>Kayıt ara</span><MudTextField T="string" Value="@_search" ValueChanged="SearchAsync" aria-label="Kayıt ara"
                Placeholder="OR kodu veya başlık" Immediate="true" DebounceInterval="350" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" /></div>
            <label class="so-field"><span>İş akışı</span><select aria-label="İş akışı" @bind="_state" @bind:after="FilterAsync">
                <option value="">Tüm durumlar</option>
                @foreach (OperationalRecordWorkflowState state in Enum.GetValues<OperationalRecordWorkflowState>())
                { <option value="@state">@OperationalRecordView.StateLabel(state)</option> }
            </select></label>
            <label class="so-field"><span>Sıralama</span><select aria-label="Sıralama" @bind="_sort" @bind:after="FilterAsync">
                <option value="updated">Son güncellenen</option><option value="oldest">En eski kaynak tarihi</option><option value="code">OR kodu</option>
            </select></label>
        </div>
        <p class="so-panel-text so-panel-text--sm">Kayıtlı veriler gösterilir. Kaynağı yenile, sınırlı bir içe aktarım yapar; aşağıdaki sayı Turuncu Hat toplamı değildir.</p>
        @if (_refreshNotice is not null) { <p role="status">@_refreshNotice</p> }
        @if (_refreshProblem is not null) { <SoProblemPanel Problem="_refreshProblem" /> }
        @if (_problem is not null) { <SoProblemPanel Problem="_problem" OnRetry="LoadAsync" RetryLabel="Kayıtlı listeyi yükle" /> }
        <section aria-label="Kayıtlı operasyonel kayıtlar" aria-busy="@_loading">
            @if (_loading) { <SoLoading Message="Kayıtlı liste yükleniyor…" /> }
            else if (_page is { } page)
            {
                <SoSimulationBanner Active="@(page.Items.Any(r => r.SimulationMode))" Notice="@(page.Items.FirstOrDefault(r => r.SimulationMode)?.SimulationNotice)" />
                <SoReadOnlyIntegrationBanner Active="@(page.Items.Any(r => r.ReadOnlyIntegrationMode))" Notice="@(page.Items.FirstOrDefault(r => r.ReadOnlyIntegrationMode)?.ReadOnlyNotice)" />
                <p role="status">@(page.Total) kayıtlı eşleşme</p>
                @if (page.Items.Count == 0)
                { <SoEmptyState Title="Kayıtlı eşleşme yok" Description="Filtreleri değiştirebilir veya yetkinizle kaynağı yenileyebilirsiniz." Icon="@Icons.Material.Outlined.Inbox" /> }
                else
                {
                    <div class="so-record-table">
                        <div class="so-record-columns" aria-hidden="true"><span>Kayıt</span><span>Ortam</span><span>Durum</span><span>Güncelleme (yerel)</span><span></span></div>
                        <ul class="so-record-browse-list">
                            @foreach (OperationalRecordResponse record in page.Items)
                            {
                                <li @key="record.Id">
                                    <div><code>@record.OrCode</code><h2>@record.Title</h2><p>Talep eden: @(record.Requester ?? "Bilinmiyor")</p></div>
                                    <span>@(record.Environment ?? "Bilinmiyor")</span>
                                    <div><SoStatusBadge Label="@OperationalRecordView.PresentationLabel(record.PresentationState)" Tone="@OperationalRecordView.PresentationTone(record.PresentationState)" />
                                        <p>@OperationalRecordView.StateLabel(record)</p>
                                        @if (record.Claimed) { <span class="so-chip">Operatör kilidi var</span> }
                                        @if (record.ReconciliationRequired) { <strong>Sonuç doğrulanmalı</strong> }
                                    </div>
                                    <time datetime="@record.UpdatedAt.ToString("O")">@record.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                                    <a class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-small" href="@($"operational-records/{record.Id}")" aria-label="@($"{record.OrCode}: İncele")">İncele</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="so-pager so-resource-pagination">
                    <label class="so-field"><span>Sayfa boyutu</span><select aria-label="Sayfa boyutu" @bind="_size" @bind:after="FilterAsync">
                        @foreach (int size in ResourceView.PageSizes) { <option value="@size">@size</option> }
                    </select></label>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Önceki" title="Önceki" Disabled="@(_number <= 1)" OnClick="() => PageAsync(_number - 1)" />
                    <span>Sayfa @_number / @Math.Max(1, (int)Math.Ceiling(page.Total / (double)_size))</span>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Sonraki" title="Sonraki" Disabled="@(_number * _size >= page.Total)" OnClick="() => PageAsync(_number + 1)" />
                </div>
            }
        </section>
    }
</div>

@code {
    private AccessSnapshot? _access;
    private OperationalRecordPageResponse? _page;
    private UiProblem? _problem, _refreshProblem;
    private string _search = string.Empty, _sort = "updated";
    private string? _refreshNotice;
    private OperationalRecordWorkflowState? _state;
    private int _number = 1, _size = 25, _generation;
    private bool _loading, _refreshing;
    private readonly CancellationTokenSource _lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        _access = await AccessProvider.GetAsync(_lifetime.Token);
        AccessProvider.Changed += OnAccessChanged;
        if (_access.Can(Capabilities.OperationalRecordsView)) await LoadAsync();
    }
    private Task SearchAsync(string value) { _search = value; return FilterAsync(); }
    private Task FilterAsync() { _number = 1; return LoadAsync(); }
    private Task PageAsync(int page) { _number = page; return LoadAsync(); }
    private async Task LoadAsync()
    {
        int generation = ++_generation;
        _loading = true;
        _problem = null;
        try
        {
            OperationalRecordPageResponse page = await Records.BrowseAsync(new() { Search = _search, State = _state, Sort = _sort, Page = _number, PageSize = _size }, _lifetime.Token);
            if (generation == _generation) _page = page;
        }
        catch (SecureOpsApiException ex) { if (generation == _generation) { _problem = ex.Problem; _page = null; } }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { if (generation == _generation) _loading = false; }
    }
    private async Task RefreshSourceAsync()
    {
        if (_refreshing || _loading) return;
        _refreshing = true;
        _refreshProblem = null;
        _refreshNotice = null;
        try
        {
            await Records.ListAsync(_lifetime.Token);
            _refreshNotice = "Sınırlı kaynak yenilemesi tamamlandı. Kayıtlı liste güncellendi; kaynak toplamı bilinmiyor.";
            await LoadAsync();
        }
        catch (SecureOpsApiException ex) { _refreshProblem = ex.Problem; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _refreshing = false; }
    }
    private async Task RefreshAccessAsync()
    {
        _access = await AccessProvider.RefreshAsync(_lifetime.Token);
        if (_access.Can(Capabilities.OperationalRecordsView)) await LoadAsync();
    }
    private void OnAccessChanged() => InvokeAsync(async () =>
    {
        ++_generation;
        _page = null;
        _access = await AccessProvider.GetAsync(_lifetime.Token);
        if (_access.Can(Capabilities.OperationalRecordsView)) await LoadAsync();
        StateHasChanged();
    });
    public void Dispose() { AccessProvider.Changed -= OnAccessChanged; ++_generation; _lifetime.Cancel(); _lifetime.Dispose(); }
}
