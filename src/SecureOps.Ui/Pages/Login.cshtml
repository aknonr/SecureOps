@page "/login"
@model LoginModel
@{
    Layout = "LoginLayout";
    ViewData["Title"] = "Oturum aç";
}

@*
    Single-action sign-in.

    Shaped like a redirect-based enterprise sign-in: one primary action that hands off, and a return
    path that brings the operator back where they were. When an identity provider replaces the interim
    endpoint, the form action, the label, and the note below it change — the card does not.

    No role or profile selection appears here. Permissions are resolved by the API after sign-in, so
    presenting a choice would imply the operator picks their own authority.
*@

<section class="so-auth-card" aria-labelledby="login-heading">
    <img class="so-auth-emblem" src="@Url.Content("~/brand/approved/thy-emblem-256.png")"
         width="104" height="104" alt="" />

    <h1 id="login-heading" class="so-auth-title">@WasasBrand.Name</h1>
    <p class="so-auth-lead">@WasasBrand.Tagline</p>

    <span class="so-auth-rule" aria-hidden="true"></span>

    @if (Model.ErrorMessage is not null)
    {
        <div class="so-auth-alert so-auth-alert--error" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.SignInEnabled)
    {
        <form method="post" action="@Url.Content("~/auth/sign-in")" class="so-auth-form" id="so-signin-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            @* Styled as the corporate sign-in action it will become, labelled as the thing it
               actually is today. The interim path establishes a local TEST session; naming it after
               corporate single sign-on would tell an operator their corporate credentials had been
               checked when nothing checked them. Enabling OIDC changes the label and note while
               preserving the same single-action layout. *@
            <button type="submit" class="so-auth-submit">
                <svg class="so-auth-submit-icon" viewBox="0 0 24 24" width="20" height="20"
                     role="presentation" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5Zm0 2a3 3 0 0 1 3 3v3H9V6a3 3 0 0 1 3-3Zm0 11a2 2 0 0 1 1 3.73V19a1 1 0 0 1-2 0v-1.27A2 2 0 0 1 12 14Z" />
                </svg>
                @if (Model.OidcEnabled)
                {
                    <span class="so-auth-submit-label">Kurumsal SSO ile Giriş</span>
                }
                else
                {
                    <span class="so-auth-submit-label">TEST Girişi</span>
                }
                <span class="so-auth-submit-spinner" aria-hidden="true"></span>
            </button>
        </form>

        @if (Model.OidcEnabled)
        {
            <p class="so-auth-note">Kurumsal kimlik sağlayıcısına güvenli şekilde yönlendirileceksiniz.</p>
        }
        else
        {
            <p class="so-auth-note">Bu ortamda kurumsal SSO henüz etkin değildir.</p>
        }

        <div class="so-auth-divider" aria-hidden="true"></div>

        <p class="so-auth-assurance">
            <svg viewBox="0 0 24 24" width="18" height="18" role="presentation" aria-hidden="true" focusable="false">
                <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
                      d="M12 3 4.5 6v5.5c0 4.4 3.1 8.1 7.5 9.5 4.4-1.4 7.5-5.1 7.5-9.5V6L12 3Z" />
                <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                      stroke-linejoin="round" d="m9 12 2 2 4-4" />
            </svg>
            <span>WASAS parola sormaz ve saklamaz. Yetkiler kurumsal erişim kayıtlarından belirlenir.</span>
        </p>
    }
    else
    {
        <div class="so-auth-alert so-auth-alert--warning" role="alert">
            Bu ortamda oturum açma yapılandırılmamış. Erişim için platform yöneticinize başvurun.
        </div>
    }

    @if (Model.ShowEnvironmentMarker)
    {
        <p class="so-auth-foot">@Model.EnvironmentName ortamı</p>
    }
</section>

@if (Model.SignInEnabled)
{
    <script>
        // Marks the form busy for the duration of the real sign-in round-trip. The button is not
        // disabled, so the antiforgery token still posts; CSS pointer-events prevents a double submit.
        (function () {
            var form = document.getElementById('so-signin-form');
            if (!form) { return; }
            form.addEventListener('submit', function () {
                form.classList.add('is-busy');
                form.setAttribute('aria-busy', 'true');
            });
        })();
    </script>
}
