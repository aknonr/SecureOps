@*
    Layout for the server-rendered auth pages (/login, /signed-out, /session-expired).

    Deliberately carries no app bar, drawer, or Blazor circuit: a user who is not signed in should
    never see navigation for pages they cannot open, and these pages must render even when no circuit
    can be established.

    Composition: one full-bleed field carrying a dot-matrix world map, with the sign-in card floating
    over its right side. The map is generated from longitude/latitude polygons rather than traced
    from anyone else's artwork, applied as a CSS mask so the palette colours it, and shares its
    coordinate system with the route overlay so the hub sits on Türkiye. No place names are drawn:
    the geography carries the meaning.

    Below the split breakpoint the field stays as an atmospheric backdrop and the card becomes the
    page, because on a phone an illustration above the fold pushes the actual sign-in action off it.
*@
@{
    Layout = null;
    string title = ViewData["Title"] as string ?? "Oturum";
    string emblem = Url.Content("~/brand/approved/thy-emblem-256.png");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@WasasBrand.Title(title)</title>
    <base href="~/" />
    <link rel="icon" href="~/brand/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/brand/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="~/brand/favicon.ico?v=2" sizes="16x16 32x32" />
    <meta name="color-scheme" content="dark" />
    <link href="~/css/secureops-theme.css" rel="stylesheet" />
</head>
<body class="so-auth-body">
    <div class="so-auth-shell">
        @* The map is a CSS mask over a themed colour rather than an inline SVG: one cached asset,
           88 KB, coloured by the palette instead of by baked-in fills, and no per-request markup.
           Generated from wwwroot/brand/world-dots.svg. *@
        <div class="so-auth-map" aria-hidden="true"></div>

        @* Routes share the map's coordinate system exactly -- viewBox 0 0 1000 660 over longitude
           -25..155 and latitude 72..-38 -- so the hub lands on Türkiye and every destination sits
           where it belongs. Decorative: hidden from assistive technology, and all of it stops under
           prefers-reduced-motion. No place names are rendered. *@
        <svg class="so-auth-field" viewBox="0 0 1000 660" preserveAspectRatio="xMidYMid meet"
             role="presentation" aria-hidden="true" focusable="false">
            <defs>
                <radialGradient id="so-hub-glow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="var(--so-art-accent)" stop-opacity="0.9" />
                    <stop offset="100%" stop-color="var(--so-art-accent)" stop-opacity="0" />
                </radialGradient>
            </defs>

            @* Destinations reached from the Türkiye hub. Thin and low-contrast so the single red
               route reads as the subject rather than as one line among many. *@
            <g class="so-auth-routes" fill="none" stroke="var(--so-art-route)" stroke-width="0.7" opacity="0.45">
                <path d="M322 193 Q 220 120 138 123" />
                <path d="M322 193 Q 235 150 152 139" />
                <path d="M322 193 Q 250 140 187 132" />
                <path d="M322 193 Q 340 130 348 97" />
                <path d="M322 193 Q 390 225 446 281" />
                <path d="M322 193 Q 450 200 568 260" />
                <path d="M322 193 Q 560 140 786 193" />
                <path d="M322 193 Q 540 290 716 424" />
                <path d="M322 193 Q 320 220 312 252" />
                <path d="M322 193 Q 230 290 158 393" />
                <path d="M322 193 Q 250 420 241 635" />
                <path d="M322 193 Q 620 130 915 218" />
            </g>

            @* The one highlighted route, drawn persistently so the page's signature element is never
               absent while somebody is looking at it. *@
            <path id="so-auth-route" class="so-auth-route-hot"
                  d="M322 193 Q 250 120 168 104"
                  fill="none" stroke="var(--so-art-accent)" stroke-width="1.4" />

            <circle class="so-auth-hub-glow" cx="322" cy="193" r="18" fill="url(#so-hub-glow)" />
            <circle cx="322" cy="193" r="2.4" fill="var(--so-art-accent)" />

            @* Same silhouette as SoAircraft.razor, inlined because this layout runs without a
               Blazor circuit and therefore renders no components. A test pins the two together. *@
            <g class="so-auth-plane">
                <path fill="var(--so-art-plane)" transform="scale(0.62)"
                      d="M18 0 C16 -1.2 13 -1.9 9 -2.1 L5 -2.1 L-5 -12.5 L-8.5 -12.5 L-2.5 -2.1 L-10 -2.1 L-14.5 -7.5 L-17 -7.5 L-13.5 -2 L-16 -1.6 L-16 1.6 L-13.5 2 L-17 7.5 L-14.5 7.5 L-10 2.1 L-2.5 2.1 L-8.5 12.5 L-5 12.5 L5 2.1 L9 2.1 C13 1.9 16 1.2 18 0 Z" />
            </g>
        </svg>

        @* Corporate lockup. The emblem is the approved asset; the wordmark beside it is set in the
           application's own type rather than reproduced from artwork. *@
        <div class="so-auth-lockup">
            <img class="so-auth-lockup-mark" src="@emblem" width="44" height="44" alt="" />
            <span class="so-auth-lockup-text">
                <span>TURKISH</span>
                <span>AIRLINES</span>
            </span>
        </div>

        <main class="so-auth-stage">
            @RenderBody()
        </main>

        <p class="so-auth-legal">© @DateTime.Now.Year Türk Hava Yolları A.O. — Kurumsal iç kullanım.</p>
    </div>
</body>
</html>
