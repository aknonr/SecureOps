@*
    Layout for the server-rendered auth pages (/login, /signed-out, /session-expired).

    Deliberately carries no app bar, drawer, or Blazor circuit: a user who is not signed in should
    never see navigation for pages they cannot open, and these pages must render even when no circuit
    can be established.

    Composition: one full-bleed photographic Earth field, with the sign-in card floating over its
    right side. Generated local geography remains beneath the artwork as a graceful fallback. A
    flight-network overlay locked to the photograph carries the Istanbul hub, routes to Europe, the
    Americas and Asia, and outbound and inbound aircraft. The artwork's day or night follows the
    Istanbul clock (data-so-sky); the card follows the reader's appearance. No place names are
    drawn: the geography carries the meaning.

    Below the split breakpoint the field stays as an atmospheric backdrop and the card becomes the
    page, because on a phone an illustration above the fold pushes the actual sign-in action off it.
*@
@{
    Layout = null;
    string title = ViewData["Title"] as string ?? "Oturum";
    string emblem = Url.Content("~/brand/approved/thy-emblem-256.png");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@WasasBrand.Title(title)</title>
    <base href="~/" />
    <link rel="icon" href="~/brand/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/brand/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="~/brand/favicon.ico?v=2" sizes="16x16 32x32" />
    <meta name="color-scheme" content="light dark" />
    <script>
        (function () {
            var mode = null;
            try { mode = localStorage.getItem("wasas.appearance"); } catch (e) { }
            if (mode === "night") {
                mode = "dark";
                try { localStorage.setItem("wasas.appearance", mode); } catch (e) { }
            }
            if (mode !== "light" && mode !== "dark") {
                mode = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
            }
            document.documentElement.dataset.soAppearance = mode;

            // The sign-in artwork follows the hub's clock, not the reader's theme: day over Istanbul
            // shows the daylight Earth, night shows city lights. Falls back to the appearance when the
            // time zone cannot be resolved. Presentation only; nothing is stored.
            var sky = mode === "light" ? "day" : "night";
            try {
                var hour = parseInt(new Intl.DateTimeFormat("en-GB", { hour: "2-digit", hourCycle: "h23", timeZone: "Europe/Istanbul" }).format(new Date()), 10);
                if (!isNaN(hour)) { sky = hour >= 7 && hour < 19 ? "day" : "night"; }
            } catch (e) { }
            document.documentElement.dataset.soSky = sky;
            document.documentElement.style.colorScheme = mode === "light" ? "light" : "dark";
        })();
    </script>
    <link href="~/css/secureops-theme.css" rel="stylesheet" />
</head>
<body class="so-auth-body">
    <div class="so-auth-shell">
        @* Local vector geography remains beneath the photographic artwork as a graceful fallback. *@
        <div class="so-auth-art" aria-hidden="true">
        <div class="so-auth-map"></div>
        <div class="so-auth-lights"></div>
        <div class="so-auth-photo"></div>

        @* Flight network locked to the photograph's own pixel space (1672x468). The overlay is sized
           and positioned exactly like the photo background (same height, same horizontal position
           variable), so Istanbul stays under the hub at every viewport. Routes leave Istanbul for
           Europe, the Americas and Asia; long-haul routes leave the frame instead of naming a city.
           Every aircraft rides its own route with SVG animateMotion + mpath, so the drawn line and
           the flown path cannot drift apart. Outbound and inbound aircraft share each route.
           No place label is rendered: the geography carries the meaning. *@
        <svg class="so-auth-flights" viewBox="0 0 1672 468" role="presentation" aria-hidden="true" focusable="false">
            <defs>
                <radialGradient id="so-hub-glow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="var(--so-art-accent)" stop-opacity="0.95" />
                    <stop offset="100%" stop-color="var(--so-art-accent)" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="so-aircraft-body" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--so-art-plane-bright)" />
                    <stop offset="58%" stop-color="var(--so-art-plane)" />
                    <stop offset="100%" stop-color="var(--so-art-plane-shade)" />
                </linearGradient>
                @* Same silhouette as SoAircraft.razor (nose toward +x), inlined because this layout
                   runs without a Blazor circuit. Navigation lights show only in the night sky. *@
                <symbol id="so-auth-aircraft" viewBox="-40 -30 80 60" overflow="visible">
                    <path class="so-aircraft-shadow" d="M36 0 C33 -3 29 -4 24 -4 L10 -4 L-6 -25 L-13 -25 L-4 -4 L-20 -4 L-29 -12 L-34 -12 L-29 -3 L-34 -2 L-34 2 L-29 3 L-34 12 L-29 12 L-20 4 L-4 4 L-13 25 L-6 25 L10 4 L24 4 C29 4 33 3 36 0 Z" />
                    <path class="so-aircraft-body" fill="url(#so-aircraft-body)" d="M36 0 C33 -3 29 -4 24 -4 L10 -4 L-6 -25 L-13 -25 L-4 -4 L-20 -4 L-29 -12 L-34 -12 L-29 -3 L-34 -2 L-34 2 L-29 3 L-34 12 L-29 12 L-20 4 L-4 4 L-13 25 L-6 25 L10 4 L24 4 C29 4 33 3 36 0 Z" />
                    <path class="so-aircraft-tail" d="M-30 -3 L-25 -14 L-19 -14 L-20 -3 Z" />
                    <path class="so-aircraft-cabin" d="M-18 0 H27" />
                    <g class="so-aircraft-navlights">
                        <circle cx="-9" cy="-24" r="2.4" fill="#ff3b3b" />
                        <circle cx="-9" cy="24" r="2.4" fill="#2bff88" />
                        <circle class="so-aircraft-strobe" cx="-33" cy="0" r="2.6" fill="#ffffff" />
                    </g>
                </symbol>
            </defs>

            <g class="so-auth-routes" fill="none">
                @* Batı Avrupa *@
                <path id="so-route-eu-west" class="so-auth-route" d="M684 207 Q 575 112 470 130" />
                @* Kuzey/Orta Avrupa *@
                <path id="so-route-eu-north" class="so-auth-route" d="M684 207 Q 650 120 598 66" />
                @* Güney Avrupa *@
                <path id="so-route-eu-south" class="so-auth-route" d="M684 207 Q 610 196 528 186" />
                @* Kuzey Amerika (Atlantik üzeri) *@
                <path id="so-route-am-north" class="so-auth-route" d="M684 207 Q 520 18 -160 62" />
                @* Güney Amerika *@
                <path id="so-route-am-south" class="so-auth-route" d="M684 207 Q 470 250 -160 400" />
                @* Uzak Doğu Asya *@
                <path id="so-route-as-east" class="so-auth-route" d="M684 207 Q 1000 30 1860 110" />
                @* Orta Doğu ve Güney Asya *@
                <path id="so-route-as-south" class="so-auth-route" d="M684 207 Q 870 250 1180 500" />
            </g>

            <g class="so-auth-destinations">
                <circle cx="470" cy="130" r="3.2" />
                <circle cx="598" cy="66" r="3.2" />
                <circle cx="528" cy="186" r="3.2" />
            </g>

            <circle class="so-auth-hub-glow" cx="684" cy="207" r="30" fill="url(#so-hub-glow)" />
            <circle class="so-auth-hub-ring" cx="684" cy="207" r="7" />
            <circle cx="684" cy="207" r="3" fill="var(--so-art-hub-core)" />

            <g class="so-auth-traffic">
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="9s" begin="0s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-eu-west" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="9s" begin="0s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="9s" begin="4.5s" repeatCount="indefinite" rotate="auto-reverse" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-eu-west" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="9s" begin="4.5s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="8s" begin="2.5s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-eu-north" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="8s" begin="2.5s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="8s" begin="6.5s" repeatCount="indefinite" rotate="auto-reverse" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-eu-north" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="8s" begin="6.5s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="7s" begin="4.5s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-eu-south" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="7s" begin="4.5s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="7s" begin="8s" repeatCount="indefinite" rotate="auto-reverse" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-eu-south" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="7s" begin="8s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="15s" begin="1s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-am-north" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="15s" begin="1s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="15s" begin="8.5s" repeatCount="indefinite" rotate="auto-reverse" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-am-north" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="15s" begin="8.5s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="16s" begin="6s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-am-south" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="16s" begin="6s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="16s" begin="14s" repeatCount="indefinite" rotate="auto-reverse" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-am-south" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="16s" begin="14s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="15s" begin="3s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-as-east" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="15s" begin="3s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="15s" begin="10.5s" repeatCount="indefinite" rotate="auto-reverse" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-as-east" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="15s" begin="10.5s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="12s" begin="8s" repeatCount="indefinite" rotate="auto" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-as-south" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="12s" begin="8s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
                <g class="so-auth-plane" opacity="0">
                    <animateMotion dur="12s" begin="14s" repeatCount="indefinite" rotate="auto-reverse" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#so-route-as-south" /></animateMotion>
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.9;1" dur="12s" begin="14s" repeatCount="indefinite" />
                    <use href="#so-auth-aircraft" x="-15" y="-11" width="30" height="22" />
                </g>
            </g>
        </svg>
        </div>

        @* Corporate lockup. The emblem is the approved asset; the wordmark beside it is set in the
           application's own type rather than reproduced from artwork. *@
        <div class="so-auth-lockup">
            <img class="so-auth-lockup-mark" src="@emblem" width="44" height="44" alt="" />
            <span class="so-auth-lockup-text">
                <span>TURKISH</span>
                <span>AIRLINES</span>
            </span>
        </div>

        @* SMIL ignores prefers-reduced-motion, so under that preference the timeline is frozen at a
           moment where aircraft are visibly on their routes; nothing on the page depends on motion. *@
        <script>
            (function () {
                var svg = document.querySelector(".so-auth-flights");
                if (!svg || !window.matchMedia || !window.matchMedia("(prefers-reduced-motion: reduce)").matches) { return; }
                try { svg.setCurrentTime(9); svg.pauseAnimations(); } catch (e) { svg.classList.add("is-static"); }
            })();
        </script>

        <main class="so-auth-stage">
            @RenderBody()
        </main>

        <p class="so-auth-legal">© @DateTime.Now.Year Türk Hava Yolları A.O. — Kurumsal iç kullanım.</p>
    </div>
</body>
</html>
