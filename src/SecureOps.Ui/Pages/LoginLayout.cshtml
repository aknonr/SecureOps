@*
    Layout for the server-rendered auth pages (/login, /signed-out, /session-expired).

    Deliberately carries no app bar, drawer, or Blazor circuit: a user who is not signed in should
    never see navigation for pages they cannot open, and these pages must render even when no circuit
    can be established.

    Composition: one full-bleed photographic Earth field, with the sign-in card floating over its
    right side. Generated local geography remains beneath the artwork as a graceful fallback. A
    single dynamic route overlay carries the hub and aircraft in every appearance. No place names
    are drawn: the geography carries the meaning.

    Below the split breakpoint the field stays as an atmospheric backdrop and the card becomes the
    page, because on a phone an illustration above the fold pushes the actual sign-in action off it.
*@
@{
    Layout = null;
    string title = ViewData["Title"] as string ?? "Oturum";
    string emblem = Url.Content("~/brand/approved/thy-emblem-256.png");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@WasasBrand.Title(title)</title>
    <base href="~/" />
    <link rel="icon" href="~/brand/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/brand/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="~/brand/favicon.ico?v=2" sizes="16x16 32x32" />
    <meta name="color-scheme" content="light dark" />
    <script>
        (function () {
            var mode = null;
            try { mode = localStorage.getItem("wasas.appearance"); } catch (e) { }
            if (mode !== "light" && mode !== "dark" && mode !== "night") {
                mode = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "night"
                    : "light";
            }
            document.documentElement.dataset.soAppearance = mode;
            document.documentElement.style.colorScheme = mode === "light" ? "light" : "dark";
        })();
    </script>
    <link href="~/css/secureops-theme.css" rel="stylesheet" />
</head>
<body class="so-auth-body">
    <div class="so-auth-shell">
        @* Local vector geography remains beneath the photographic artwork as a graceful fallback. *@
        <div class="so-auth-art" aria-hidden="true">
        <div class="so-auth-map"></div>
        <div class="so-auth-lights"></div>
        <div class="so-auth-photo"></div>

        @* The map and routes share longitude -25..100 and latitude 72..-38. The hub is Türkiye,
           expressed only by location art; no place label is rendered. *@
        <svg class="so-auth-field" viewBox="0 0 1000 660" preserveAspectRatio="xMidYMid slice"
             role="presentation" aria-hidden="true" focusable="false">
            <defs>
                <radialGradient id="so-hub-glow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="var(--so-art-accent)" stop-opacity="0.95" />
                    <stop offset="100%" stop-color="var(--so-art-accent)" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="so-aircraft-body" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--so-art-plane-bright)" />
                    <stop offset="58%" stop-color="var(--so-art-plane)" />
                    <stop offset="100%" stop-color="var(--so-art-plane-shade)" />
                </linearGradient>
            </defs>

            <g class="so-auth-network" transform="translate(0 160)">
            @* Destinations reached from the Türkiye hub. Thin and low-contrast so the single red
               route reads as the subject rather than as one line among many. *@
            <g class="so-auth-routes" fill="none" stroke="var(--so-art-route)" stroke-width="1.05">
                <path d="M463 198 Q 350 82 199 123" />
                <path d="M463 198 Q 350 130 219 139" />
                <path d="M463 198 Q 365 168 300 181" />
                <path d="M463 198 Q 452 92 501 98" />
                <path d="M463 198 Q 500 170 558 182" />
                <path d="M463 198 Q 545 220 642 281" />
                <path d="M463 198 Q 650 165 818 260" />
                <path d="M463 198 Q 500 290 494 440" />
                <path d="M463 198 Q 348 296 227 393" />
                <path d="M463 198 Q 360 395 347 635" />
                <path d="M463 198 Q 455 228 450 252" />
            </g>

            <g class="so-auth-destinations" fill="var(--so-art-route-node)">
                <circle cx="199" cy="123" r="2.2" /><circle cx="219" cy="139" r="2.2" />
                <circle cx="300" cy="181" r="2.2" /><circle cx="501" cy="98" r="2.2" />
                <circle cx="558" cy="182" r="2.2" /><circle cx="642" cy="281" r="2.2" />
                <circle cx="818" cy="260" r="2.2" /><circle cx="494" cy="440" r="2.2" />
                <circle cx="227" cy="393" r="2.2" /><circle cx="347" cy="635" r="2.2" />
                <circle cx="450" cy="252" r="2.2" />
            </g>

            @* The one highlighted route, drawn persistently so the page's signature element is never
               absent while somebody is looking at it. *@
            <path id="so-auth-route" class="so-auth-route-hot"
                  d="M463 198 Q 350 82 199 123"
                  fill="none" stroke="var(--so-art-accent)" stroke-width="2.1" />

            <circle class="so-auth-hub-glow" cx="463" cy="198" r="25" fill="url(#so-hub-glow)" />
            <circle class="so-auth-hub-ring" cx="463" cy="198" r="5.5" />
            <circle cx="463" cy="198" r="2.2" fill="var(--so-art-hub-core)" />

            @* Same silhouette as SoAircraft.razor, inlined because this layout runs without a
               Blazor circuit and therefore renders no components. A test pins the two together. *@
            <g class="so-auth-plane">
                <path class="so-aircraft-shadow"
                      d="M36 0 C33 -3 29 -4 24 -4 L10 -4 L-6 -25 L-13 -25 L-4 -4 L-20 -4 L-29 -12 L-34 -12 L-29 -3 L-34 -2 L-34 2 L-29 3 L-34 12 L-29 12 L-20 4 L-4 4 L-13 25 L-6 25 L10 4 L24 4 C29 4 33 3 36 0 Z" />
                <path class="so-aircraft-body" fill="url(#so-aircraft-body)"
                      d="M36 0 C33 -3 29 -4 24 -4 L10 -4 L-6 -25 L-13 -25 L-4 -4 L-20 -4 L-29 -12 L-34 -12 L-29 -3 L-34 -2 L-34 2 L-29 3 L-34 12 L-29 12 L-20 4 L-4 4 L-13 25 L-6 25 L10 4 L24 4 C29 4 33 3 36 0 Z" />
                <path class="so-aircraft-tail" d="M-30 -3 L-25 -14 L-19 -14 L-20 -3 Z" />
                <path class="so-aircraft-cabin" d="M-18 0 H27" />
            </g>
            </g>
        </svg>
        </div>

        @* Corporate lockup. The emblem is the approved asset; the wordmark beside it is set in the
           application's own type rather than reproduced from artwork. *@
        <div class="so-auth-lockup">
            <img class="so-auth-lockup-mark" src="@emblem" width="44" height="44" alt="" />
            <span class="so-auth-lockup-text">
                <span>TURKISH</span>
                <span>AIRLINES</span>
            </span>
        </div>

        <main class="so-auth-stage">
            @RenderBody()
        </main>

        <p class="so-auth-legal">© @DateTime.Now.Year Türk Hava Yolları A.O. — Kurumsal iç kullanım.</p>
    </div>
</body>
</html>
