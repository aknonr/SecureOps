@*
    Layout for the server-rendered auth pages (/login, /signed-out, /session-expired).

    Deliberately carries no app bar, drawer, or Blazor circuit: a user who is not signed in should
    never see navigation for pages they cannot open, and these pages must render even when no circuit
    can be established.

    Composition: one full-bleed dark field carrying an abstract route network, with the sign-in card
    floating over its right side. The network is drawn in SVG rather than shipped as an image — it
    inherits the palette, scales to any viewport without a second request, costs a few kilobytes
    instead of a megabyte, and reproduces no map artwork or airline livery. The scattered points read
    as a night-side world without tracing one.

    Below the split breakpoint the field stays as an atmospheric backdrop and the card becomes the
    page, because on a phone an illustration above the fold pushes the actual sign-in action off it.
*@
@{
    Layout = null;
    string title = ViewData["Title"] as string ?? "Oturum";
    string emblem = Url.Content("~/brand/approved/thy-emblem-256.png");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@WasasBrand.Title(title)</title>
    <base href="~/" />
    <link rel="icon" href="~/brand/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/brand/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="~/brand/favicon.ico?v=2" sizes="16x16 32x32" />
    <meta name="color-scheme" content="dark" />
    <link href="~/css/secureops-theme.css" rel="stylesheet" />
</head>
<body class="so-auth-body">
    <div class="so-auth-shell">
        @* Decorative throughout: hidden from assistive technology, and every element of it stops
           moving under prefers-reduced-motion. Nothing here carries information. *@
        <svg class="so-auth-field" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice"
             role="presentation" aria-hidden="true" focusable="false">
            <defs>
                <radialGradient id="so-field-glow" cx="27%" cy="60%" r="46%">
                    <stop offset="0%" stop-color="var(--so-art-glow)" stop-opacity="0.42" />
                    <stop offset="100%" stop-color="var(--so-art-glow)" stop-opacity="0" />
                </radialGradient>
                <radialGradient id="so-hub-glow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="var(--so-art-accent)" stop-opacity="0.85" />
                    <stop offset="100%" stop-color="var(--so-art-accent)" stop-opacity="0" />
                </radialGradient>
            </defs>

            <rect width="1600" height="900" fill="var(--so-art-field)" />
            <rect width="1600" height="900" fill="url(#so-field-glow)" />

            @* Night-side scatter. Denser toward the hub so the field reads as populated land rather
               than as evenly distributed noise. *@
            <g class="so-auth-scatter" fill="var(--so-art-route)">
                @{
                    // Deterministic: the same field renders on every request, so the page never
                    // "flickers" into a different arrangement between reloads.
                    var rng = new Random(20260829);
                    for (int i = 0; i < 260; i++)
                    {
                        double angle = rng.NextDouble() * Math.PI * 2;
                        double spread = Math.Pow(rng.NextDouble(), 0.62) * 560;
                        double cx = 430 + (Math.Cos(angle) * spread * 1.45);
                        double cy = 540 + (Math.Sin(angle) * spread * 0.60);

                        if (cx < 10 || cx > 1590 || cy < 90 || cy > 880)
                        {
                            continue;
                        }

                        double r = 0.7 + (rng.NextDouble() * 1.5);
                        double o = 0.16 + (rng.NextDouble() * 0.42);
                        <circle cx="@cx.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                cy="@cy.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                r="@r.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                opacity="@o.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    }
                }
            </g>

            @* Routes radiating from one hub. Thin and low-contrast so the single red one reads as
               the subject rather than as one line among many. *@
            <g class="so-auth-routes" fill="none" stroke="var(--so-art-line)" stroke-width="1.1">
                <path d="M430 540 C 300 300 180 240 60 210" opacity="0.30" />
                <path d="M430 540 C 360 260 300 150 250 90" opacity="0.26" />
                <path d="M430 540 C 520 250 640 160 760 120" opacity="0.34" />
                <path d="M430 540 C 620 330 860 250 1090 230" opacity="0.30" />
                <path d="M430 540 C 700 420 980 380 1290 350" opacity="0.26" />
                <path d="M430 540 C 700 520 1000 520 1340 520" opacity="0.22" />
                <path d="M430 540 C 660 640 920 700 1220 730" opacity="0.24" />
                <path d="M430 540 C 560 700 700 790 880 840" opacity="0.22" />
                <path d="M430 540 C 380 700 330 800 280 870" opacity="0.20" />
                <path d="M430 540 C 250 620 140 680 40 730" opacity="0.22" />
            </g>

            @* The one highlighted route, and the aircraft that flies it. *@
            <path id="so-auth-route" class="so-auth-route-hot"
                  d="M430 540 C 560 380 700 300 880 268"
                  fill="none" stroke="var(--so-art-accent)" stroke-width="2" />

            <circle class="so-auth-hub-glow" cx="430" cy="540" r="46" fill="url(#so-hub-glow)" />
            <circle cx="430" cy="540" r="5" fill="var(--so-art-accent)" />

            <g class="so-auth-plane">
                <path d="M -11 0 L 7 0 L 13 -5 L 7 3.5 L 13 11 L 7 6 L -11 6 L -13.5 3 Z"
                      fill="var(--so-art-plane)" />
            </g>
        </svg>

        @* Corporate lockup. The emblem is the approved asset; the wordmark beside it is set in the
           application's own type rather than reproduced from artwork. *@
        <div class="so-auth-lockup">
            <img class="so-auth-lockup-mark" src="@emblem" width="44" height="44" alt="" />
            <span class="so-auth-lockup-text">
                <span>TURKISH</span>
                <span>AIRLINES</span>
            </span>
        </div>

        <main class="so-auth-stage">
            @RenderBody()
        </main>

        <p class="so-auth-legal">© @DateTime.Now.Year Türk Hava Yolları A.O. — Kurumsal iç kullanım.</p>
    </div>
</body>
</html>
