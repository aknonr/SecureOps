@page "/access/me"
@attribute [Authorize]
@implements IDisposable
@inject ICurrentAccessProvider AccessProvider
@inject IAccessApiClient AccessApi
@inject ILogger<MyAccess> Logger

<PageTitle>Erişimim · @WasasBrand.Name</PageTitle>

@*
    What this account may do, in the operator's language.

    Capabilities are grouped by functional area rather than listed as raw identifiers, because the
    question an operator actually has is "can I do X", not "do I hold OperationalRecords.CreateJira".
    The identifier is still shown as a tooltip so it can be quoted in an access request.
*@

<div class="so-page so-page--wide so-my-access">
    <SoPageHeader Title="Erişimim"
                  Lead="WASAS üzerindeki durumunuz, rolleriniz ve yetkileriniz.">
        <Actions>
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">
                Yenile
            </MudButton>
        </Actions>
    </SoPageHeader>

    @if (_access is null)
    {
        <SoLoading Message="Erişim bilgileriniz yükleniyor…" />
    }
    else if (!_access.IsResolved)
    {
        <SoProblemPanel Problem="_access.Problem!" OnRetry="RefreshAsync" />
    }
    else
    {
        <section class="so-panel">
            <div class="so-access-status so-access-status--@StatusModifier">
                <span class="so-access-status-icon" aria-hidden="true">
                    <MudIcon Icon="@StatusIcon" />
                </span>
                <div>
                    <h2 class="so-panel-title">@StatusTitle</h2>
                    <p class="so-panel-text">@StatusDescription</p>
                </div>
            </div>

            <dl class="my-access-summary">
                <div><dt>Durum</dt><dd>@AccessLabels.StatusLabel(_access.Status ?? "")</dd></div>
                <div><dt>Rol</dt><dd>@_access.Roles.Count</dd></div>
                <div><dt>Yetki</dt><dd>@_access.Capabilities.Count</dd></div>
                <div><dt>Alan</dt><dd>@CapabilityGroups.Count</dd></div>
                @if (_access.LatestRequest is { } latest)
                {
                    <div><dt>Son talep</dt><dd>@AccessRequestPresentation.Time(latest.RequestedAt)</dd></div>
                    @if (latest.DecidedAt is { } decidedAt)
                    {
                        <div><dt>Karar</dt><dd>@AccessLabels.RequestStatusLabel(latest.Status) · @AccessRequestPresentation.Time(decidedAt)</dd></div>
                    }
                }
            </dl>

            @if (_access.IsAwaitingDecision && _access.Access!.PendingRequestId is { } requestId)
            {
                <SoFieldGrid MinColumnWidth="260px">
                    <SoField Label="Talep numarası">
                        <code class="so-code">@requestId</code>
                    </SoField>
                </SoFieldGrid>
                <p class="so-panel-text so-panel-text--sm">
                    Yöneticinize başvururken bu numarayı paylaşabilirsiniz.
                </p>
            }
        </section>

        <section class="so-panel">
            <h2 class="so-panel-title">Rolleriniz</h2>

            @if (_access.Roles.Count == 0)
            {
                <SoEmptyState Title="Tanımlı rol yok"
                              Description="Hesabınıza henüz bir uygulama rolü atanmamış."
                              Icon="@Icons.Material.Outlined.Badge" />
            }
            else
            {
                <ul class="so-role-list">
                    @foreach (string role in _access.Roles)
                    {
                        <li class="so-role">
                            <SoStatusBadge Label="@AccessLabels.HeldRoleLabel(role)"
                                           Tone="SoStatusBadge.BadgeTone.Info"
                                           Title="@role" />
                            @if (AccessLabels.RoleDescription(role) is { } description)
                            {
                                <span class="so-role-text">@description</span>
                            }
                            else
                            {
                                @* /access/me returns role codes only; the definition's name is readable
                                   only by role administrators. The code is shown rather than a guess. *@
                                <span class="so-role-text">
                                    Yönetici tarafından tanımlanmış rol. Adı bu ekranda okunamıyor; rol kodu:
                                    <code class="so-code">@role</code>. Kapsadığı işlemler aşağıdaki yetkilerde yer alır.
                                </span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        @if (_effective is not null)
        {
            <section class="so-panel">
                <AccessEffectivePanel Effective="_effective" Title="Yetkileriniz" StartWithGrantedOnly="true" />
                <p class="so-panel-text so-panel-text--sm mt-3">Yetkiler sunucu tarafında her istekte yeniden doğrulanır; bu görünüm sunucunun hesabınız için verdiği açıklamadır.</p>
            </section>
        }
        else
        {
        <section class="so-panel">
            <div class="so-panel-head">
                <h2 class="so-panel-title">Yetkileriniz</h2>
                <span class="so-count">@_access.Capabilities.Count</span>
            </div>

            @if (_access.Capabilities.Count == 0)
            {
                <SoEmptyState Title="Tanımlı yetki yok"
                              Description="Rolleriniz onaylandığında yetkileriniz burada listelenir."
                              Icon="@Icons.Material.Outlined.LockPerson" />
            }
            else
            {
                <p class="so-panel-text so-panel-text--sm">Yetkiler işe göre gruplanmıştır. Her satır, sunucunun hesabınız için bildirdiği bir işlemdir.</p>
                <div class="my-access-groups">
                @foreach (IGrouping<string, CapabilityDescriptor> group in CapabilityGroups)
                {
                    <div class="so-cap-group my-access-group">
                        <h3 class="my-access-group-name">@group.Key <span class="so-count">@group.Count()</span></h3>
                        @if (group.Key == AccessLabels.Groups.ServiceAccounts)
                        {
                            <p class="so-cap-text">Servis hesabı verisi ayrıca ekip veya organizasyon kapsamıyla sınırlanır. Kapsamınız bu ekranda gösterilemiyor; ekranda kayıt görmüyorsanız modül yöneticinize başvurun.</p>
                        }
                        <ul class="so-cap-list">
                            @foreach (CapabilityDescriptor capability in group)
                            {
                                <li class="so-cap">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                             Size="Size.Small" Class="so-cap-icon" aria-hidden="true" />
                                    <div>
                                        <span class="so-cap-name" title="@capability.Capability">@capability.Label</span>
                                        <p class="so-cap-text">@capability.Description</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }
                </div>
            }

            <p class="so-panel-text so-panel-text--sm mt-3">
                Yetkiler sunucu tarafında her istekte yeniden doğrulanır. Buradaki liste, sunucunun
                hesabınız için bildirdiği güncel yetkileri gösterir.
            </p>
        </section>
        }
    }
</div>

@code {
    private AccessSnapshot? _access;
    private AccessEffectiveResponse? _effective;

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _access = await AccessProvider.GetAsync();
        await LoadEffectiveAsync();
    }

    private async Task RefreshAsync()
    {
        _access = await AccessProvider.RefreshAsync();
        await LoadEffectiveAsync();
    }

    // The per-module explanation is an enhancement: if it cannot be read, the capability list above it
    // (from /access/me) still states the authoritative grants, so the page degrades instead of failing.
    private async Task LoadEffectiveAsync()
    {
        if (_access is not { IsResolved: true }) { _effective = null; return; }
        try { _effective = await AccessApi.GetMyEffectiveAsync(CancellationToken.None); }
        catch (SecureOpsApiException ex)
        {
            Logger.LogWarning("Per-module access explanation unavailable. Code: {Code}. CorrelationId: {CorrelationId}.",
                ex.Problem.Code, ex.Problem.CorrelationId);
            _effective = null;
        }
    }

    private IReadOnlyList<IGrouping<string, CapabilityDescriptor>> CapabilityGroups =>
        _access is null ? [] : AccessLabels.Group(_access.Capabilities);

    private string StatusModifier => _access switch
    {
        { IsApproved: true } => "ok",
        // Ordered before IsPending on purpose: a refused user is still Pending.
        { IsRejected: true } => "blocked",
        { IsPending: true } => "pending",
        { IsDisabled: true } => "blocked",
        _ => "unknown"
    };

    private string StatusIcon => _access switch
    {
        { IsApproved: true } => Icons.Material.Filled.VerifiedUser,
        { IsRejected: true } => Icons.Material.Filled.Cancel,
        { IsPending: true } => Icons.Material.Filled.HourglassTop,
        { IsDisabled: true } => Icons.Material.Filled.NoAccounts,
        _ => Icons.Material.Filled.HelpOutline
    };

    private string StatusTitle => _access switch
    {
        { IsApproved: true } => "Erişiminiz onaylı",
        { IsRejected: true } => "Erişim talebiniz reddedildi",
        { IsPending: true } => "Erişiminiz onay bekliyor",
        { IsDisabled: true } => "Erişiminiz devre dışı",
        _ => "Erişim durumu belirlenemedi"
    };

    private string StatusDescription => _access switch
    {
        { IsApproved: true } =>
            "WASAS ekranlarını rolleriniz kapsamında kullanabilirsiniz.",
        { IsRejected: true } =>
            "Bir yönetici erişim talebinizi reddetti. Bekleyen bir talebiniz yok ve uygulamayı yeniden açmanız yeni bir talep oluşturmaz. Erişim gerekiyorsa yöneticinizle görüşün.",
        { IsPending: true } =>
            "Kimliğiniz doğrulandı ve erişim talebiniz oluşturuldu. Bir yönetici talebinizi sonuçlandırana kadar operasyon ekranları kapalıdır.",
        { IsDisabled: true } =>
            "Uygulama erişiminiz devre dışı bırakıldı. Yeniden açılması için platform yöneticinize başvurun.",
        _ =>
            "Erişim bilgileriniz şu anda okunamadı."
    };

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AccessProvider.Changed -= OnAccessChanged;
}
