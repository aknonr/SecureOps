@page "/access/users"
@attribute [Authorize]
@implements IDisposable
@inject ICurrentAccessProvider AccessProvider
@inject IAccessAdminApiClient AccessAdmin
@inject NavigationManager Navigation

<PageTitle>Kullanıcılar · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide so-access-workspace">
    <SoPageHeader Title="Kullanıcılar">
        <Actions>
            @if (_access?.Can(Capabilities.AccessAssignRoles) == true && _access.Can(Capabilities.AccessManageUsers))
            {
                <MudButton Href="access/roles" StartIcon="@Icons.Material.Outlined.AdminPanelSettings">Rol tanımları</MudButton>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" title="Listeyi yenile" aria-label="Listeyi yenile" Disabled="_loading" OnClick="LoadAsync" />
        </Actions>
    </SoPageHeader>
    @if (_access is null)
    {
        <SoLoading Message="Yetkiler doğrulanıyor" />
    }
    else if (!_access.IsResolved)
    {
        <SoProblemPanel Problem="_access.Problem!" OnRetry="LoadAsync" />
    }
    else if (!_access.Can(Capabilities.AccessManageUsers))
    {
        <MudAlert Severity="Severity.Warning">Kullanıcı yönetimi yetkiniz yok.</MudAlert>
    }
    else
    {
        <form class="so-access-filters" @onsubmit="ApplyFilters" @onsubmit:preventDefault>
            <label>Kullanıcı ara<input value="@_search" @oninput="e => _search = e.Value?.ToString()" maxlength="128" placeholder="Ad, hesap veya e-posta" /></label>
            <label>Erişim durumu<select @bind="_status">
                <option value="">Tümü</option><option value="Approved">Onaylı</option><option value="Pending">Onay bekleyen</option><option value="Rejected">Talebi reddedilmiş</option><option value="Disabled">Kapatılmış</option>
            </select></label>
            <label>Rol<select @bind="_role"><option value="">Tüm roller</option>
                @foreach (AccessRoleDefinition role in _roles) { <option value="@role.Code">@RoleName(role)</option> }
            </select></label>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search">Ara</MudButton>
        </form>
        @if (_problem is not null) { <SoProblemPanel Problem="_problem" OnRetry="LoadAsync" /> }
        <div aria-live="polite" class="so-access-count">@(_page is null ? "" : $"{_page.Total} eşleşen kullanıcı")</div>
        @if (_loading) { <SoLoading Message="Kullanıcılar yükleniyor" Bare="true" /> }
        else if (_page?.Items.Count == 0) { <p>Eşleşen kullanıcı yok.</p> }
        else if (_page is not null)
        {
            <div class="so-access-table" role="table" aria-label="Kullanıcılar">
                <div class="so-access-table-head" role="row"><span role="columnheader">Kullanıcı</span><span role="columnheader">Roller</span><span role="columnheader">Durum</span><span role="columnheader">Son oturum</span></div>
                @foreach (AccessUserResponse user in _page.Items)
                {
                    <a class="so-access-table-row" role="row" href="@DetailLink(user.UserId)">
                        <span role="cell"><strong>@AccessIdentityDisplay.Name(user.Profile, user.CorporateIdentity)</strong><small>@user.Profile?.Account</small><small>@user.Profile?.Email</small></span>
                        <span role="cell">@string.Join(", ", user.Roles.Select(code => _roles.FirstOrDefault(role => role.Code == code) is { } role ? RoleName(role) : AccessLabels.RoleLabel(code)))</span>
                        <span role="cell"><SoStatusBadge Label="@AccessUserView.StatusLabel(user)" Tone="@AccessUserView.StatusTone(user)" /></span>
                        <span role="cell">@user.LastAuthenticatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></span>
                    </a>
                }
            </div>
            <nav class="so-access-pagination" aria-label="Kullanıcı sayfaları">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" title="Önceki sayfa" aria-label="Önceki sayfa" Disabled="@(Page <= 1)" OnClick="() => GoPage(Page - 1)" />
                <span>@Page / @Math.Max(1, (int)Math.Ceiling(_page.Total / 25d))</span>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" title="Sonraki sayfa" aria-label="Sonraki sayfa" Disabled="@(Page * 25L >= _page.Total)" OnClick="() => GoPage(Page + 1)" />
            </nav>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? RoleFilter { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int Page { get; set; } = 1;
    private AccessSnapshot? _access;
    private AccessPage<AccessUserResponse>? _page;
    private IReadOnlyList<AccessRoleDefinition> _roles = [];
    private UiProblem? _problem;
    private string? _search, _status, _role;
    private bool _loading;
    private int _generation;
    private readonly CancellationTokenSource _lifetime = new();
    protected override void OnInitialized() => AccessProvider.Changed += OnAccessChanged;
    protected override async Task OnParametersSetAsync()
    {
        _search = Search; _status = Status; _role = RoleFilter;
        Page = Math.Max(1, Page);
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        int generation = ++_generation;
        _loading = true; _problem = null;
        try
        {
            _access = await AccessProvider.GetAsync(_lifetime.Token);
            if (!_access.Can(Capabilities.AccessManageUsers)) { _page = null; return; }
            IReadOnlyList<AccessRoleDefinition> roles = await AccessAdmin.RolesAsync(_lifetime.Token);
            AccessPage<AccessUserResponse> page = await AccessAdmin.PageUsersAsync(new(Search, Status, RoleFilter, Page), _lifetime.Token);
            if (generation != _generation) { return; }
            _roles = roles; _page = page;
        }
        catch (SecureOpsApiException exception) { if (generation == _generation) { _problem = exception.Problem; _page = null; } }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { if (generation == _generation) { _loading = false; } }
    }
    private void ApplyFilters() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["q"] = _search, ["status"] = _status, ["role"] = _role, ["page"] = 1 }));
    private void GoPage(int page) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("page", page));
    private string DetailLink(Guid id) => $"access/users/{id}?returnTo={Uri.EscapeDataString("/access/users" + new Uri(Navigation.Uri).Query)}";
    private static string RoleName(AccessRoleDefinition role) => role.Name == role.Code ? AccessLabels.RoleLabel(role.Code) : role.Name;
    private void OnAccessChanged() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    public void Dispose() { AccessProvider.Changed -= OnAccessChanged; ++_generation; _lifetime.Cancel(); _lifetime.Dispose(); }
}
