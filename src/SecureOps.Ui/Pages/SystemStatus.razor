@page "/admin/system-status"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.Extensions.Logging
@inject ISessionApiClient Sessions
@inject IIdentityLookupApiClient IdentityClient
@inject ICurrentAccessProvider AccessProvider
@inject ILogger<SystemStatus> Logger

<PageTitle>Sistem Durumu · @WasasBrand.Name</PageTitle>

@*
    Integration state for the providers SecureOps talks to.

    Only what the API returns: provider name, configured selection, and a status word. No URL, no
    credential, no account, no remote response body. Those are the things an operational status page
    tends to accumulate and the reason it then cannot be shown to the people who need it.

    Only three providers are reported, so only three appear. SQL Server, Hangfire, and the audit
    store have no entry on this endpoint, and inventing tiles for them would put a green light next
    to something nobody checked.
*@

<div class="so-page">
    <SoPageHeader Title="Sistem Durumu"
                  Lead="Kurumsal sağlayıcı ayarları ve ayrı iş akışı kontrolleri.">
        <Actions>
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(_loading || _diagnosticsBusy)"
                       aria-label="Kurumsal entegrasyonları yenile"
                       OnClick="ReloadAsync">
                Yenile
            </MudButton>
        </Actions>
    </SoPageHeader>

    @if (_access is null)
    {
        <SoLoading Message="Yetkileriniz doğrulanıyor…" />
    }
    else if (!_access.IsResolved)
    {
        <SoProblemPanel Problem="_access.Problem!" OnRetry="ReloadAccessAsync" />
    }
    else if (!_access.Can(Capabilities.AccessManageUsers))
    {
        @* The endpoint is Admin-only on the server. Gating on the administrative capability the
           access contract exposes keeps the UI's guess aligned with the server's rule without
           reading a role name. *@
        <section class="so-panel so-panel--blocked">
            <h2 class="so-panel-title">Bu alana erişim yetkiniz yok</h2>
            <p class="so-panel-text">
                Sistem durumunu görüntülemek yönetici yetkisi gerektirir. Hesabınızda tanımlı
                yetkileri <MudLink Href="access/me">Erişimim</MudLink> sayfasından görebilirsiniz.
            </p>
        </section>
    }
    else
    {
        <section class="so-panel">
            <div class="so-panel-head">
                <h2 class="so-panel-title">Kurumsal entegrasyonlar</h2>
            </div>

            @if (_problem is not null)
            {
                <SoProblemPanel Problem="_problem" OnRetry="ReloadAsync" RetryLabel="Yeniden dene" />
            }
            else if (_loading && _health is null)
            {
                <SoLoading Message="Durum getiriliyor…" Variant="SoLoading.LoadingVariant.Block" />
            }
            else if (_health is not null)
            {
                <p class="so-panel-text so-panel-text--sm" aria-live="polite">
                    Bu bilgi @OperationsReadinessPresentation.Time(_readAt) anında bu sayfa tarafından okundu.
                    Sağlayıcıların kendi kontrol zamanı API tarafından bildirilmiyor.
                </p>

                @if (_health.SimulationMode || _health.ReadOnlyIntegrationMode)
                {
                    <div class="so-panel-note so-panel-note--caution" role="note">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" aria-hidden="true" />
                        <span>
                            @if (_health.SimulationMode) { <strong>Simülasyon: </strong>@(_health.OperatorNotice ?? "Turuncu Hat ve Jira simülasyon sağlayıcısında.") }
                            @if (_health.ReadOnlyIntegrationMode) { <strong>@(_health.ReadOnlyNotice ?? "Yazma kapalı.")</strong> }
                        </span>
                    </div>
                }

                <div class="so-status-grid">
                    <SoIntegrationCard Provider="_health.TuruncuHat"
                                       Title="Turuncu Hat"
                                       Description="Operasyonel kayıtların alındığı kaynak sistem." />
                    <SoIntegrationCard Provider="_health.Jira"
                                       Title="Jira"
                                       Description="Operasyonel kayıtların aktarıldığı hedef sistem." />
                    @* The identity endpoint reports "Configured" for any selected provider and tracks no
                       failures, so its meaning is narrower than the two cards above. *@
                    <SoIntegrationCard Provider="_directoryProvider"
                                       Title="Dizin (AD)"
                                       Description="Kimlik ve grup sorgularının kaynağı."
                                       StatusDetail="@DirectoryDetail"
                                       Note="@DirectoryNote" />
                </div>

                <details>
                    <summary>Durumlar ne anlama gelir?</summary>
                    <ul class="so-panel-text so-panel-text--sm">
                        <li><strong>Yapılandırıldı · sınanmadı:</strong> sağlayıcı seçili; bağlantı veya iş akışı kabulü değildir.
                            Turuncu Hat sağlayıcısı tanımlı olsa da OCO kaynak toplama ayrıca kapalı olabilir.</li>
                        <li><strong>Son çağrı başarısız:</strong> bu API sürecinde o sağlayıcıya yapılan son çağrı başarısız oldu.</li>
                        <li><strong>Devre dışı:</strong> sağlayıcı bu ortamda etkin değil.</li>
                        <li><strong>Okunamadı:</strong> durum alınamadı; bilinmiyor olarak okuyun.</li>
                    </ul>
                    <p class="so-panel-text so-panel-text--sm">Kartlar yalnız sağlayıcı, seçim ve durum bilgisini gösterir; uzak sistem hata içeriklerini göstermez. Yenile yalnız bu bölümü yeniler.</p>
                </details>
            }
        </section>

        <section class="so-panel" aria-labelledby="unreported-title">
            <h2 class="so-panel-title" id="unreported-title">Bu sayfada durumu gösterilmeyenler</h2>
            <p class="so-panel-text so-panel-text--sm">
                Aşağıdakiler için bu sayfanın kullandığı yanıtlarda durum bilgisi yok. Durumları burada
                <strong>bilinmiyor</strong> olarak kalır; çalıştıkları veya çalışmadıkları sonucu çıkarılamaz.
            </p>
            <ul class="so-panel-text so-panel-text--sm">
                <li>SQL Server veritabanı ve denetim (audit) deposu</li>
                <li>Hangfire / Worker hizmeti — yalnız aşağıdaki iş akışı kontrolünde heartbeat kaydı olarak görünür</li>
                <li>SMTP bağlantısı — iş akışı kontrolü bağlantı sınamaz</li>
            </ul>
        </section>

        @if (_access.Can(Capabilities.SystemDiagnostics))
        { <OperationsReadinessPanel RefreshBusy="_loading" BusyChanged="@(busy => _diagnosticsBusy = busy)" /> }
    }
</div>

@code {
    private AccessSnapshot? _access;
    private EnterpriseIntegrationHealthResponse? _health;
    private IdentityProviderHealthResponse? _directory;
    private IntegrationProviderHealthResponse? _directoryProvider;
    private UiProblem? _problem;
    private DateTimeOffset _readAt;
    private bool _loading;
    private bool _diagnosticsBusy;

    protected override async Task OnInitializedAsync()
    {
        AccessProvider.Changed += OnAccessChanged;
        _access = await AccessProvider.GetAsync(CancellationToken.None);

        if (_access.Can(Capabilities.AccessManageUsers))
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAccessAsync()
    {
        _access = await AccessProvider.RefreshAsync(CancellationToken.None);

        if (_access.Can(Capabilities.AccessManageUsers))
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        if (_loading || _diagnosticsBusy) { return; }
        _loading = true;
        _problem = null;
        StateHasChanged();

        try
        {
            _health = await Sessions.GetIntegrationHealthAsync(CancellationToken.None);
            await LoadDirectoryAsync();
            _readAt = DateTimeOffset.UtcNow;
        }
        catch (SecureOpsApiException ex)
        {
            _health = null;
            _problem = ex.Problem;
            Logger.LogDebug("Integration health unavailable. Code: {Code}.", ex.Problem.Code);
        }
        finally
        {
            _loading = false;
        }

    }

    // The directory provider is reported by a different endpoint in a different shape. It is mapped
    // onto the same card rather than given its own layout, because to an operator it is one more
    // integration; the mapping is presentational and adds no status the API did not state.
    private async Task LoadDirectoryAsync()
    {
        try
        {
            _directory = await IdentityClient.GetProviderHealthAsync(CancellationToken.None);
            _directoryProvider = new IntegrationProviderHealthResponse(
                "Directory",
                _directory.Provider,
                _directory.Status);
        }
        catch (SecureOpsApiException ex)
        {
            _directory = null;
            _directoryProvider = null;
            Logger.LogDebug("Identity provider health unavailable. Code: {Code}.", ex.Problem.Code);
        }
    }

    private string? DirectoryDetail => _directory?.Status != "Configured"
        ? null
        : "Dizin sağlayıcısı seçili. Bu uç nokta bağlantı sınamaz ve başarısız çağrıları izlemez; sorgu sonucunu Kimlik sorgulama ekranı gösterir.";

    private string? DirectoryNote => _directory is { RealDirectoryProviderEnabled: false }
        ? "Kurumsal dizin bağlantısı bu ortamda etkin değil; sorgular test sağlayıcısından yanıtlanır."
        : null;

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AccessProvider.Changed -= OnAccessChanged;
}
