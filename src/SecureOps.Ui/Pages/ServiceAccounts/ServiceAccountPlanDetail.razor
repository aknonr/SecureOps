@page "/service-accounts/plans/{Id:guid}"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts

<PageTitle>@(_plan?.Title ?? "Değişiklik planı") · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="@(_plan?.Title ?? "Değişiklik planı")" Lead="@(_plan is null ? null : "gMSA'ya geçiş planı · " + _plan.StatusLabel)">
        <Actions>
            <MudButton Href="service-accounts/plans" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Tüm planlar</MudButton>
            <SaModuleLinks Access="Access" Current="plans" />
        </Actions>
    </SoPageHeader>
    <SaPageGuide Title="@ServiceAccountGuides.PlanDetail.Title" Purpose="@ServiceAccountGuides.PlanDetail.Purpose" Steps="ServiceAccountGuides.PlanDetail.Steps" Never="@ServiceAccountGuides.PlanDetail.Never" />
    <SaProblem Problem="@(_problemSection is null ? Problem : null)" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="Servis hesaplarını görüntüleme yetkisi gerekli" Description="Yetki ve kurum/ekip kapsamı modül yöneticisi tarafından verilir." /> }
    else if (_plan is null && Busy) { <SoLoading Message="Plan okunuyor" Variant="SoLoading.LoadingVariant.Block" /> }
    else if (_plan is null)
    {
        <SoEmptyState Title="Plan gösterilemiyor"
                      Description="Plan yok, kapsamınız dışında ya da okunamadı; yukarıdaki açıklama hangisi olduğunu söylüyor. Kapsamınız dışındaki bir plan, olmayan plandan ayırt edilemez." />
    }
    else
    {
        ChangePlanView plan = _plan;
        IReadOnlyList<PlanStep> steps = ChangePlanPresentation.Steps(plan);
        bool cancelled = plan.Status == "Cancelled";
        bool reachedChecklist = plan.Status is "Approved" or "InProgress" or "Completed";

        <SaPlanSteps Plan="plan" />

        @if (cancelled)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" role="status">Plan iptal edildi; kayıtları saklanır, hiçbir adım ilerletilemez. Yönetilen sunucularda hiçbir şey değiştirilmedi.</MudAlert>
        }

        @* 1. Plan *@
        <section id="sa-plan-plan" class="so-panel" aria-labelledby="sa-plan-plan-title">
            <div class="so-panel-head">
                <h2 id="sa-plan-plan-title" class="so-panel-title">1. Plan</h2>
                <SoStatusBadge Label="@plan.StatusLabel" Tone="@ChangePlanPresentation.StatusTone(plan.Status)" Icon="@ChangePlanPresentation.StatusIcon(plan.Status)" />
            </div>
            <p class="so-panel-text--sm">@Missing(steps, "plan")</p>
            <SaProblem Problem="@ProblemIn("plan")" OnRetry="LoadAsync" />
            <SoFieldGrid>
                <SoField Label="Hazırlayan" Value="@plan.CreatedBy" />
                <SoField Label="Oluşturuldu" Value="@ChangePlanPresentation.Instant(plan.CreatedAt)" />
                <SoField Label="Son değişiklik" Value="@ChangePlanPresentation.Instant(plan.UpdatedAt)" />
                <SoField Label="Hesap sayısı" Value="@plan.Accounts.Count.ToString()" />
            </SoFieldGrid>
            <MudTable Items="plan.Accounts" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" T="ChangePlanAccountView" Class="sa-plan-table mt-2">
                <HeaderContent>
                    <MudTh>Hesap</MudTh><MudTh>Domain</MudTh><MudTh>Hedef gMSA adı</MudTh><MudTh>Bağlı talep</MudTh>
                    @if (plan.Status == "Completed") { <MudTh>Kapanış sonucu</MudTh> }
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Hesap"><MudLink Href="@($"service-accounts/{context.AccountId}")">@context.AccountName</MudLink></MudTd>
                    <MudTd DataLabel="Domain">@(context.Domain ?? "Kayıtlı değil")</MudTd>
                    <MudTd DataLabel="Hedef gMSA adı">@context.TargetGmsaName</MudTd>
                    <MudTd DataLabel="Bağlı talep">@(context.RequestId is null ? "Yok" : "Var (plan kapanınca talep kapanmaz)")</MudTd>
                    @if (plan.Status == "Completed")
                    {
                        <MudTd DataLabel="Kapanış sonucu">
                            @(context.OutcomeLabel ?? context.Outcome ?? "Sonuç bilgisi yok")
                            @if (context.Outcome == "Performed")
                            {
                                <div class="so-panel-text--sm">Doğrulanmamış işlem kaydı oluştu; doğrulama hesap sayfasında ayrıca yapılır.</div>
                            }
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
            @if (plan.Permissions.Edit)
            {
                <SaDisclosure Title="Hesapları ve hedef adları düzenle" Class="mt-3">
                    @if (plan.Status == "Previewed")
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Değişiklik kaydedilirse plan taslağa döner, önizleme geçersiz olur ve henüz verilmemiş bir onay isteği bayat sayılır.</MudAlert>
                    }
                    <SaPlanAccountsEditor Rows="_draft" Results="_results" Busy="Busy" SubmitLabel="Değişiklikleri kaydet" OnSubmit="UpdateAsync" Search="SearchAccountsAsync" />
                </SaDisclosure>
            }
            else if (plan.Status is "Draft" or "Previewed")
            {
                <p class="so-panel-text--sm mt-2" role="note">Planı değiştirme yetkiniz görünmüyor (Çalışma yetkisi ve planın tüm hesaplarında sorumlu dayanak gerekir). Sunucu her işlemde yeniden karar verir.</p>
            }
        </section>

        @* 2. Önizleme *@
        <section id="sa-plan-preview" class="so-panel" aria-labelledby="sa-plan-preview-title">
            <div class="so-panel-head">
                <h2 id="sa-plan-preview-title" class="so-panel-title">2. Önizleme</h2>
                <SoStatusBadge Label="@StepLabel(steps, "preview")" Tone="@StepTone(steps, "preview")" Icon="@StepIcon(steps, "preview")" />
            </div>
            <p class="so-panel-text--sm">@Missing(steps, "preview")</p>
            <SaProblem Problem="@ProblemIn("preview")" OnRetry="LoadAsync" />
            @if (plan.Permissions.Preview)
            {
                <MudButton Variant="@(plan.Preview is null ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="PreviewAsync" Disabled="Busy"
                           StartIcon="@Icons.Material.Filled.Preview">@(plan.Preview is null ? "Önizleme oluştur" : "Önizlemeyi yenile")</MudButton>
                <p class="so-panel-text--sm mt-1">Her hesabın son keşif taramasından yeni bir sürüm üretir. Sunucuya bağlanılmaz. Yeni sürüm, öncekine verilecek onayı geçersiz kılar.</p>
            }
            else if (plan.Status is "Draft" or "Previewed")
            {
                <p class="so-panel-text--sm" role="note">Önizleme isteme yetkiniz görünmüyor (Çalışma yetkisi ve planın tüm hesaplarında sorumlu dayanak gerekir).</p>
            }

            @if (plan.Preview is { } preview)
            {
                @if (plan.Status == "Previewed")
                {
                    <SaPlanPreview Preview="preview" Items="_items" Failed="_itemsFailed" Busy="Busy" OnPage="GoToItemsPageAsync" />
                }
                else
                {
                    <SaDisclosure Title="@($"Onaylanan önizleme: sürüm {preview.Version} (özet {ChangePlanPresentation.ShortDigest(preview.Sha256)}…)")" Class="mt-2">
                        <SaPlanPreview Preview="preview" Items="_items" Failed="_itemsFailed" Busy="Busy" OnPage="GoToItemsPageAsync" />
                    </SaDisclosure>
                }
            }
            else if (plan.Status != "Draft")
            {
                <p class="so-panel-text--sm" role="note">Bu plan için kayıtlı bir önizleme görünmüyor.</p>
            }
        </section>

        @* 3. Onay *@
        <section id="sa-plan-approval" class="so-panel" aria-labelledby="sa-plan-approval-title">
            <div class="so-panel-head">
                <h2 id="sa-plan-approval-title" class="so-panel-title">3. Onay</h2>
                <SoStatusBadge Label="@StepLabel(steps, "approval")" Tone="@StepTone(steps, "approval")" Icon="@StepIcon(steps, "approval")" />
            </div>
            <p class="so-panel-text--sm">@Missing(steps, "approval")</p>
            <SaProblem Problem="@ProblemIn("approval")" OnRetry="LoadAsync" ShowFieldMessage="@(OcoFieldError is null)" />
            @if (plan.Approval is { } approval)
            {
                <SoFieldGrid>
                    <SoField Label="Onaylanan önizleme" Value="@($"Sürüm {approval.PreviewVersion}")" />
                    <SoField Label="Özet (SHA-256)"><code class="sa-plan-sha" title="@approval.Sha256">@ChangePlanPresentation.ShortDigest(approval.Sha256)…</code></SoField>
                    <SoField Label="OCO numarası" Value="@approval.OcoNumber" />
                    <SoField Label="Bakım penceresi" Value="@($"{ChangePlanPresentation.Instant(approval.WindowStart)} – {ChangePlanPresentation.Instant(approval.WindowEnd)}")" />
                    <SoField Label="Gerekçe" Value="@approval.Reason" />
                    <SoField Label="Onaylayan" Value="@approval.ApprovedBy" />
                    <SoField Label="Onay zamanı" Value="@ChangePlanPresentation.Instant(approval.ApprovedAt)" />
                </SoFieldGrid>
                <p class="so-panel-text--sm mt-1">OCO numarası ITSM'de sorgulanmadı; sunucu biçimini doğruladı ve büyük harfe çevirip kaydetti. Onay yalnız yukarıdaki önizleme sürümü ve özeti içindir.</p>
            }
            else if (plan.Status == "Previewed")
            {
                @if (plan.Permissions.Approve)
                {
                    <SaPlanApproveForm Plan="plan" Busy="Busy" OnApprove="ApproveAsync" OcoError="@OcoFieldError" />
                }
                else if (plan.Permissions.ApproveBlockedReason is { } blocked)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" role="note">@(ServiceAccountProblems.FieldText(blocked))</MudAlert>
                }
                else
                {
                    <p class="so-panel-text--sm" role="note">Bu planı onaylama yetkiniz görünmüyor (Doğrulama yetkisi ve planın tüm hesaplarında sorumlu dayanak gerekir). Sunucu her işlemde yeniden karar verir.</p>
                }
            }
        </section>

        @* 4. Kontrol listesi *@
        <section id="sa-plan-checklist" class="so-panel" aria-labelledby="sa-plan-checklist-title">
            <div class="so-panel-head">
                <h2 id="sa-plan-checklist-title" class="so-panel-title">4. Kontrol listesi</h2>
                <SoStatusBadge Label="@StepLabel(steps, "checklist")" Tone="@StepTone(steps, "checklist")" Icon="@StepIcon(steps, "checklist")" />
            </div>
            <p class="so-panel-text--sm">@Missing(steps, "checklist")</p>
            <SaProblem Problem="@ProblemIn("checklist")" OnRetry="LoadAsync" />
            @if (reachedChecklist)
            {
                @if (plan.Approval is { } approved && DateTimeOffset.UtcNow > approved.WindowEnd)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" role="note">
                        Onaylanan bakım penceresi geçti. Pencere dışında yapılan işaretler engellenmez; kayıtta ve ekranda "pencere dışında" etiketini taşır.
                    </MudAlert>
                }
                <SaPlanChecklist Plan="plan" Items="_items" Failed="_itemsFailed" Busy="Busy" OnPage="GoToItemsPageAsync" OnMark="CheckAsync" />
                <SaProblem Problem="@ProblemIn("evidence")" OnRetry="LoadAsync" />
                <SaPlanEvidence Plan="plan" Busy="Busy" OnUpload="UploadEvidenceAsync" OnDownload="DownloadEvidenceAsync" />
                <SaProblem Problem="@ProblemIn("complete")" OnRetry="LoadAsync" />
                @if (plan.Status != "Completed")
                {
                    <SaPlanComplete Plan="plan" Busy="Busy" OnComplete="CompleteAsync" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" role="status">
                        Plan kapatıldı. Yapıldı işaretleri kişi beyanıdır; hiçbir hesap doğrulanmış sayılmadı ve bağlı talep kapanmadı.
                    </MudAlert>
                }
            }
        </section>

        @* 5. Doğrulama *@
        <section id="sa-plan-verification" class="so-panel" aria-labelledby="sa-plan-verification-title">
            <div class="so-panel-head">
                <h2 id="sa-plan-verification-title" class="so-panel-title">5. Doğrulama</h2>
                <SoStatusBadge Label="@StepLabel(steps, "verification")" Tone="@StepTone(steps, "verification")" Icon="@StepIcon(steps, "verification")" />
            </div>
            <p class="so-panel-text--sm">@Missing(steps, "verification")</p>
            <p class="so-panel-text--sm">
                Doğrulama bu plandan ayrıdır: değişiklikten sonra sunucularda çalıştırılan gMSA kontrol taraması hesabın "Kullanım taraması" sekmesine yüklenir,
                doğrulama yetkilisi hesabı kendi sayfasında doğrular. Plan kapanması bir hesabı doğrulanmış saymaz ve bağlı talebi kapatmaz.
            </p>
            @if (reachedChecklist || plan.Status == "Completed")
            {
                <ul class="sa-plan-verify-list" aria-label="Doğrulama için hesap sayfaları">
                    @foreach (ChangePlanAccountView account in plan.Accounts)
                    {
                        <li><MudLink Href="@($"service-accounts/{account.AccountId}")">@account.AccountName hesap sayfası</MudLink></li>
                    }
                </ul>
            }
        </section>

        @* Cancel *@
        @if (plan.Permissions.Cancel)
        {
            <section class="so-panel" aria-labelledby="sa-plan-cancel-title">
                <div class="so-panel-head"><h2 id="sa-plan-cancel-title" class="so-panel-title">Planı iptal et</h2></div>
                <SaProblem Problem="@ProblemIn("cancel")" OnRetry="LoadAsync" />
                <SaDisclosure Title="İptal gerekçesini yaz">
                    <p class="so-panel-text--sm">İptal geri alınamaz; plan ve tüm kayıtları saklanır, hesaplar başka bir plana alınabilir. Yönetilen sunucularda hiçbir şey değiştirilmez.</p>
                    <MudTextField T="string" @bind-Value="_cancelReason" Label="İptal gerekçesi" MaxLength="1000" Lines="2" Immediate="true" Variant="Variant.Outlined" Required="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mt-2" OnClick="CancelAsync"
                               Disabled="@(Busy || string.IsNullOrWhiteSpace(_cancelReason))">Planı iptal et</MudButton>
                </SaDisclosure>
            </section>
        }

        @* History *@
        <section class="so-panel" aria-labelledby="sa-plan-events-title">
            <div class="so-panel-head"><h2 id="sa-plan-events-title" class="so-panel-title">Plan geçmişi</h2></div>
            <p class="so-panel-text--sm">İşlem kanıtıdır, kişi performansı değildir.</p>
            @if (plan.Events.Count == 0) { <SoEmptyState Title="Kayıtlı olay yok" /> }
            else
            {
                <MudTable Items="plan.Events" Dense="true" Breakpoint="Breakpoint.Sm" T="ChangePlanEventView" Class="sa-plan-table">
                    <HeaderContent><MudTh>Zaman</MudTh><MudTh>Olay</MudTh><MudTh>Durum</MudTh><MudTh>Yapan</MudTh><MudTh>Gerekçe</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Zaman">@ChangePlanPresentation.Instant(context.At)</MudTd>
                        <MudTd DataLabel="Olay">@ChangePlanPresentation.EventLabel(context.Event)@(context.PreviewVersion is { } v ? " (sürüm " + v + ")" : "")</MudTd>
                        <MudTd DataLabel="Durum">@(context.FromStatus is null ? context.ToStatus : context.FromStatus + " → " + context.ToStatus)</MudTd>
                        <MudTd DataLabel="Yapan">@context.Actor</MudTd>
                        <MudTd DataLabel="Gerekçe">@(context.Reason ?? "—")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </section>
    }
</div>

@code {
    private const int ItemsPageSize = 50;
    private ChangePlanView? _plan;
    private ChangePlanItemPage? _items;
    private bool _itemsFailed;
    private int _itemsPage = 1;
    private Guid _loadedId;
    private string? _problemSection;
    private string _cancelReason = string.Empty;
    private List<PlanAccountDraft> _draft = [];
    private IReadOnlyList<ChangePlanAccountResult> _results = [];

    /// <summary>Plan id from the route.</summary>
    [Parameter] public Guid Id { get; set; }

    protected override string RequiredCapability => ServiceAccountCapabilities.View;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Guid.Empty && _loadedId != Id && Allowed)
        {
            await LoadAsync();
        }
    }

    protected override Task LoadAsync()
    {
        _loadedId = Id;
        _problemSection = null;
        _itemsPage = 1;
        return RunSerializedAsync(async token =>
        {
            _plan = null;
            _items = null;
            _itemsFailed = false;
            _plan = await Api.GetAsync<ChangePlanView>($"/change-plans/{Id}", token);
            _draft = PlanAccountDraft.From(_plan.Accounts);
            await ReadItemsAsync(token);
        });
    }

    /// <summary>Reads the current preview's rows; a failure here keeps the plan on screen and says the rows are unknown.</summary>
    private async Task ReadItemsAsync(CancellationToken token)
    {
        _itemsFailed = false;
        if (_plan?.Preview is null)
        {
            _items = null;
            return;
        }

        try
        {
            _items = await Api.GetAsync<ChangePlanItemPage>($"/change-plans/{Id}/items?page={_itemsPage}&pageSize={ItemsPageSize}", token);
        }
        catch (SecureOpsApiException ex)
        {
            (_items, _itemsFailed, Problem) = (null, true, ex.Problem);
            _problemSection = _plan?.Status is "Approved" or "InProgress" or "Completed" ? "checklist" : "preview";
        }
    }

    private Task GoToItemsPageAsync(int page)
    {
        _itemsPage = page;
        return RunAsync(ReadItemsAsync);
    }

    /// <summary>Takes the server's view as the truth (after a command or a 409) and refreshes what depends on it.</summary>
    private async Task AdoptAsync(ChangePlanView view)
    {
        bool previewChanged = _plan?.Preview?.Version != view.Preview?.Version || _plan?.Status != view.Status;
        // Every checklist mark changes the plan version; the rows carry the marks, so they are read again.
        bool marksChanged = _plan?.Version != view.Version && view.Status is "Approved" or "InProgress" or "Completed";
        _plan = view;
        _draft = PlanAccountDraft.From(view.Accounts);
        if (previewChanged)
        {
            _itemsPage = 1;
            _items = null;
        }

        if (previewChanged || marksChanged)
        {
            await RunAsync(ReadItemsAsync, clearProblem: false);
        }
    }

    /// <summary>A 409 carries the plan as the caller may read it now; adopt it instead of the stale view (nothing was written).</summary>
    private async Task AdoptConflictAsync()
    {
        if (ChangePlanPresentation.CurrentPlan(ProblemCurrentJson) is { } current && current.Id == Id)
        {
            await AdoptAsync(current);
        }
    }

    private async Task<bool> CommandAsync(string section, HttpMethod method, string path, object body)
    {
        _problemSection = section;
        _results = [];
        ChangePlanView? view = null;
        bool ok = await RunAsync(async token => view = await Api.SendAsync<ChangePlanView>(method, path, body, token));
        if (ok && view is not null)
        {
            await AdoptAsync(view);
            return true;
        }

        await AdoptConflictAsync();
        _results = ChangePlanPresentation.AccountResults(ProblemCurrentJson);
        return false;
    }

    /// <summary>
    /// Records one checklist mark. A refusal (409 checkStale, a closed plan, a missing right) changes nothing on the server; the
    /// row is shown as the server has it now and the person's draft stays in the form.
    /// </summary>
    private Task<bool> CheckAsync(PlanCheckCommand command) =>
        RenderedAsync(CommandAsync("checklist", HttpMethod.Post, $"/change-plans/{Id}/items/{command.ItemId}/checks", command.Request));

    private Task<bool> CompleteAsync(CompleteChangePlanRequest request) =>
        RenderedAsync(CommandAsync("complete", HttpMethod.Post, $"/change-plans/{Id}/complete", request));

    /// <summary>
    /// The child forms call back through plain delegates (they need the outcome to clear their draft), which do not re-render this page
    /// the way an EventCallback does; render once the command and the adoption of the server's view are finished.
    /// </summary>
    private async Task<bool> RenderedAsync(Task<bool> command)
    {
        bool result = await command;
        await InvokeAsync(StateHasChanged);
        return result;
    }

    /// <summary>Attaches a file to the plan; without migration 034 the server answers 503 and nothing is saved.</summary>
    private Task<bool> UploadEvidenceAsync(SaEvidenceUpload upload) => RenderedAsync(SendEvidenceAsync(upload));

    private async Task<bool> SendEvidenceAsync(SaEvidenceUpload upload)
    {
        _problemSection = "evidence";
        ChangePlanView? view = null;
        bool ok = await RunAsync(async token => view = await Api.UploadAsync<ChangePlanView>($"/change-plans/{Id}/evidence", upload.FileName,
            upload.ContentType, upload.Content, new Dictionary<string, string?> { ["label"] = upload.Label }, token));
        if (ok && view is not null)
        {
            _plan = view;
            return true;
        }

        await AdoptConflictAsync();
        return false;
    }

    private Task DownloadEvidenceAsync(Guid evidenceId)
    {
        _problemSection = "evidence";
        return RunAsync(async token => await SaveFileAsync(await Api.DownloadAsync($"/evidence/{evidenceId}", token)));
    }

    private Task PreviewAsync() => CommandAsync("preview", HttpMethod.Post, $"/change-plans/{Id}/preview", new PreviewChangePlanRequest(_plan!.Version));

    private Task UpdateAsync() =>
        CommandAsync("plan", HttpMethod.Patch, $"/change-plans/{Id}", new UpdateChangePlanRequest(_plan!.Version, [.. _draft.Select(r => r.ToInput())]));

    private Task ApproveAsync(ApproveChangePlanRequest request) => CommandAsync("approval", HttpMethod.Post, $"/change-plans/{Id}/approve", request);

    private async Task CancelAsync()
    {
        if (await CommandAsync("cancel", HttpMethod.Post, $"/change-plans/{Id}/cancel", new CancelChangePlanRequest(_plan!.Version, _cancelReason.Trim())))
        {
            _cancelReason = string.Empty;
        }
    }

    /// <summary>Scope-limited account search for the editor; null when it failed (the page problem explains).</summary>
    private async Task<IReadOnlyList<AccountListItem>?> SearchAccountsAsync(string text)
    {
        IReadOnlyList<AccountListItem>? found = null;
        _problemSection = "plan";
        await RunAsync(async token =>
            found = (await Api.GetAsync<AccountPage>("/accounts?page=1&pageSize=10&sort=name&descending=false&search=" + Uri.EscapeDataString(text), token)).Items);
        return found;
    }

    /// <summary>The failure belongs next to the action that raised it (the top of a long page is out of sight); loads show it at the top.</summary>
    /// <summary>The server's explanation when it refused the OCO number (400 field ocoNumber); null otherwise.</summary>
    private string? OcoFieldError => _problemSection == "approval" && Problem?.Fields.FirstOrDefault() == "ocoNumber"
        ? ServiceAccountProblems.FieldText("ocoNumber") : null;

    private UiProblem? ProblemIn(string section) => _problemSection == section ? Problem : null;

    private static string Missing(IReadOnlyList<PlanStep> steps, string key) => steps.First(s => s.Key == key).Missing;

    private static string StepLabel(IReadOnlyList<PlanStep> steps, string key) => ChangePlanPresentation.StepStateLabel(steps.First(s => s.Key == key).State);

    private static SoStatusBadge.BadgeTone StepTone(IReadOnlyList<PlanStep> steps, string key) => steps.First(s => s.Key == key).State switch
    {
        PlanStepState.Done => SoStatusBadge.BadgeTone.Positive,
        PlanStepState.Current => SoStatusBadge.BadgeTone.Caution,
        _ => SoStatusBadge.BadgeTone.Neutral
    };

    private static string StepIcon(IReadOnlyList<PlanStep> steps, string key) => steps.First(s => s.Key == key).State switch
    {
        PlanStepState.Done => Icons.Material.Filled.CheckCircleOutline,
        PlanStepState.Current => Icons.Material.Filled.PlayArrow,
        PlanStepState.Stopped => Icons.Material.Filled.Block,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };
}
