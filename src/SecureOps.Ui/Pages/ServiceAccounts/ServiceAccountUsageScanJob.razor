@page "/service-accounts/usage-scan-jobs/{Id:guid}"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts

@* Live view of one web usage scan. Everything shown comes from the server's view: tiles fill as servers finish, found usages drop
   into the list as they arrive, and the end summary separates "bulunamadı" (complete read, never "kullanılmıyor") from "bilgi yok".
   The polite live region announces milestones only. Colour is never the only signal; motion stops under prefers-reduced-motion. *@
<PageTitle>Web kullanım taraması · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="Web kullanım taraması" Lead="@(_job is null ? null : $"{(_job.Purpose == "GmsaCheck" ? "gMSA kontrol taraması" : "Keşif taraması")} · {_job.StateLabel}")">
        <Actions>
            <MudButton Href="service-accounts" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Hesap listesi</MudButton>
            <SaModuleLinks Access="Access" Current="list" />
        </Actions>
    </SoPageHeader>
    <div class="sr-only" aria-live="polite" role="status">@_announcement</div>
    <SaProblem Problem="Problem" OnRetry="LoadAsync" ShowFieldMessage="false" />
    @if (CommandFieldText is { } why)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" role="alert">@why</MudAlert>
    }
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="Servis hesaplarını görüntüleme yetkisi gerekli" Description="Yetki ve kurum/ekip kapsamı modül yöneticisi tarafından verilir." /> }
    else if (_job is null && Busy) { <SoLoading Message="Tarama okunuyor" Variant="SoLoading.LoadingVariant.Block" /> }
    else if (_job is null)
    {
        <SoEmptyState Title="Tarama gösterilemiyor"
                      Description="Tarama yok, hesaplarından biri kapsamınız dışında ya da okunamadı; yukarıdaki açıklama hangisi olduğunu söylüyor." />
    }
    else
    {
        UsageScanJobView job = _job;
        int percent = UsageScanJobPresentation.Percent(job.Counts);
        bool active = UsageScanJobPresentation.IsActive(job);

        @if (job.IsFake)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" role="note">SAHTE toplayıcı: hiçbir sunucuya bağlanılmadı, sonuçlar gerçek değildir (yalnız geliştirme/demo/test).</MudAlert>
        }

        <section class="so-panel" aria-labelledby="sa-wscan-progress-title">
            <div class="so-panel-head">
                <h2 id="sa-wscan-progress-title" class="so-panel-title">İlerleme</h2>
                <SoStatusBadge Label="@job.StateLabel" Tone="@UsageScanJobPresentation.StateTone(job.State)" Icon="@UsageScanJobPresentation.StateIcon(job.State)" />
            </div>
            <div class="sa-wscan-bar" role="progressbar" aria-labelledby="sa-wscan-progress-title" aria-valuemin="0" aria-valuemax="@job.Counts.Planned"
                 aria-valuenow="@job.Counts.Done" aria-valuetext="@($"{job.Counts.Done} / {job.Counts.Planned} sunucu bitti")">
                <div class="@($"sa-wscan-bar-fill{(active ? " sa-wscan-bar-fill--active" : string.Empty)}")" style="@($"width:{percent}%")"></div>
            </div>
            <p class="so-panel-text sa-wscan-progress-text">@percent% · @UsageScanJobPresentation.ProgressText(job)</p>
            <ul class="sa-wscan-counts" aria-label="Sunucu sonuçları">
                <li class="sa-wscan-count sa-wscan-tile--found"><MudIcon Icon="@UsageScanJobPresentation.TileIcon("Found")" Size="Size.Small" aria-hidden="true" /> Kullanım bulunan: <strong>@job.Counts.Found</strong></li>
                <li class="sa-wscan-count sa-wscan-tile--notfound"><MudIcon Icon="@UsageScanJobPresentation.TileIcon("NotFound")" Size="Size.Small" aria-hidden="true" /> Bulunamadı (tam okundu): <strong>@job.Counts.NotFound</strong></li>
                <li class="sa-wscan-count sa-wscan-tile--uncertain"><MudIcon Icon="@UsageScanJobPresentation.TileIcon("Uncertain")" Size="Size.Small" aria-hidden="true" /> Kısmi okundu: <strong>@job.Counts.Uncertain</strong></li>
                <li class="sa-wscan-count sa-wscan-tile--notcovered"><MudIcon Icon="@UsageScanJobPresentation.TileIcon("NotCovered")" Size="Size.Small" aria-hidden="true" /> Bilgi yok: <strong>@job.Counts.NotCovered</strong></li>
            </ul>
            <p class="so-panel-text--sm sa-wscan-next" role="note">@job.NextStep</p>
            <div class="sa-wscan-actions">
                @if (job.Permissions.Cancel)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.StopCircle" OnClick="CancelAsync"
                               aria-disabled="@(Busy ? "true" : "false")">Taramayı iptal et</MudButton>
                }
                @if (job.CancelRequested && active)
                {
                    <span class="so-panel-text--sm" role="note">İptal istendi; çalışan sunucular bırakılınca tarama durur. Biten sunucular kanıt olarak kalır.</span>
                }
                @if (job.Permissions.Retry)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryAsync"
                               aria-disabled="@(Busy ? "true" : "false")">@($"Bilgi alınamayan {job.Counts.Retryable} sunucuyu yeniden dene")</MudButton>
                }
                @if (job.RetryOfJobId is { } previous)
                {
                    <MudLink Href="@($"service-accounts/usage-scan-jobs/{previous}")">Önceki tarama</MudLink>
                }
            </div>
            @if (job.FailureText is { } failure)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" role="alert">@failure</MudAlert>
            }
        </section>

        @if (job.Summary is { } summary)
        {
            <section class="so-panel sa-wscan-summary" aria-labelledby="sa-wscan-summary-title">
                <h2 id="sa-wscan-summary-title" class="so-panel-title">Özet</h2>
                <p class="so-panel-text sa-wscan-summary-text">@summary</p>
                <ul class="sa-wscan-links">
                    @foreach (UsageScanJobAccountView account in job.Accounts)
                    {
                        <li>
                            <MudLink Href="@($"service-accounts/{account.AccountId}")">@account.SearchedName</MudLink>:
                            <span>@(account.LinkText ?? "Bağlantı sonucu yok")</span>
                        </li>
                    }
                </ul>
                <p class="so-panel-text--sm">Tarama görmediği yerleri söylemez: COM+ kimlikleri, kullanıcı hakları, uygulama veya bağlantı dizesi içindeki kimlikler, veritabanı oturumları, paylaşım izinleri, Linux/Oracle sunucuları.</p>
            </section>
        }

        <section class="so-panel" aria-labelledby="sa-wscan-servers-title">
            <div class="so-panel-head">
                <h2 id="sa-wscan-servers-title" class="so-panel-title">Sunucular (@job.Counts.Planned)</h2>
            </div>
            <ul class="sa-wscan-tiles" aria-label="Planlanan sunucular ve durumları">
                @foreach (UsageScanJobServerView server in job.Servers)
                {
                    <li @key="server.Ordinal" class="@($"sa-wscan-tile {UsageScanJobPresentation.TileClass(server.Tile)}")"
                        title="@UsageScanJobPresentation.TileAccessibleText(server)">
                        <MudIcon Icon="@UsageScanJobPresentation.TileIcon(server.Tile)" Size="Size.Small" Class="sa-wscan-tile-icon" aria-hidden="true" />
                        <span class="sa-wscan-tile-name">@server.ServerName</span>
                        <span class="sa-wscan-tile-text">@server.TileText</span>
                    </li>
                }
            </ul>
        </section>

        <section class="so-panel" aria-labelledby="sa-wscan-items-title">
            <div class="so-panel-head">
                <h2 id="sa-wscan-items-title" class="so-panel-title">Bulunan kullanımlar (@_items.Count)</h2>
            </div>
            @if (_items.Count == 0)
            {
                <p class="so-panel-text--sm">@(active ? "Henüz bulunan kullanım yok; sunucular bittikçe buraya düşer." : "Bu taramada bulunan kullanım yok. Bulunamadı, kullanılmıyor demek değildir.")</p>
            }
            else
            {
                <MudTable Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" T="UsageScanJobItemView" Elevation="0" Class="sa-wscan-items">
                    <HeaderContent>
                        <MudTh>Sunucu</MudTh><MudTh>Bileşen</MudTh><MudTh>Ad</MudTh><MudTh>Hesap</MudTh><MudTh>Yapılandırılmış kimlik</MudTh><MudTh>Durum</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Sunucu" Class="@(context.Seq > _seenSeq ? "sa-wscan-item--new" : null)">@context.ServerName</MudTd>
                        <MudTd DataLabel="Bileşen">@context.ComponentLabel@(context.Role == "Expected" ? " (gMSA)" : string.Empty)</MudTd>
                        <MudTd DataLabel="Ad"><span class="sa-wscan-wrap">@context.ComponentName</span></MudTd>
                        <MudTd DataLabel="Hesap">@context.MatchedAccount</MudTd>
                        <MudTd DataLabel="Yapılandırılmış kimlik">@context.Identity</MudTd>
                        <MudTd DataLabel="Durum">@(context.State ?? "Bildirilmedi")</MudTd>
                    </RowTemplate>
                </MudTable>
                <p class="so-panel-text--sm">Bulunanlar kendiliğinden kullanım kaydı olmaz: tarama bitince hesabın Kullanım taraması bölümünden her birini kaydedin veya gerekçeyle ayırın.</p>
            }
        </section>
    }
</div>

@code {
    private UsageScanJobView? _job;
    private readonly List<UsageScanJobItemView> _items = [];
    private int _lastSeq;
    private int _seenSeq;
    private string? _announcement;
    private Guid _loadedId;
    private CancellationTokenSource? _poll;

    /// <summary>Scan id from the route.</summary>
    [Parameter] public Guid Id { get; set; }

    protected override string RequiredCapability => ServiceAccountCapabilities.View;

    private string? CommandFieldText => (Problem?.Code, Problem?.Fields.FirstOrDefault()) switch
    {
        ("ServiceAccountUsageScanAlreadyRunning", _) => "Bu hesaplardan biri için çalışan bir web taraması var; bitmesini bekleyin.",
        ("ServiceAccountUsageScanJobStateConflict", _) => "Tarama bu adım için uygun durumda değil (zaten bitmiş ya da hâlâ çalışıyor). Güncel durum gösteriliyor.",
        (_, "nothingToRetry") => "Yeniden denenecek sunucu yok: hepsi tam okundu.",
        (_, "cancel") => "Taramayı yalnız başlatan kişi veya modül yöneticisi iptal edebilir.",
        _ => null
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Guid.Empty && _loadedId != Id && Allowed)
        {
            await LoadAsync();
        }
    }

    protected override async Task LoadAsync()
    {
        StopPolling();
        _loadedId = Id;
        (_job, _lastSeq, _seenSeq, _announcement) = (null, 0, 0, null);
        _items.Clear();
        if (await RunSerializedAsync(ReadAsync))
        {
            StartPolling();
        }
    }

    private async Task ReadAsync(CancellationToken token)
    {
        UsageScanJobView view = await Api.GetAsync<UsageScanJobView>($"/usage-scan-jobs/{Id}?after={_lastSeq}", token);
        Adopt(view);
    }

    /// <summary>Takes the server's view as the truth and appends only the newly found items.</summary>
    private void Adopt(UsageScanJobView view)
    {
        UsageScanJobView? previous = _job?.Id == view.Id ? _job : null;
        _seenSeq = _lastSeq;
        int added = 0;
        foreach (UsageScanJobItemView item in view.NewItems.Where(i => i.Seq > _lastSeq))
        {
            _items.Add(item);
            added++;
        }

        _lastSeq = Math.Max(_lastSeq, view.LastSeq);
        _job = view;
        _announcement = UsageScanJobPresentation.Announcement(previous, view, previous is null ? 0 : added) ?? _announcement;
    }

    private void StartPolling()
    {
        if (_job is null || !UsageScanJobPresentation.IsActive(_job) && !MoreItems)
        {
            return;
        }

        _poll = CancellationTokenSource.CreateLinkedTokenSource(Token);
        CancellationToken token = _poll.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    await Task.Delay(UsageScanJobPresentation.PollInterval, token);
                    await InvokeAsync(async () =>
                    {
                        bool ok = await RunSerializedAsync(ReadAsync);
                        StateHasChanged();
                        if (!ok || _job is null || !UsageScanJobPresentation.IsActive(_job) && !MoreItems)
                        {
                            StopPolling();
                        }
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Page left or polling stopped.
            }
        }, token);
    }

    private bool MoreItems => _job?.MoreItems == true;

    private void StopPolling()
    {
        _poll?.Cancel();
        _poll?.Dispose();
        _poll = null;
    }

    private async Task CancelAsync()
    {
        if (Busy)
        {
            return;
        }

        await RunAsync(async token => Adopt(await Api.SendAsync<UsageScanJobView>(HttpMethod.Post, $"/usage-scan-jobs/{Id}/cancel", new { }, token)));
        if (_job is { } job && UsageScanJobPresentation.IsActive(job) && _poll is null)
        {
            StartPolling();
        }
    }

    private async Task RetryAsync()
    {
        if (Busy)
        {
            return;
        }

        UsageScanJobView? retry = null;
        if (await RunAsync(async token => retry = await Api.SendAsync<UsageScanJobView>(HttpMethod.Post, $"/usage-scan-jobs/{Id}/retry", new { }, token))
            && retry is not null)
        {
            Navigation.NavigateTo($"service-accounts/usage-scan-jobs/{retry.Id}");
        }
    }

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
