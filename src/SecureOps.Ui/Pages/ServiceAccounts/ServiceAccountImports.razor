@page "/service-accounts/imports"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts

<PageTitle>Servis hesabı içe aktarımı · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="İçe aktarım" Lead="Dosya önce önizlenir; siz onaylamadan hiçbir kayıt yazılmaz. Aynı dosya aynı dönem ve kapsam için ikinci kez aktarılmaz.">
        <Actions><SaModuleLinks Access="Access" Current="imports" /></Actions>
    </SoPageHeader>
    <SaPageGuide Title="@ServiceAccountGuides.Imports.Title" Purpose="@ServiceAccountGuides.Imports.Purpose" Steps="ServiceAccountGuides.Imports.Steps" Never="@ServiceAccountGuides.Imports.Never" StartOpen="@(_history.Count == 0)" />
    <SaProblem Problem="Problem" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="İçe aktarım yetkisi gerekli" Description="İçe aktarım ayrıca kurum düzeyinde kapsam gerektirir." /> }
    else if (_me is null && Busy) { <SoLoading Message="Veri kapsamınız kontrol ediliyor" /> }
    else if (_me is not null && !HasImportScope)
    {
        <SaScopeSetup Me="_me" Bootstrap="_bootstrap" Purpose="İçe aktarım" OnRecheck="LoadAsync" />
    }
    else if (_me is not null)
    {
        <ol class="so-steps sa-import-steps" aria-label="İçe aktarım adımları">
            @foreach ((int number, string title, string hint) in _steps)
            {
                bool done = number < Step || number == 3 && Step == 3;
                bool active = number == Step && !done;
                <li class="so-step @(done ? "so-step--done" : null) @(active ? "so-step--active" : null)" aria-current="@(active ? "step" : null)">
                    <span class="so-step-marker" aria-hidden="true">@if (done) { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /> } else { @number }</span>
                    <span class="sa-step-text"><span class="so-step-label">@title</span><span class="sa-step-hint">@hint</span></span>
                    <span class="sr-only">@(done ? "tamamlandı" : active ? "şu anki adım" : "sonraki adım")</span>
                </li>
            }
        </ol>

        @if (_batch is null)
        {
            <SaImportGuide Selected="@_form.Profile" History="_history" OnChoose="ChooseProfile" />

            <section class="so-panel" aria-labelledby="sa-import-source">
                <h2 id="sa-import-source" class="so-panel-title">Dosya ve kaynak bilgisi</h2>
                <p class="so-panel-text--sm">Kapsamınız: <strong>@ScopeLabel(_me)</strong>. Zorunlu alanlar <span class="sa-required">*</span> ile işaretlidir.</p>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="string" Value="_form.Profile" ValueChanged="ChooseProfile" Label="Dosya türü *" Variant="Variant.Outlined">
                            @foreach ((string value, string label) in _profiles) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                        </MudSelect>
                        <p class="so-panel-text--sm mt-1">@ProfileHelp(_form.Profile)</p>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <div class="sa-file-picker @(_file is null ? null : "sa-file-picker--chosen")">
                            <MudIcon Icon="@(_file is null ? Icons.Material.Filled.UploadFile : Icons.Material.Filled.CheckCircle)" aria-hidden="true" />
                            <div class="sa-file-picker-text">
                                <label for="sa-import-file" class="sa-file-picker-label">@(_file is { } chosen ? chosen.Name : "Dosya seçin *")</label>
                                <span class="so-panel-text--sm">@(_file is { } f ? $"{f.Content.Length / 1024.0:0.#} KB · başka dosya için tekrar seçin" : $"{Accept(_form.Profile)} · en çok 20 MB")</span>
                            </div>
                            <InputFile id="sa-import-file" class="sa-file-input" OnChange="ChooseAsync" accept="@Accept(_form.Profile)" />
                        </div>
                    </MudItem>

                    <MudItem xs="12">
                        <fieldset class="sa-date-block @(MissingProvenance && _file is not null ? "sa-date-block--needed" : null)">
                            <legend class="so-panel-title">Rapor tarihi ve tarihin kaynağı <span class="sa-required">*</span></legend>
                            <p class="so-panel-text--sm">Neden soruluyor: bir hesabın son parola/oturum bilgisi bu tarihe göre sıralanır. Yükleme günü kullanılmaz; eski bir liste yanlış tarihle yüklenirse eski bilgi yeniymiş gibi görünür. Tarihi bilmiyorsanız boş bırakıp "Tarih bilinmiyor"u seçin.</p>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4">
                                    <MudDatePicker Editable="true" @bind-Date="_form.ReportDate" Label="Kaynak rapor tarihi" DateFormat="dd.MM.yyyy" Clearable="true" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" md="8">
                                    <div class="so-panel-text--sm mb-1">Bu tarihi nereden biliyorsunuz? Birini seçin:</div>
                                    <div class="sa-provenance" role="radiogroup" aria-label="Tarih kaynağı">
                                        @foreach ((string preset, string why) in _provenances)
                                        {
                                            bool on = _form.Provenance == preset;
                                            <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" title="@why"
                                                    class="sa-provenance-option @(on ? "sa-provenance-option--on" : null)" @onclick="@(() => _form.Provenance = preset)">
                                                @if (on) { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /> }
                                                @preset
                                            </button>
                                        }
                                    </div>
                                    <MudTextField T="string" @bind-Value="_form.Provenance" Label="veya kendiniz yazın" MaxLength="400" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                                </MudItem>
                            </MudGrid>
                        </fieldset>
                    </MudItem>

                    @if (CoverageSupported)
                    {
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" @bind-Value="_form.Coverage" Label="Liste kapsamı" Variant="Variant.Outlined">
                                @foreach ((string value, string label) in _coverages) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                            </MudSelect>
                            <p class="so-panel-text--sm mt-1">Emin değilseniz "Bilinmiyor" bırakın; hiçbir hesap etkilenmez. "Tam liste" yalnız dosya seçtiğiniz kurumların bütün hesaplarını içeriyorsa seçilir: o zaman listede olmayan hesaplar "bu listede yok" gözlemi alır (silinmez, kapanmaz).</p>
                        </MudItem>
                        @if (_form.Coverage == ServiceAccountImportCoverage.Complete)
                        {
                            <MudItem xs="12" md="6">
                                <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_form.CoverageOrganizations" Label="Tam listesi olan kurumlar *"
                                           Variant="Variant.Outlined" ToStringFunc="@(id => _organizations.FirstOrDefault(o => o.Id == id)?.Name ?? string.Empty)">
                                    @foreach (OrganizationView org in _organizations) { <MudSelectItem T="Guid" Value="@org.Id">@org.Name</MudSelectItem> }
                                </MudSelect>
                                <p class="so-panel-text--sm mt-1">Alt kurumlar dahildir. Varsayılan domain girilirse kapsam o domain ile sınırlanır. Tam liste için kaynak rapor tarihi gerekir.</p>
                            </MudItem>
                        }
                    }
                </MudGrid>

                <SaDisclosure Class="mt-3" Title="Ek seçenekler (genelde gerekmez)">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_form.DeclaredScope" Label="Dosyanın kapsamı (ör. kurum adı)" HelperText="Yalnız kayıt notu; yetki vermez." MaxLength="200" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_form.DeclaredDomain" Label="Varsayılan domain" HelperText="Dosyada domain sütunu yoksa hesaplara uygulanır." MaxLength="128" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_form.Sheet" Label="Sayfa adı" HelperText="Boşsa doğru sayfa otomatik bulunur." MaxLength="64" Variant="Variant.Outlined" /></MudItem>
                        @if (_form.Profile == ServiceAccountImportProfiles.DbaHandover)
                        {
                            <MudItem xs="12" md="6"><MudTextField @bind-Value="_form.TargetTeam" Label="Devrin hedef ekibi" HelperText="Boşsa devir kaydı oluşmaz, yalnız gözlem alınır." MaxLength="200" Variant="Variant.Outlined" /></MudItem>
                        }
                    </MudGrid>
                </SaDisclosure>

                @if (_fileError is not null) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" role="alert">@_fileError</MudAlert> }
                <div class="sa-stage-bar">
                    <MudButton OnClick="StageAsync" Disabled="@(Busy || Missing.Count > 0)" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Preview">Önizleme oluştur</MudButton>
                    @if (Missing.Count > 0)
                    {
                        <div class="sa-missing" role="status">
                            <span class="so-panel-text--sm">Önizleme için eksik:</span>
                            <ul>@foreach (string m in Missing) { <li>@m</li> }</ul>
                        </div>
                    }
                    else
                    {
                        <span class="so-panel-text--sm" role="status">Hazır. Önizleme kayıt yazmaz; sonucu görüp sonra onaylarsınız.</span>
                    }
                </div>
                <div class="sa-progress-slot" aria-live="polite">
                    @if (Busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /><span class="so-panel-text--sm">Dosya güvenli okuyucuyla inceleniyor…</span> }
                </div>
            </section>

            <section class="so-panel" aria-labelledby="sa-import-history">
                <h2 id="sa-import-history" class="so-panel-title">Aktarım geçmişi</h2>
                @if (_history.Count == 0) { <SoEmptyState Title="Aktarım yok" /> }
                else
                {
                    <MudTable Items="_history" Dense="true" Breakpoint="Breakpoint.Sm" T="ImportHistoryItem">
                        <HeaderContent><MudTh>Dosya</MudTh><MudTh>Tür</MudTh><MudTh>Rapor tarihi</MudTh><MudTh>Durum</MudTh><MudTh>Satır</MudTh><MudTh>Aç</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Dosya">@context.FileName<div class="so-panel-text--sm">@ServiceAccountUiText.Instant(context.UploadedAt)</div></MudTd>
                            <MudTd DataLabel="Tür">@ProfileLabel(context.Profile)</MudTd>
                            <MudTd DataLabel="Rapor tarihi">@ServiceAccountUiText.Date(context.SourceReportDate)</MudTd>
                            <MudTd DataLabel="Durum">@BatchStatus(context.Status)</MudTd>
                            <MudTd DataLabel="Satır">@context.TotalRows</MudTd>
                            <MudTd DataLabel="Aç"><MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="Busy" OnClick="@(() => OpenAsync(context.Id))">Aç</MudButton></MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </section>
        }
        else
        {
            ImportBatchView b = _batch;
            <section class="so-panel" aria-labelledby="sa-import-summary">
                <div class="so-panel-head">
                    <h2 id="sa-import-summary" class="so-panel-title">@b.FileName</h2>
                    <SoStatusBadge Label="@BatchStatus(b.Status)" Tone="@(b.Status == "Committed" ? SoStatusBadge.BadgeTone.Positive : SoStatusBadge.BadgeTone.Info)" />
                    @if (b.Replay) { <SoStatusBadge Label="Daha önce aktarılmış dosya" Tone="SoStatusBadge.BadgeTone.Caution" Icon="@Icons.Material.Filled.History" /> }
                </div>
                <SoFieldGrid>
                    <SoField Label="Tür" Value="@ProfileLabel(b.Profile)" />
                    <SoField Label="Kaynak rapor tarihi" Value="@ServiceAccountUiText.Date(b.SourceReportDate)" />
                    <SoField Label="Tarih kaynağı" Value="@b.SourceDateProvenance" />
                    <SoField Label="Kapsam / domain" Value="@($"{b.DeclaredScope ?? "belirtilmedi"} / {b.DeclaredDomain ?? "belirtilmedi"}")" />
                    <SoField Label="Liste kapsamı" Value="@(b.Coverage == ServiceAccountImportCoverage.Complete ? $"{CoverageLabel(b.Coverage)}: {CoverageOrganizationNames(b.CoverageOrganizationIds)}" : CoverageLabel(b.Coverage))" />
                    <SoField Label="SHA-256" Value="@b.Sha256[..16]" />
                    <SoField Label="Önizleme / karar sürümü" Value="@($"{b.PreviewVersion} / {b.DecisionVersion}")" />
                </SoFieldGrid>
                @if (b.Summary is { } s)
                {
                    <div class="d-flex flex-wrap gap-2 mt-2" role="list" aria-label="Sınıflandırma özeti">
                        <SoMetric Label="Toplam satır" Value="@s.TotalRows.ToString()" />
                        <SoMetric Label="Yeni" Value="@s.New.ToString()" />
                        <SoMetric Label="Gözlem güncellemesi" Value="@s.ObservationUpdates.ToString()" />
                        <SoMetric Label="Güncelleme" Value="@s.Updates.ToString()" />
                        <SoMetric Label="Aynı" Value="@s.Same.ToString()" />
                        <SoMetric Label="Çakışma" Value="@s.Conflicts.ToString()" />
                        <SoMetric Label="Geçersiz" Value="@s.Invalid.ToString()" />
                        <SoMetric Label="Bu listede yok" Value="@s.NotSeen.ToString()" />
                        <SoMetric Label="Kapsam dışı" Value="@s.OutOfScope.ToString()" />
                        <SoMetric Label="Karar gereken / verilen" Value="@($"{s.DecisionsRequired} / {s.DecisionsMade}")" />
                    </div>
                    @if (s.CoverageOutsideRows > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" role="alert">Beyan edilen kapsam dışında @s.CoverageOutsideRows satır var. Tam liste beyanı doğrulanamadığı için hiçbir hesap için "bu listede yok" çıkarımı yapılmadı.</MudAlert>
                    }
                    else if (s.Coverage == ServiceAccountImportCoverage.Complete)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Tam liste: beyan edilen kapsamda @s.CoveragePopulation hesap var; listede olmayan @s.NotSeen hesap "bu listede yok" gözlemi alacak. Bu bir gözlemdir; hesap kapanmaz.</MudAlert>
                    }
                    else if (b.Profile is ServiceAccountImportProfiles.CoordinationList or ServiceAccountImportProfiles.LegacyPackage or ServiceAccountImportProfiles.LegacyWorkbook)
                    {
                        <p class="so-panel-text--sm mt-1">Liste kapsamı tam değil (@CoverageLabel(s.Coverage).ToLowerInvariant()); listede olmayan hesaplar için "bu listede yok" çıkarımı yapılmadı.</p>
                    }
                    @if (s.NewTeamLabels.Count + s.NewOrganizationLabels.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Yeni oluşturulacak ekip/kurum etiketleri (yetki vermez): @string.Join(", ", s.NewOrganizationLabels.Concat(s.NewTeamLabels))</MudAlert>
                    }
                    @if (s.FormulaCells + s.IgnoredHelperColumns > 0)
                    {
                        <p class="so-panel-text--sm mt-1">@s.FormulaCells formül hücresi yalnız değer olarak okundu; @s.IgnoredHelperColumns yardımcı sütun yok sayıldı.</p>
                    }
                }
                @if (b.Warnings.Count > 0)
                {
                    <SaDisclosure Class="mt-2" Title="@($"Uyarılar ({b.Warnings.Count})")">
                        <ul>@foreach (string w in b.Warnings.Take(200)) { <li class="so-panel-text--sm">@w</li> }</ul>
                    </SaDisclosure>
                }
                <SaDisclosure Class="mt-2" Title="@($"Sütun eşlemesi ({b.Mapping.Count})")">
                    <SaImportMapping Mapping="b.Mapping" Editable="@(b.Profile == ServiceAccountImportProfiles.Generic && b.Status != "Committed" && _file is not null)"
                                     Busy="Busy" OnRestage="RestageAsync" />
                </SaDisclosure>
            </section>

            @if (b.Result is { } r)
            {
                <SaImportResult Result="r" />
            }
            else
            {
                <SaImportRows Batch="b" Busy="Busy" Page="_rows" CanConfirmOwnership="@Can(ServiceAccountCapabilities.Assign)"
                              OnQuery="QueryRowsAsync" OnDecide="DecideAsync" />

                <section class="so-panel" aria-labelledby="sa-import-commit">
                    <h2 id="sa-import-commit" class="so-panel-title">Onay</h2>
                    <p class="so-panel-text">Onay, önizlemede görülen sonucu tek işlemde yazar. Veri bu arada değiştiyse hiçbir şey yazılmaz ve önizlemeyi yenilemeniz istenir.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton OnClick="RefreshAsync" Disabled="Busy" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh">Önizlemeyi yenile</MudButton>
                        <MudButton OnClick="CommitAsync" Disabled="@(Busy || b.Summary is { } pending && pending.DecisionsRequired > pending.DecisionsMade)" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Done">Aktarımı onayla</MudButton>
                    </div>
                </section>
            }
            <MudButton OnClick="ResetAsync" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-2">Yeni aktarım / geçmiş</MudButton>
        }
    }
</div>
