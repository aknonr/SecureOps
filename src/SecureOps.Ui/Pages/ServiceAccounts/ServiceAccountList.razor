@page "/service-accounts"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Auth
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts
@inject NavigationManager Navigation

<PageTitle>Servis Hesapları · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="Servis Hesapları" Lead="@(_me is null ? null : "Kapsamınız: " + ScopeLabel(_me))">
        <Actions>
            <div data-tour="sa-module-links"><SaModuleLinks Access="Access" Current="list" /></div>
        </Actions>
    </SoPageHeader>
    <SaPageGuide Title="@ServiceAccountGuides.List.Title" Purpose="@ServiceAccountGuides.List.Purpose" Steps="ServiceAccountGuides.List.Steps" Never="@ServiceAccountGuides.List.Never"
                 Tour="@ServiceAccountTours.List(Can(ServiceAccountCapabilities.Work), Can(ServiceAccountCapabilities.Assign), Can(Capabilities.IdentityLookup))" TourId="sa-list-tour" />
    <SaProblem Problem="Problem" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (Access is { IsResolved: false })
    {
        <SaProblem Problem="Access.Problem" OnRetry="RefreshPageAccessAsync" />
    }
    else if (!Allowed) { <SoEmptyState Title="Servis hesaplarını görüntüleme yetkisi gerekli" Description="Yetki ve kurum/ekip kapsamı modül yöneticisi tarafından verilir." /> }
    else if (_me is null && Busy) { <SoLoading Message="Veri kapsamınız kontrol ediliyor" /> }
    else if (_me is { HasScope: false })
    {
        <SaScopeSetup Me="_me" Bootstrap="_bootstrap" Purpose="Servis hesaplarını görmek" OrganizationRequired="false" OnRecheck="LoadAsync" />
    }
    else if (_me is not null)
    {
        @if (_summary is not null) { <div data-tour="sa-work-summary"><SaWorkSummary Summary="_summary" /></div> }
        @if (Can(Capabilities.IdentityLookup))
        {
            <div data-tour="sa-directory-search"><SaDirectoryNameSearch Result="_directory" Problem="_directoryProblem" SearchedQuery="_directoryQuery" Busy="Busy" OnSearch="DirectorySearchAsync" /></div>
        }
        <section class="so-panel" aria-label="Filtreler" data-tour="sa-filters">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField T="string" @bind-Value="_search" Label="Hesap adı" HelperText="Kayıtlı servis hesaplarının adında geçen metin; SID ve dizin aranmaz." MaxLength="200" Variant="Variant.Outlined" Immediate="true"
                                  OnKeyDown="SearchOnEnterAsync" aria-label="Hesap ara" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="string" @bind-Value="_status" Label="Durum" Variant="Variant.Outlined">
                        @foreach ((string value, string label) in _statuses) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="Guid?" @bind-Value="_organization" Label="Rapor kurumu" Variant="Variant.Outlined" Clearable="true">
                        @foreach (OrganizationView org in _organizations) { <MudSelectItem T="Guid?" Value="@((Guid?)org.Id)">@org.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="Guid?" @bind-Value="_team" Label="Ekip" Variant="Variant.Outlined" Clearable="true">
                        @foreach (TeamView team in _teams) { <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudTextField T="string" @bind-Value="_domain" Label="Domain" MaxLength="100" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudDatePicker Editable="true" @bind-Date="_dueBefore" Label="Vade (en geç)" DateFormat="dd.MM.yyyy" Clearable="true" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="string" @bind-Value="_sort" Label="Sıralama" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("name")">Hesap adı</MudSelectItem>
                        <MudSelectItem T="string" Value="@("due")">En yakın vade</MudSelectItem>
                        <MudSelectItem T="string" Value="@("open")">Açık iş sayısı</MudSelectItem>
                        <MudSelectItem T="string" Value="@("owner")">Sahip ekip</MudSelectItem>
                        <MudSelectItem T="string" Value="@("observed")">Son görülme</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="_descending" Label="Azalan" Color="Color.Primary" />
                </MudItem>
                @if (Can(ServiceAccountCapabilities.Work))
                {
                    <MudItem xs="12" md="4">
                        <SaPersonPicker Label="Kişi (sahip ya da açık işin takipçisi)" Value="_person" ValueChanged="PersonChanged" Selected="PersonSelected" />
                    </MudItem>
                }
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="_myTeam" Label="Yalnız ekibimin işleri (sahip, hedef, takipçi veya devir)" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
            <p class="so-panel-text--sm mt-2">Süzgeçler (arama, durum, kurum, ekip, kişi, domain, vade, sıralama) siz <strong>Listele</strong>'ye basana veya arama kutusunda Enter'a basana kadar uygulanmaz; yukarıdaki özet düğmeleri ise kendi süzgeciyle listeyi hemen açar.</p>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <MudButton OnClick="SearchAsync" Disabled="Busy" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search">Listele</MudButton>
                <MudButton OnClick="ResetAsync" Disabled="Busy" Variant="Variant.Text">Süzgeçleri temizle</MudButton>
                @if (Can(ServiceAccountCapabilities.Report))
                {
                    <MudButton OnClick="ExportAsync" Disabled="Busy" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableView">Listeyi Excel'e aktar</MudButton>
                    <span class="so-panel-text--sm align-self-center">Aynı filtre ve kapsam; en çok 5.000 satır; aktarım kaydedilir.</span>
                }
            </div>
        </section>

        @if (Can(ServiceAccountCapabilities.Assign))
        {
            <div data-tour="sa-create"><SaDisclosure Class="mb-3" Title="Yeni servis hesabı kaydı">
                <SaCreateAccountForm Organizations="_organizations" Busy="Busy" OnSubmit="CreateAsync" />
            </SaDisclosure></div>
        }

        @if (Busy && _page is null) { <SoLoading Message="Hesaplar okunuyor" Variant="SoLoading.LoadingVariant.Block" /> }
        @if (_page is not null)
        {
            <p role="status" class="so-panel-text">@_page.Total hesap · sayfa @_page.Page / @Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_page.PageSize))</p>
            <p class="so-panel-text--sm" data-testid="sa-list-scope-note">@CountExplanation</p>
            @if (ActiveChips.Count > 0)
            {
                <div role="group" aria-label="Etkin süzgeçler" class="sa-chips" data-testid="sa-active-filters">
                    <span class="so-panel-text--sm">Etkin süzgeçler:</span>
                    @foreach ((string key, string text) in ActiveChips)
                    {
                        <button type="button" class="sa-chip" aria-label="@($"Süzgeci kaldır: {text}")" disabled="@Busy" @onclick="@(() => RemoveChipAsync(key))">
                            <span>@text</span><MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true" />
                        </button>
                    }
                </div>
            }
            @if (_page.Items.Count == 0)
            {
                <SoEmptyState Title="Bu filtrelerle eşleşen hesap yok" Description="Filtreleri gevşetin veya kapsamınızı kontrol edin." />
            }
            else
            {
                @if (Can(ServiceAccountCapabilities.Work) && _selected.Count > 0)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-2">
                        @_selected.Count hesap seçildi.
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _mailOpen = !_mailOpen)"
                            aria-expanded="@(_mailOpen ? "true" : "false")">Tek e-posta kaydını bu hesaplara bağla</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _scanOpen = !_scanOpen)"
                            aria-expanded="@(_scanOpen ? "true" : "false")">Tek tarama dosyasını bu hesaplara bağla</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _webScanOpen = !_webScanOpen)"
                            aria-expanded="@(_webScanOpen ? "true" : "false")">Bu hesapları webden tara</MudButton>
                        <MudButton Size="Size.Small" OnClick="ClearSelection">Seçimi temizle</MudButton>
                    </MudAlert>
                    @if (_mailOpen)
                    {
                        <section class="so-panel" aria-label="Çoklu hesap e-posta kaydı">
                            <SaCommunicationForm AccountIds="@_selected.Keys.ToList()" AccountLabels="@_selected.Values.ToList()" Teams="_teams" Busy="Busy" OnSubmit="SaveMailAsync" />
                        </section>
                    }
                }
                @if (Can(ServiceAccountCapabilities.Work) && _webScanOpen && _selected.Count > 0)
                {
                    <SaWebScanPanel AccountIds="@_selected.Keys.ToList()" AccountLabels="@_selected.Values.ToList()" CanWork="true"
                        IdPrefix="sa-list-wscan" />
                }
                @if (Can(ServiceAccountCapabilities.Work) && (_scanOpen && _selected.Count > 0 || _scanResult is not null || _scanProblem is not null))
                {
                    <SaUsageScanBatchForm AccountIds="@_selected.Keys.ToList()" AccountLabels="@_selected.Values.ToList()" Busy="Busy" Result="_scanResult"
                        Problem="_scanProblem" OnUpload="UploadScanAsync" />
                }
                <div data-tour="sa-results">
                <MudTable Items="_page.Items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" T="AccountListItem">
                    <HeaderContent>
                        @if (Can(ServiceAccountCapabilities.Work)) { <MudTh data-tour="sa-select">Seç</MudTh> }
                        <MudTh>Hesap</MudTh><MudTh>Rapor kurumu</MudTh><MudTh>Sahiplik</MudTh><MudTh>Açık iş</MudTh><MudTh>Durum</MudTh><MudTh>Son kaynak</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @if (Can(ServiceAccountCapabilities.Work))
                        {
                            <MudTd DataLabel="Seç">
                                <MudCheckBox T="bool" Value="@_selected.ContainsKey(context.Id)" ValueChanged="@(v => Toggle(context, v))"
                                             aria-label="@($"{context.AccountName} hesabını seç")" />
                            </MudTd>
                        }
                        <MudTd DataLabel="Hesap">
                            <MudLink Href="@($"service-accounts/{context.Id}")">@context.AccountName</MudLink>
                            <div class="so-panel-text--sm">@(context.Domain ?? "Domain bilinmiyor")@(context.IdentityState == "Provisional" ? " · kimlik geçici" : "")</div>
                        </MudTd>
                        <MudTd DataLabel="Rapor kurumu">@(context.ReportOrganization?.Label ?? "Atanmadı")</MudTd>
                        <MudTd DataLabel="Sahiplik">
                            <div>@(context.OwnerTeam?.Label ?? "Sahip ekip yok")</div>
                            <div class="so-panel-text--sm">
                                @if (context.OwnerPerson is not null) { @context.OwnerPerson.Label }
                                else if (context.FollowupPerson is not null) { @($"{context.FollowupPerson.Label} — takipçi, sahip değil") }
                                else { <span>Sorumlu kişi yok</span> }
                            </div>
                            @if (context.OwnershipProposed) { <SoStatusBadge Label="Sahiplik önerisi bekliyor" Tone="SoStatusBadge.BadgeTone.Caution" Icon="@Icons.Material.Filled.HourglassTop" /> }
                        </MudTd>
                        <MudTd DataLabel="Açık iş">
                            @context.OpenRequests
                            @if (context.NearestDue is { } due) { <div class="so-panel-text--sm">En yakın: @due.ToString("dd.MM.yyyy")</div> }
                        </MudTd>
                        <MudTd DataLabel="Durum"><SoStatusBadge Label="@context.Status" Tone="@Tone(context.Status)" Icon="@StatusIcon(context.Status)" /></MudTd>
                        <MudTd DataLabel="Son kaynak">
                            @(context.LastObservedOn?.ToString("dd.MM.yyyy") ?? "Kaynakta görülmedi")
                            @if (context.LastPresence == "NotPresent") { <div class="so-panel-text--sm">Son listede yok</div> }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                </div>
                <SaPager Label="Hesaplar" Page="_pageNumber" PageSize="PageSize" Total="_page.Total" Unit="hesap" Busy="Busy" AlwaysVisible="true" OnPage="GoToPageAsync" />
            }
        }
    }
</div>

@code {
    private async Task RefreshPageAccessAsync() => await AccessProvider.RefreshAsync(Token);

    private const int PageSize = 25;
    private static readonly (string Value, string Label)[] _statuses =
    [
        ("", "Tümü"), ("open", "Açık işi olan"), ("overdue", "Geciken iş"), ("awaiting", "Tarih bekleyen"), ("none", "Açık işi yok"),
        ("closed", "Kapanışı doğrulanan"), ("unowned", "Sahip ekibi yok"), ("proposed", "Sahiplik önerisi bekleyen"), ("notseen", "Son listede görünmeyen")
    ];

    [SupplyParameterFromQuery(Name = "myTeam")] public bool MyTeamQuery { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusQuery { get; set; }
    [SupplyParameterFromQuery(Name = "search")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "domain")] public string? DomainQuery { get; set; }
    [SupplyParameterFromQuery(Name = "organizationId")] public string? OrganizationQuery { get; set; }
    [SupplyParameterFromQuery(Name = "teamId")] public string? TeamQuery { get; set; }
    [SupplyParameterFromQuery(Name = "personId")] public string? PersonQuery { get; set; }
    [SupplyParameterFromQuery(Name = "dueBefore")] public string? DueBeforeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "descending")] public bool DescendingQuery { get; set; }

    /// <summary>Every list filter in one value: what the URL carries and what the chips show.</summary>
    private sealed record ListFilters(string? Status, bool MyTeam, string? Search, string? Domain, Guid? Organization, Guid? Team, Guid? Person, DateOnly? DueBefore, string Sort, bool Descending);

    private static readonly string[] _sorts = ["name", "due", "open", "owner", "observed"];

    private DirectoryNameSearchResponse? _directory;

    private UiProblem? _directoryProblem;
    private string? _directoryQuery;

    /// <summary>
    /// A new search first drops the previous answer (a stale table must not sit beside a new failure); a failure is shown inside the
    /// search panel as "unknown", never as "no match". Session and access problems stay page-level.
    /// </summary>
    private async Task DirectorySearchAsync(string query)
    {
        (_directory, _directoryProblem, _directoryQuery) = (null, null, query);
        UiProblem? before = Problem;
        if (!await RunAsync(async token =>
                _directory = await Api.SendAsync<DirectoryNameSearchResponse>(HttpMethod.Post, "/directory/name-search", new DirectoryNameSearchRequest(query), token))
            && Problem is { } problem && !ReferenceEquals(problem, before) && !AccessRejected)
        {
            (_directoryProblem, Problem) = (problem, null);
        }
    }

    private ServiceAccountMe? _me;
    private ScopeBootstrapState? _bootstrap;
    private AccountPage? _page;
    private IReadOnlyList<OrganizationView> _organizations = [];
    private IReadOnlyList<TeamView> _teams = [];
    private readonly Dictionary<Guid, string> _selected = [];
    private ServiceAccountWorkSummary? _summary;
    private string _search = "", _status = "", _domain = "", _sort = "name";
    private Guid? _organization, _team, _person;
    private string? _personName;
    private DateTime? _dueBefore;
    private bool _descending, _myTeam, _mailOpen, _scanOpen, _webScanOpen, _fetchPending, _fetching;
    private UsageScanBatchResult? _scanResult;
    private UiProblem? _scanProblem;
    private int _pageNumber = 1;

    protected override string RequiredCapability => ServiceAccountCapabilities.View;

    private ListFilters? _appliedQuery;
    private ListFilters? _applied;
    private bool _queryChanged;

    /// <summary>
    /// The shortcut links (summary cards, "Ekibimin işleri") navigate to this same page with a new query string, which Blazor
    /// answers with a parameter update, not a new component. The filters are therefore re-applied and the list re-read here
    /// whenever the query string changed; the first load is done by <see cref="LoadAsync"/>.
    /// </summary>
    protected override void OnParametersSet()
    {
        ListFilters query = new(_statuses.Any(x => x.Value == StatusQuery) ? StatusQuery : null, MyTeamQuery, Clean(SearchQuery), Clean(DomainQuery),
            ParseId(OrganizationQuery), ParseId(TeamQuery), ParseId(PersonQuery), DateOnly.TryParse(DueBeforeQuery, out DateOnly due) ? due : null,
            _sorts.Contains(SortQuery) ? SortQuery! : "name", DescendingQuery);
        if (_appliedQuery != query)
        {
            // The URL is the filter state: a shortcut or a shared link means exactly its own filters, so every other filter is cleared too.
            _queryChanged = _appliedQuery is not null;
            Adopt(query);
        }

        _appliedQuery = query;
    }

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static Guid? ParseId(string? value) => Guid.TryParse(value, out Guid id) ? id : null;

    private void Adopt(ListFilters f)
    {
        (_status, _myTeam, _search, _domain) = (f.Status ?? "", f.MyTeam, f.Search ?? "", f.Domain ?? "");
        (_organization, _team, _person, _dueBefore, _sort, _descending) = (f.Organization, f.Team, f.Person, f.DueBefore?.ToDateTime(TimeOnly.MinValue), f.Sort, f.Descending);
        _personName = null;
    }

    private ListFilters Draft() => new(Clean(_status), _myTeam, Clean(_search), Clean(_domain), _organization, _team, _person,
        _dueBefore is { } d ? DateOnly.FromDateTime(d) : null, _sort, _descending);

    /// <summary>Writes the applied filters into the address (no re-read: the page already holds exactly this state).</summary>
    private void SyncUrl()
    {
        ListFilters f = Draft();
        _appliedQuery = f;
        string uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["status"] = f.Status, ["myTeam"] = f.MyTeam ? "true" : null, ["search"] = f.Search, ["domain"] = f.Domain,
            ["organizationId"] = f.Organization?.ToString(), ["teamId"] = f.Team?.ToString(), ["personId"] = f.Person?.ToString(),
            ["dueBefore"] = f.DueBefore?.ToString("yyyy-MM-dd"), ["sort"] = f.Sort == "name" ? null : f.Sort, ["descending"] = f.Descending ? "true" : null
        });
        if (uri != Navigation.Uri) { Navigation.NavigateTo(uri); }
    }

    private Task PersonChanged(Guid? id) { _person = id; if (id is null) { _personName = null; } return Task.CompletedTask; }
    private Task PersonSelected(PersonView? person) { _personName = person?.DisplayName; return Task.CompletedTask; }

    private string? PersonLabel(Guid id) => _personName is { Length: > 0 } && _person == id ? _personName
        : _page?.Items.SelectMany(i => new[] { i.OwnerPerson, i.FollowupPerson }).FirstOrDefault(p => p?.Id == id)?.Label;

    /// <summary>The filters the shown list was read with, one removable chip each; names come from data already loaded, never guessed.</summary>
    private List<(string Key, string Text)> ActiveChips
    {
        get
        {
            List<(string, string)> chips = [];
            if (_applied is not { } f) { return chips; }
            if (f.Search is not null) { chips.Add(("search", $"Hesap adı: {f.Search}")); }
            if (f.Status is not null) { chips.Add(("status", "Durum: " + _statuses.First(x => x.Value == f.Status).Label)); }
            if (f.Organization is { } org) { chips.Add(("organization", "Rapor kurumu: " + (_organizations.FirstOrDefault(o => o.Id == org)?.Name ?? "seçili kurum"))); }
            if (f.Team is { } team) { chips.Add(("team", "Ekip: " + (_teams.FirstOrDefault(t => t.Id == team)?.Name ?? "seçili ekip"))); }
            if (f.Person is { } person) { chips.Add(("person", "Kişi (sahip ya da açık işin takipçisi): " + (PersonLabel(person) ?? "seçili kişi (ad gösterilemiyor)"))); }
            if (f.Domain is not null) { chips.Add(("domain", $"Domain: {f.Domain}")); }
            if (f.DueBefore is { } due) { chips.Add(("due", "Vade en geç: " + due.ToString("dd.MM.yyyy"))); }
            if (f.MyTeam) { chips.Add(("myTeam", "Yalnız ekibimin işleri")); }
            return chips;
        }
    }

    private Task RemoveChipAsync(string key)
    {
        if (_applied is not { } f) { return Task.CompletedTask; }
        string? name = _personName;
        f = key switch
        {
            "search" => f with { Search = null }, "status" => f with { Status = null }, "organization" => f with { Organization = null },
            "team" => f with { Team = null }, "person" => f with { Person = null }, "domain" => f with { Domain = null },
            "due" => f with { DueBefore = null }, _ => f with { MyTeam = false }
        };
        Adopt(f);
        _personName = f.Person is null ? null : name;
        return SearchAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_queryChanged && _me is { HasScope: true })
        {
            _queryChanged = false;
            _pageNumber = 1;
            await FetchAsync();
        }
    }

    protected override async Task LoadAsync()
    {
        await RunSerializedAsync(async token =>
        {
            _me = await Api.GetAsync<ServiceAccountMe>("/me", token);
            if (!_me.HasScope)
            {
                // Without any scope the list is empty by design; explain how scope is granted instead of showing filters.
                _bootstrap = Can(ServiceAccountCapabilities.Administer) ? await Api.GetAsync<ScopeBootstrapState>("/scope-grants/bootstrap", token) : null;
                return;
            }

            _summary = await Api.GetAsync<ServiceAccountWorkSummary>("/work-summary", token);
            _organizations = await Api.GetAsync<IReadOnlyList<OrganizationView>>("/organizations", token);
            _teams = await Api.GetAsync<IReadOnlyList<TeamView>>("/teams", token);
        });
        _queryChanged = false;
        if (_me is { HasScope: true })
        {
            await FetchAsync();
        }
    }

    private Task SearchAsync() { _pageNumber = 1; SyncUrl(); return FetchAsync(); }
    private Task GoToPageAsync(int page) { _pageNumber = page; return FetchAsync(); }

    private async Task SearchOnEnterAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") { await SearchAsync(); }
    }

    private Task ResetAsync()
    {
        (_search, _status, _domain, _sort, _organization, _team, _person, _personName, _dueBefore, _descending, _myTeam) = ("", "", "", "name", null, null, null, null, null, false, false);
        return SearchAsync();
    }

    /// <summary>Searches are serialized and coalesced: one requested during a call runs after it, never dropped.</summary>
    private async Task FetchAsync()
    {
        _fetchPending = true;
        if (_fetching)
        {
            return;
        }

        _fetching = true;
        try
        {
            while (_fetchPending)
            {
                _fetchPending = false;
                await FetchOnceAsync();
            }
        }
        finally
        {
            _fetching = false;
        }
    }

    private string _appliedStatus = "";
    private bool _appliedMyTeam, _appliedExtra;

    /// <summary>Says what the total counts, so "all accounts in scope" and a filtered subset are never confused.</summary>
    private string CountExplanation
    {
        get
        {
            if (_page is null) { return ""; }
            if (_appliedStatus.Length == 0 && !_appliedMyTeam && !_appliedExtra)
            {
                return "Bu sayı kapsamınızdaki tüm servis hesaplarıdır; süzgeç uygulanmadı.";
            }

            string label = _statuses.FirstOrDefault(s => s.Value == _appliedStatus).Label ?? "";
            string text = "Bu sayı kapsamınızdaki hesaplardan uygulanan süzgece uyanlardır"
                + (label.Length > 0 ? $" (durum: {label})" : "") + (_appliedMyTeam ? "; yalnız ekibinizin işleri" : "")
                + (_appliedExtra ? "; arama, kurum, ekip, kişi, domain veya vade süzgeçleriyle" : "")
                + (_applied?.Person is not null ? "; kişi süzgeci hesabın sahibi ya da açık bir işin takipçisi olan kişiyi arar" : "") + ".";
            if (_appliedStatus == "proposed")
            {
                text += " Sahiplik önerisi bekleyen: önerilen sahip ekip/kişi henüz teyit edilmemiş hesaplar.";
                if (_summary is { Coordinator: true } summary && !_appliedMyTeam && !_appliedExtra)
                {
                    text += summary.ProposedOwnership == _page.Total ? " Özet kartıyla aynı sayıdır."
                        : $" Özet kartı {summary.ProposedOwnership} hesap gösteriyordu; sayfa açıldıktan sonra veri değişmiş olabilir, sayfayı yenileyin.";
                }
            }

            return text;
        }
    }

    private Task FetchOnceAsync() => RunSerializedAsync(async token =>
    {
        (string status, bool myTeam, bool extra) = (_status, _myTeam,
            !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_domain) || _organization is not null || _team is not null || _person is not null || _dueBefore is not null);
        _page = await Api.GetAsync<AccountPage>("/accounts?" + string.Join('&', ListQuery(_pageNumber)), token);
        (_appliedStatus, _appliedMyTeam, _appliedExtra, _applied) = (status, myTeam, extra, Draft());
    });

    /// <summary>Downloads the current filtered list (same filters, server-side scope) as XLSX.</summary>
    private Task ExportAsync() => RunAsync(async token => await SaveFileAsync(await Api.DownloadAsync("/accounts/export?" + string.Join('&', ListQuery(1)), token)));

    private List<string> ListQuery(int pageNumber)
    {
        List<string> query = [$"page={pageNumber}", $"pageSize={PageSize}", "sort=" + _sort, "descending=" + (_descending ? "true" : "false")];
        if (!string.IsNullOrWhiteSpace(_search)) { query.Add("search=" + Uri.EscapeDataString(_search.Trim())); }
        if (!string.IsNullOrEmpty(_status)) { query.Add("status=" + _status); }
        if (!string.IsNullOrWhiteSpace(_domain)) { query.Add("domain=" + Uri.EscapeDataString(_domain.Trim())); }
        if (_organization is { } org) { query.Add("organizationId=" + org); }
        if (_team is { } team) { query.Add("teamId=" + team); }
        if (_person is { } person) { query.Add("personId=" + person); }
        if (_dueBefore is { } due) { query.Add("dueBefore=" + due.ToString("yyyy-MM-dd")); }
        if (_myTeam) { query.Add("myTeam=true"); }
        return query;
    }

    private async Task CreateAsync(CreateAccountRequest request)
    {
        AccountDetail? created = null;
        if (await RunAsync(async token => created = await Api.SendAsync<AccountDetail>(HttpMethod.Post, "/accounts", request, token)) && created is not null)
        {
            Navigation.NavigateTo($"service-accounts/{created.Summary.Id}");
        }
    }

    private async Task SaveMailAsync(CreateCommunicationRequest request)
    {
        if (await RunAsync(token => Api.SendAsync<CommunicationSaveResult>(HttpMethod.Post, "/communications", request, token)))
        {
            _mailOpen = false;
            _selected.Clear();
            await FetchAsync();
        }
    }

    /// <summary>
    /// One scan file for the selected accounts; the API answers each account. The selection stays so a "Kaydedilemedi" row can be
    /// retried with the same file (already linked accounts then answer "Zaten bağlıydı"). A new upload first clears the previous
    /// answer; a failed upload is shown inside the form, whose retry repeats the upload (the page problem's retry reloads the
    /// list). Session and access problems stay page-level.
    /// </summary>
    private async Task UploadScanAsync(SaUsageScanBatchUpload upload)
    {
        (_scanResult, _scanProblem) = (null, null);
        UsageScanBatchResult? result = null;
        List<KeyValuePair<string, string?>> fields = [new("runStatement", upload.RunStatement), .. upload.AccountIds.Select(id =>
            new KeyValuePair<string, string?>("accountIds", id.ToString("D")))];
        if (await RunAsync(async token => result = await Api.UploadAsync<UsageScanBatchResult>("/usage-scans", upload.FileName, "application/json",
            upload.Content, fields, token)))
        {
            _scanResult = result;
        }
        else if (Problem is { } problem && !AccessRejected)
        {
            (_scanProblem, Problem) = (problem, null);
        }
    }

    private void ClearSelection()
    {
        _selected.Clear();
        (_mailOpen, _scanOpen, _webScanOpen, _scanResult, _scanProblem) = (false, false, false, null, null);
    }

    private void Toggle(AccountListItem item, bool selected)
    {
        if (selected) { _selected[item.Id] = item.AccountName; } else { _selected.Remove(item.Id); }
    }

    private static SoStatusBadge.BadgeTone Tone(string status) => status switch
    {
        "Geciken iş" => SoStatusBadge.BadgeTone.Critical,
        "Açık iş" => SoStatusBadge.BadgeTone.Info,
        "Kapanış doğrulandı" => SoStatusBadge.BadgeTone.Positive,
        _ => SoStatusBadge.BadgeTone.Neutral
    };

    private static string StatusIcon(string status) => status switch
    {
        "Geciken iş" => Icons.Material.Filled.Warning,
        "Açık iş" => Icons.Material.Filled.PendingActions,
        "Kapanış doğrulandı" => Icons.Material.Filled.Verified,
        _ => Icons.Material.Filled.RemoveCircleOutline
    };
}
