@page "/service-accounts/{Id:guid}"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts

<PageTitle>@(_detail?.Summary.AccountName ?? "Servis hesabı") · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="@(_detail?.Summary.AccountName ?? "Servis hesabı")" Lead="@Lead">
        <Actions>
            <MudButton Href="service-accounts" StartIcon="@Icons.Material.Filled.ArrowBack">Hesaplar</MudButton>
        </Actions>
    </SoPageHeader>
    <SaPageGuide Title="@ServiceAccountGuides.Detail.Title" Purpose="@ServiceAccountGuides.Detail.Purpose" Steps="ServiceAccountGuides.Detail.Steps" Never="@ServiceAccountGuides.Detail.Never" />
    <SaProblem Problem="Problem" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="Servis hesaplarını görüntüleme yetkisi gerekli" /> }
    else if (_me is { HasScope: false })
    {
        <SaScopeSetup Me="_me" Bootstrap="_bootstrap" Purpose="Servis hesaplarını görmek" OrganizationRequired="false" OnRecheck="LoadAsync" />
    }
    else if (_detail is null && Busy) { <SoLoading Message="Hesap okunuyor" Variant="SoLoading.LoadingVariant.Block" /> }
    else if (_detail is not null)
    {
        AccountSummaryView s = _detail.Summary;
        <section class="so-panel" aria-labelledby="sa-summary">
            <div class="so-panel-head"><h2 id="sa-summary" class="so-panel-title">Özet</h2>
                @if (s.LifecycleState == "ClosureVerified") { <SoStatusBadge Label="Kapanış doğrulandı" Tone="SoStatusBadge.BadgeTone.Positive" Icon="@Icons.Material.Filled.Verified" /> }
                @if (s.IdentityState == "Provisional") { <SoStatusBadge Label="Kimlik geçici (dizinden doğrulanmadı)" Tone="SoStatusBadge.BadgeTone.Caution" Icon="@Icons.Material.Filled.HelpOutline" /> }
            </div>
            <SoFieldGrid>
                <SoField Label="Rapor kurumu" Value="@(s.ReportOrganization?.Label ?? "Atanmadı")" />
                <SoField Label="Sahip ekip" Value="@(s.OwnerTeam?.Label ?? "Teyitli sahip ekip yok")" />
                <SoField Label="Sahip kişi" Value="@(s.OwnerPerson?.Label ?? "Teyitli sorumlu kişi yok")" />
                <SoField Label="Kullanan ekip" Value="@(s.ConsumerTeam?.Label ?? "Bilinmiyor")" />
                <SoField Label="Domain / SID" Value="@($"{s.Domain ?? "Domain bilinmiyor"} / {s.Sid ?? "SID bilinmiyor"}")" />
                <SoField Label="Son kaynakta görülme" Value="@(ServiceAccountUiText.Date(s.LastObservedOn, "Kaynakta görülmedi") + (s.LastPresence == "NotPresent" ? " · son listede yok" : ""))" />
                <SoField Label="Açık iş / en yakın vade" Value="@($"{s.OpenRequests} · {ServiceAccountUiText.Date(s.NearestDue, "vade yok")}")" />
                <SoField Label="Referanslar" Value="@ServiceAccountUiText.References(s.References)" />
                @if (s.LegacyDisplayId is not null) { <SoField Label="Eski çalışma kitabı kimliği" Value="@s.LegacyDisplayId" /> }
            </SoFieldGrid>
            @if (!string.IsNullOrWhiteSpace(s.Notes)) { <p class="so-panel-text">@s.Notes</p> }
            @if (_detail.Permissions.Basis == ServiceAccountAccessBasis.Participant)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Bu hesabı ekibinize atanmış iş üzerinden görüyorsunuz. Yalnız ekibinize atanmış açık talepler üzerinde çalışabilirsiniz
                    (tarih, not, işlem bildirimi, kanıt). Hesap bilgileri, sahiplik, diğer talepler ve doğrulama hesaptan sorumlu ekiptedir.
                </MudAlert>
            }
            @if (_detail.Permissions.Work)
            {
                <SaAccountEditForm Summary="s" Organizations="_organizations" Teams="_teams" Busy="Busy" Revision="_revision" OnCommand="ExecuteAsync" />
            }
        </section>

        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-3" KeepPanelsAlive="true">
            <MudTabPanel Text="@($"İşler ({_detail.Requests.Count(r => r.Status == "Open")} açık)")">
                <SaRequestsPanel Detail="_detail" Teams="_teams" Busy="Busy" Revision="_revision" OnCommand="ExecuteAsync" />
                <SaActionsPanel Detail="_detail" Teams="_teams" Busy="Busy" Revision="_revision" OnCommand="ExecuteAsync" />
            </MudTabPanel>
            <MudTabPanel Text="@UsageTabText">
                <SaUsagePanel Detail="_detail" Teams="_teams" Busy="Busy" Revision="_revision" OnCommand="ExecuteAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Sahiplik">
                <SaOwnershipPanel Detail="_detail" Teams="_teams" Busy="Busy" Revision="_revision" OnCommand="ExecuteAsync" />
            </MudTabPanel>
            <MudTabPanel Text="@($"Yazışmalar ({_detail.Communications.Count})")">
                <SaCommunicationsTable Items="_detail.Communications" />
                @if (_detail.Permissions.CanWorkAnyRequest)
                {
                    <MudExpansionPanels Class="mt-2"><MudExpansionPanel Text="E-posta kaydı ekle">
                        <SaCommunicationForm @key="_revision" AccountIds="@([Id])" Teams="_teams" Busy="Busy" OnSubmit="SaveMailAsync" />
                    </MudExpansionPanel></MudExpansionPanels>
                }
            </MudTabPanel>
            <MudTabPanel Text="@($"Bulgular ({_detail.Findings.Count})")">
                <SaFindingsPanel Detail="_detail" Teams="_teams" Busy="Busy" Revision="_revision" OnCommand="ExecuteAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Devir ve gMSA">
                <SaHandoverPanel Detail="_detail" Teams="_teams" Busy="Busy" Revision="_revision" OnCommand="ExecuteAsync" />
            </MudTabPanel>
            <MudTabPanel Text="@($"Kanıtlar ({_detail.Evidence.Count})")">
                <SaEvidencePanel Detail="_detail" Busy="Busy" Revision="_revision" OnUpload="UploadAsync" OnDownload="DownloadAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Kaynak ve geçmiş">
                <SaSourcesPanel Detail="_detail" />
            </MudTabPanel>
            @if (Can(SecureOps.Shared.Auth.Capabilities.DirectoryGroupsView))
            {
                <MudTabPanel Text="Dizin gözlemi">
                    <section class="so-panel" aria-labelledby="sa-directory">
                        <h2 id="sa-directory" class="so-panel-title">Dizin gözlemi (yalnız okuma)</h2>
                        <p class="so-panel-text--sm">
                            Platformun mevcut dizin yetkisi ve sorgu sınırıyla, yalnız istenince okunur; sonuç bu modüle kaydedilmez.
                            Dizinde görünmek sahiplik veya kimlik teyidi değildir; parola tarihi işlem kanıtı değildir.
                            Sorgu yapılandırılmış tek domain için hesap adıyla tam eşleşme arar@(s.Domain is null ? " (bu hesabın domaini bilinmiyor)" : $" (kayıtlı domain: {s.Domain})").
                        </p>
                        @if (_directoryRequested)
                        {
                            <SoDirectoryHealth @key="@($"sa-health:{s.Id}")" Account="@s.AccountName" />
                        }
                        else
                        {
                            <MudButton OnClick="@(() => _directoryRequested = true)" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ManageSearch">Dizinden oku</MudButton>
                        }
                    </section>
                </MudTabPanel>
            }
        </MudTabs>
    }
</div>
