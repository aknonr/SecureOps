@page "/service-accounts/reports"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Domain.ServiceAccounts
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts

<PageTitle>Servis hesabı raporları · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="Raporlar" Lead="Canlı rapor her açılışta güncel veriden hesaplanır. Gönderilen nüsha değişmez; XLSX ve PDF yalnız kayıtlı nüshadan üretilir.">
        <Actions><SaModuleLinks Access="Access" Current="reports" /></Actions>
    </SoPageHeader>
    <SaProblem Problem="Problem" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="Rapor yetkisi gerekli" /> }
    else
    {
        <section class="so-panel" aria-label="Rapor dönemi ve kapsamı">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="2">
                    <MudSelect T="string" @bind-Value="_period" Label="Dönem" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@ReportPeriods.Week">Haftalık</MudSelectItem>
                        <MudSelectItem T="string" Value="@ReportPeriods.Month">Aylık</MudSelectItem>
                        <MudSelectItem T="string" Value="@ReportPeriods.Custom">Tarih aralığı</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2"><MudDatePicker Editable="true" @bind-Date="_week" Label="@StartLabel" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                @if (_period == ReportPeriods.Custom)
                {
                    <MudItem xs="12" md="2"><MudDatePicker Editable="true" @bind-Date="_end" Label="Bitiş (dahil)" DateFormat="dd.MM.yyyy" Variant="Variant.Outlined" /></MudItem>
                }
                <MudItem xs="12" md="2">
                    <MudSelect T="Guid?" @bind-Value="_organization" Label="Kurum filtresi" Clearable="true" Variant="Variant.Outlined">
                        @foreach (OrganizationView org in _organizations) { <MudSelectItem T="Guid?" Value="@((Guid?)org.Id)">@org.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="Guid?" @bind-Value="_team" Label="Ekip filtresi" Clearable="true" Variant="Variant.Outlined">
                        @foreach (TeamView team in _teams) { <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudButton OnClick="LiveAsync" Disabled="@(Busy || _period == ReportPeriods.Custom && _end is null)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Insights">Canlı raporu göster</MudButton>
                </MudItem>
            </MudGrid>
            <p class="so-panel-text--sm mt-1">Haftalar İstanbul saatiyle pazartesi 00:00'da başlar; aylık rapor seçilen günün ayını, tarih aralığı en çok 366 günü kapsar. Aynı metrik kuralları kullanılır. Filtre kapsamınızı genişletemez.</p>
        </section>

        @if (_live is not null)
        {
            <SaReportView Report="_live" Title="Canlı rapor" />
            <section class="so-panel" aria-label="Nüsha oluştur">
                <h2 class="so-panel-title">Gönderilecek nüshayı kaydet</h2>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="_kind" Label="Nüsha türü" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("Weekly")">Çalışma nüshası (ekip / koordinatör)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Manager")">Yönetici nüshası (direktör / müdür)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6"><MudTextField @bind-Value="_label" Label="Açıklama (ör. alıcı veya toplantı)" MaxLength="200" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="3" Class="d-flex align-center">
                        <MudButton OnClick="SnapshotAsync" Disabled="Busy" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Lock">Nüshayı kaydet</MudButton>
                    </MudItem>
                </MudGrid>
            </section>
        }

        <section class="so-panel" aria-labelledby="sa-snapshots">
            <h2 id="sa-snapshots" class="so-panel-title">Kayıtlı nüshalar</h2>
            @if (_snapshots.Count == 0) { <SoEmptyState Title="Kayıtlı nüsha yok" /> }
            else
            {
                <MudTable Items="_snapshots" Dense="true" Breakpoint="Breakpoint.Sm" T="SnapshotItem">
                    <HeaderContent><MudTh>Dönem</MudTh><MudTh>Tür / açıklama</MudTh><MudTh>Kapsam</MudTh><MudTh>Oluşturma</MudTh><MudTh>İşlem</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Dönem">@context.PeriodStart.ToString("dd.MM.yyyy") – @context.PeriodEnd.ToString("dd.MM.yyyy")<div class="so-panel-text--sm">Kesim: @ServiceAccountUiText.Instant(context.AsOf)</div></MudTd>
                        <MudTd DataLabel="Tür / açıklama">@(context.Kind == "Manager" ? "Yönetici nüshası" : "Çalışma nüshası")<div class="so-panel-text--sm">@(context.Label ?? "")</div></MudTd>
                        <MudTd DataLabel="Kapsam">@context.ScopeLabel<div class="so-panel-text--sm">@context.MetricDefinitionVersion · @context.PayloadSha256[..12]</div></MudTd>
                        <MudTd DataLabel="Oluşturma">@ServiceAccountUiText.Instant(context.CreatedAt)</MudTd>
                        <MudTd DataLabel="İşlem">
                            <div class="d-flex flex-wrap gap-1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="Busy" OnClick="@(() => OpenAsync(context))">Görüntüle</MudButton>
                                <MudButton Size="Size.Small" Disabled="Busy" StartIcon="@Icons.Material.Filled.TableChart" OnClick="@(() => ExportAsync(context, "xlsx"))">XLSX</MudButton>
                                <MudButton Size="Size.Small" Disabled="Busy" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="@(() => ExportAsync(context, "pdf"))">PDF</MudButton>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </section>

        @if (_stored is not null && _storedItem is not null)
        {
            <SaReportView Report="_stored" Title="@($"Kayıtlı nüsha · {_storedItem.Label ?? _storedItem.PeriodStart.ToString("dd.MM.yyyy")}")" />
        }
    }
</div>

@code {
    private DateTime? _week = DateTime.Today, _end;
    private string _period = ReportPeriods.Week;

    private string StartLabel => _period switch
    {
        ReportPeriods.Month => "Ay (herhangi bir gün)",
        ReportPeriods.Custom => "Başlangıç",
        _ => "Hafta (herhangi bir gün)"
    };
    private Guid? _organization, _team;
    private string _kind = "Weekly";
    private string? _label;
    private ServiceAccountReport? _live, _stored;
    private SnapshotItem? _storedItem;
    private IReadOnlyList<SnapshotItem> _snapshots = [];
    private IReadOnlyList<OrganizationView> _organizations = [];
    private IReadOnlyList<TeamView> _teams = [];

    protected override string RequiredCapability => ServiceAccountCapabilities.Report;

    private DateOnly StartDate => ServiceAccountUiText.ToDate(_week) ?? DateOnly.FromDateTime(DateTime.Today);

    protected override Task LoadAsync() => RunSerializedAsync(async token =>
    {
        _organizations = await Api.GetAsync<IReadOnlyList<OrganizationView>>("/organizations", token);
        _teams = await Api.GetAsync<IReadOnlyList<TeamView>>("/teams", token);
        _snapshots = await Api.GetAsync<IReadOnlyList<SnapshotItem>>("/reports/snapshots", token);
    });

    private Task LiveAsync() => RunAsync(async token =>
    {
        string query = $"weekStart={StartDate:yyyy-MM-dd}&period={_period}"
            + (_period == ReportPeriods.Custom && ServiceAccountUiText.ToDate(_end) is { } end ? $"&periodEnd={end:yyyy-MM-dd}" : "") + (_organization is { } o ? $"&organizationId={o}" : "") + (_team is { } t ? $"&teamId={t}" : "");
        _live = await Api.GetAsync<ServiceAccountReport>("/reports/weekly?" + query, token);
    });

    private Task SnapshotAsync() => RunAsync(async token =>
    {
        // The snapshot is cut at the live report's time so the saved copy equals what was reviewed.
        await Api.SendAsync<SnapshotItem>(HttpMethod.Post, "/reports/snapshots", new CreateSnapshotRequest(_live!.WeekStart, _live.AsOf, _organization, _team, _kind,
            string.IsNullOrWhiteSpace(_label) ? null : _label.Trim(), _live.Period,
            _live.Period == ReportPeriods.Custom ? _live.WeekEndExclusive.AddDays(-1) : null), token);
        _snapshots = await Api.GetAsync<IReadOnlyList<SnapshotItem>>("/reports/snapshots", token);
        _label = null;
    });

    private Task OpenAsync(SnapshotItem item) => RunAsync(async token =>
    {
        _stored = await Api.GetAsync<ServiceAccountReport>($"/reports/snapshots/{item.Id}", token);
        _storedItem = item;
    });

    private Task ExportAsync(SnapshotItem item, string format) =>
        RunAsync(async token => await SaveFileAsync(await Api.DownloadAsync($"/reports/snapshots/{item.Id}/{format}", token)));
}
