@page "/service-accounts/work"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts

<PageTitle>Ekibimin işleri · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="Ekibimin işleri" Lead="Uygulama içi hatırlatmalar ve koordinatör taslakları. Uygulama e-posta göndermez; taslaklar kopyalanıp uygulama dışında gönderilir.">
        <Actions><SaModuleLinks Access="Access" Current="work" /></Actions>
    </SoPageHeader>
    <SaProblem Problem="Problem" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="Servis hesaplarını görüntüleme yetkisi gerekli" /> }
    else
    {
        @if (_summary is not null) { <SaWorkSummary Summary="_summary" /> }
        <div class="d-flex flex-wrap gap-2 mb-3">
            <MudButton Href="service-accounts?myTeam=true&status=open" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PendingActions">Ekibimin açık işleri</MudButton>
            <MudButton Href="service-accounts?myTeam=true&status=overdue" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Warning">Plan bitişi geçenler</MudButton>
            <MudButton Href="service-accounts?myTeam=true&status=proposed" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.HourglassTop">Sahiplik önerisi bekleyenler</MudButton>
        </div>

        <section class="so-panel" aria-labelledby="sa-reminders">
            <div class="so-panel-head"><h2 id="sa-reminders" class="so-panel-title">Hatırlatmalar</h2></div>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="3">
                    <MudSelect T="string" @bind-Value="_status" Label="Durum" Variant="Variant.Outlined">
                        @foreach ((string value, string label) in _statuses) { <MudSelectItem T="string" Value="@value">@label</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_myTeam" Label="Yalnız doğrudan ekiplerim" Color="Color.Primary" /></MudItem>
                <MudItem xs="12" md="5" Class="d-flex align-center gap-2">
                    <MudButton OnClick="LoadAsync" Disabled="Busy" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh">Listele</MudButton>
                    @if (Can(ServiceAccountCapabilities.Administer))
                    {
                        <MudButton OnClick="RunRemindersAsync" Disabled="Busy" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PlayArrow">Değerlendirmeyi şimdi çalıştır</MudButton>
                    }
                </MudItem>
            </MudGrid>
            @if (_run is { } run)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" role="status">
                    @run.Evaluated açık talep değerlendirildi · @run.Enqueued yeni hatırlatma · @run.Delivered teslim · @run.Failed hata · @run.DeadLettered kalıcı hata.
                    @(run.BusinessDayRulesConfigured ? "" : " İş günü kuralları onaylı tatil takvimi olmadığı için kapalı; takvim günü kullanılıyor.")
                </MudAlert>
            }
            @if (Busy && _items is null) { <SoLoading Message="Hatırlatmalar okunuyor" /> }
            else if (_items is { Count: 0 }) { <SoEmptyState Title="Hatırlatma yok" Description="Bu durumda bekleyen hatırlatma bulunmuyor." /> }
            else if (_items is not null)
            {
                @foreach (ReminderView r in _items)
                {
                    <article class="so-panel mt-2" aria-label="@($"{r.AccountName} — {r.RuleLabel}")">
                        <div class="so-panel-head">
                            <MudLink Href="@($"service-accounts/{r.AccountId}")">@r.AccountName</MudLink>
                            <SoStatusBadge Label="@r.RuleLabel" Tone="@(r.RuleCode == "PlanOverdue" ? SoStatusBadge.BadgeTone.Critical : SoStatusBadge.BadgeTone.Info)" />
                            <SoStatusBadge Label="@(r.Channel == "Draft" ? "Koordinatör taslağı" : "Uygulama içi")" Tone="SoStatusBadge.BadgeTone.Neutral"
                                           Icon="@(r.Channel == "Draft" ? Icons.Material.Filled.EditNote : Icons.Material.Filled.Notifications)" />
                            <span class="so-panel-text--sm">@r.DueDate.ToString("dd.MM.yyyy") · @StatusLabel(r.Status)</span>
                        </div>
                        @if (r.Channel == "Draft")
                        {
                            <MudTextField T="string" Value="@r.Message" Label="Taslak metni (seçip kopyalayın)" ReadOnly="true" Lines="3" Variant="Variant.Outlined" />
                        }
                        else { <p class="so-panel-text">@r.Message</p> }
                        @if (r.LastError is not null) { <p class="so-panel-text--sm" role="note">Son hata (@r.AttemptCount deneme): @r.LastError</p> }
                        @if (Can(ServiceAccountCapabilities.Work) && r.Status is "Delivered" or "DeadLetter")
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="Busy" OnClick="@(() => DismissAsync(r))">Kapat</MudButton>
                        }
                    </article>
                }
            }
        </section>
    }
</div>

@code {
    private static readonly (string Value, string Label)[] _statuses =
        [("Delivered", "Açık hatırlatmalar"), ("Pending", "Sırada"), ("Failed", "Yeniden denenecek"), ("DeadLetter", "Kalıcı hata"), ("Dismissed", "Kapatılanlar")];

    private IReadOnlyList<ReminderView>? _items;
    private ServiceAccountWorkSummary? _summary;
    private ReminderRunResult? _run;
    private string _status = "Delivered";
    private bool _myTeam;

    protected override string RequiredCapability => ServiceAccountCapabilities.View;

    protected override Task LoadAsync() => RunSerializedAsync(async token =>
    {
        _summary = await Api.GetAsync<ServiceAccountWorkSummary>("/work-summary", token);
        _items = await Api.GetAsync<IReadOnlyList<ReminderView>>($"/reminders?status={_status}&myTeam={(_myTeam ? "true" : "false")}", token);
    });

    private async Task RunRemindersAsync()
    {
        if (await RunAsync(async token => _run = await Api.SendAsync<ReminderRunResult>(HttpMethod.Post, "/reminders/run", new { }, token)))
        {
            await LoadAsync();
        }
    }

    private async Task DismissAsync(ReminderView reminder)
    {
        if (await RunAsync(token => Api.SendAsync<Guid>(HttpMethod.Post, $"/reminders/{reminder.Id}/dismiss", new DismissReminderRequest(reminder.Version), token)))
        {
            await LoadAsync();
        }
    }

    private static string StatusLabel(string status) => _statuses.FirstOrDefault(s => s.Value == status).Label ?? status;
}
