@page "/service-accounts/plans"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts
@inject NavigationManager Navigation

<PageTitle>Değişiklik planları · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="Değişiklik planları" Lead="gMSA'ya geçiş planları: plan, önizleme, onay, kontrol listesi ve doğrulama. Sistem sunucuda hiçbir şey değiştirmez; planı, onayı ve sizin işaretlediğinizi tutar.">
        <Actions><SaModuleLinks Access="Access" Current="plans" /></Actions>
    </SoPageHeader>
    <SaPageGuide Title="@ServiceAccountGuides.Plans.Title" Purpose="@ServiceAccountGuides.Plans.Purpose" Steps="ServiceAccountGuides.Plans.Steps" Never="@ServiceAccountGuides.Plans.Never"
                 Tour="@ServiceAccountTours.Plans(Can(ServiceAccountCapabilities.Work))" TourId="sa-plans-tour" />
    <SaProblem Problem="Problem" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="Servis hesaplarını görüntüleme yetkisi gerekli" Description="Yetki ve kurum/ekip kapsamı modül yöneticisi tarafından verilir." /> }
    else
    {
        <p class="so-panel-text--sm" role="note">Yalnız tüm hesapları kapsamınızda olan planlar listelenir; bir hesabı kapsamınız dışında olan plan burada görünmez.</p>

        @if (Can(ServiceAccountCapabilities.Work))
        {
            <div data-tour="sa-plan-create"><SaDisclosure Title="Yeni gMSA geçiş planı hazırla" Class="mb-3" Open="_createOpen">
                <p class="so-panel-text--sm">Plan taslak olarak kaydedilir; önizleme ve onay sonraki adımlardır. Bir hesap aynı anda yalnız bir açık planda olabilir. Parola alanı yoktur.</p>
                <SaPlanAccountsEditor ShowTitle="true" @bind-Title="_title" Rows="_rows" Results="_results" Busy="Busy" SubmitLabel="Taslak planı kaydet"
                                      OnSubmit="CreateAsync" Search="SearchAccountsAsync" />
            </SaDisclosure></div>
        }

        <section class="so-panel" aria-labelledby="sa-plans-filter" data-tour="sa-plans-filter">
            <div class="so-panel-head"><h2 id="sa-plans-filter" class="so-panel-title">Planlar</h2></div>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_status" Label="Durum" Variant="Variant.Outlined">
                        @foreach ((string statusCode, string label) in ChangePlanPresentation.StatusFilters) { <MudSelectItem T="string" Value="@statusCode">@label</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="8" Class="d-flex align-center flex-wrap gap-2">
                    <MudButton OnClick="SearchAsync" Disabled="Busy" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh">Listele</MudButton>
                    @if (AccountId is { } accountId)
                    {
                        <SoStatusBadge Label="Tek hesabın açık planı" Tone="SoStatusBadge.BadgeTone.Info" Icon="@Icons.Material.Filled.FilterAlt" Title="@accountId.ToString()" />
                        <MudButton Href="service-accounts/plans" Variant="Variant.Text">Hesap süzgecini kaldır</MudButton>
                    }
                </MudItem>
            </MudGrid>

            @if (_page is null && Busy) { <SoLoading Message="Planlar okunuyor" Variant="SoLoading.LoadingVariant.Block" /> }
            else if (_page is null) { <p class="so-panel-text" role="note">Planlar okunamadı; yukarıdaki hata ve yeniden deneme düğmesi geçerlidir. Listede gösterilecek bir şey bilinmiyor.</p> }
            else if (_page.Items.Count == 0)
            {
                <SoEmptyState Title="Bu süzgeçle plan görünmüyor"
                              Description="Plan olmadığı anlamına gelmeyebilir: yalnız tüm hesapları kapsamınızda olan planlar listelenir." />
            }
            else
            {
                <p role="status" class="so-panel-text">@_page.Total plan</p>
                <MudTable Items="_page.Items" Dense="true" Hover="true" Breakpoint="Breakpoint.Md" T="ChangePlanListItem" Class="sa-plan-list" data-tour="sa-plans-list">
                    <HeaderContent>
                        <MudTh>Plan</MudTh>
                        <MudTh>Durum</MudTh>
                        <MudTh>Hesap</MudTh>
                        <MudTh>Önizleme</MudTh>
                        <MudTh>OCO</MudTh>
                        <MudTh>Bakım penceresi</MudTh>
                        <MudTh>Hazırlayan</MudTh>
                        <MudTh>Son değişiklik</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Plan"><MudLink Href="@($"service-accounts/plans/{context.Id}")">@context.Title</MudLink></MudTd>
                        <MudTd DataLabel="Durum"><SoStatusBadge Label="@context.StatusLabel" Tone="@ChangePlanPresentation.StatusTone(context.Status)" Icon="@ChangePlanPresentation.StatusIcon(context.Status)" /></MudTd>
                        <MudTd DataLabel="Hesap">@context.AccountCount</MudTd>
                        <MudTd DataLabel="Önizleme">@(context.CurrentPreviewVersion is { } v ? "Sürüm " + v : "Yok")</MudTd>
                        <MudTd DataLabel="OCO">@(context.OcoNumber ?? "Onay yok")</MudTd>
                        <MudTd DataLabel="Bakım penceresi">
                            @if (context.WindowStart is { } start && context.WindowEnd is { } end) { <span>@ChangePlanPresentation.Instant(start) – @ChangePlanPresentation.Instant(end)</span> }
                            else { <span>Onaylanınca belirlenir</span> }
                        </MudTd>
                        <MudTd DataLabel="Hazırlayan">@context.CreatedBy</MudTd>
                        <MudTd DataLabel="Son değişiklik">@ChangePlanPresentation.Instant(context.UpdatedAt)</MudTd>
                    </RowTemplate>
                </MudTable>
                <SaPager Label="Planlar" Page="_pageNumber" PageSize="PageSize" Total="_page.Total" Unit="plan" Busy="Busy" OnPage="GoToPageAsync" />
            }
        </section>
    }
</div>

@code {
    private const int PageSize = 25;
    private ChangePlanPage? _page;
    private string _status = string.Empty;
    private int _pageNumber = 1;
    private bool _createOpen;
    private string? _title;
    private List<PlanAccountDraft> _rows = [];
    private IReadOnlyList<ChangePlanAccountResult> _results = [];

    /// <summary>Only plans that currently hold this account (the account page links here).</summary>
    [SupplyParameterFromQuery(Name = "accountId")] public Guid? AccountId { get; set; }

    protected override string RequiredCapability => ServiceAccountCapabilities.View;

    protected override Task LoadAsync() => FetchAsync();

    private Task SearchAsync() { _pageNumber = 1; return FetchAsync(); }

    private Task GoToPageAsync(int page) { _pageNumber = page; return FetchAsync(); }

    private Task FetchAsync() => RunSerializedAsync(async token =>
    {
        List<string> query = [$"page={_pageNumber}", $"pageSize={PageSize}"];
        if (!string.IsNullOrEmpty(_status)) { query.Add("status=" + _status); }
        if (AccountId is { } account) { query.Add("accountId=" + account); }
        _page = await Api.GetAsync<ChangePlanPage>("/change-plans?" + string.Join('&', query), token);
    });

    /// <summary>Scope-limited account search for the editor; null when it failed (the page problem explains).</summary>
    private async Task<IReadOnlyList<AccountListItem>?> SearchAccountsAsync(string text)
    {
        IReadOnlyList<AccountListItem>? found = null;
        await RunAsync(async token =>
            found = (await Api.GetAsync<AccountPage>("/accounts?page=1&pageSize=10&sort=name&descending=false&search=" + Uri.EscapeDataString(text), token)).Items);
        return found;
    }

    private async Task CreateAsync()
    {
        _results = [];
        ChangePlanView? created = null;
        bool ok = await RunAsync(async token => created = await Api.SendAsync<ChangePlanView>(HttpMethod.Post, "/change-plans",
            new CreateChangePlanRequest(_title ?? string.Empty, [.. _rows.Select(r => r.ToInput())]), token));
        if (!ok)
        {
            // A refused request keeps the draft and shows each account's answer; nothing was written.
            _results = ChangePlanPresentation.AccountResults(ProblemCurrentJson);
            _createOpen = true;
            return;
        }

        if (created is not null)
        {
            Navigation.NavigateTo($"service-accounts/plans/{created.Id}");
        }
    }
}
