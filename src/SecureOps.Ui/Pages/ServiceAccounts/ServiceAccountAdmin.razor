@page "/service-accounts/admin"
@attribute [Authorize]
@inherits ServiceAccountPageBase
@using SecureOps.Shared.Contracts.ServiceAccounts
@using SecureOps.Ui.Services.ServiceAccounts
@using SecureOps.Ui.Shared.Components.ServiceAccounts

<PageTitle>Servis hesapları yönetimi · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide sa-page">
    <SoPageHeader Title="Modül yönetimi" Lead="Kapsam yetkileri, kurum/ekip sözlüğü ve kişi kayıtları. Kişi veya ekip kaydı hiçbir zaman erişim vermez; erişim yalnız onaylı kullanıcıya verilen yetki ve kapsamla olur.">
        <Actions><SaModuleLinks Access="Access" Current="admin" /></Actions>
    </SoPageHeader>
    <SaProblem Problem="Problem" OnRetry="LoadAsync" />
    @if (Access is null && !AccessRejected) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!Allowed) { <SoEmptyState Title="Modül yönetimi yetkisi gerekli" /> }
    else
    {
        <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-3" KeepPanelsAlive="true">
            <MudTabPanel Text="Kapsam yetkileri">
                <section class="so-panel" aria-labelledby="sa-grants">
                    <h2 id="sa-grants" class="so-panel-title">Kapsam yetkileri</h2>
                    @if (_grants.Count == 0) { <SoEmptyState Title="Kapsam yetkisi yok" /> }
                    else
                    {
                        <MudTable Items="_grants" Dense="true" Breakpoint="Breakpoint.Sm" T="ScopeGrantView">
                            <HeaderContent><MudTh>Kullanıcı</MudTh><MudTh>Kapsam</MudTh><MudTh>Gerekçe</MudTh><MudTh>Veriliş</MudTh><MudTh>Geri al</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Kullanıcı">@context.UserLabel</MudTd>
                                <MudTd DataLabel="Kapsam">@ScopeText(context)</MudTd>
                                <MudTd DataLabel="Gerekçe">@context.Reason</MudTd>
                                <MudTd DataLabel="Veriliş">@ServiceAccountUiText.Instant(context.GrantedAt)</MudTd>
                                <MudTd DataLabel="Geri al"><MudButton Size="Size.Small" Variant="Variant.Text" Disabled="Busy" OnClick="@(() => _revoke = context)">Geri al</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    @if (_revoke is { } revoke)
                    {
                        <div class="so-panel mt-2" role="group" aria-label="Kapsam yetkisini geri al">
                            <p class="so-panel-text">@revoke.UserLabel · @ScopeText(revoke)</p>
                            <MudTextField @bind-Value="_revokeReason" Label="Geri alma gerekçesi" MaxLength="400" Variant="Variant.Outlined" />
                            <MudButton OnClick="RevokeAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_revokeReason))" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2">Yetkiyi geri al</MudButton>
                            <MudButton OnClick="@(() => _revoke = null)" Variant="Variant.Text" Class="mt-2">Vazgeç</MudButton>
                        </div>
                    }
                    <h3 class="so-panel-title mt-4">Kapsam ver</h3>
                    <p class="so-panel-text--sm">Kullanıcı, uygulamada onaylı olmalı ve kurumsal kimliğiyle birebir yazılmalıdır (arama yapılmaz). Kendinize kapsam veremezsiniz.</p>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_grant.Identity" Label="Kurumsal kimlik (DOMAIN\kullanıcı veya UPN)" MaxLength="256" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="2">
                            <MudSelect T="string" @bind-Value="_grant.Kind" Label="Kapsam türü" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("Organization")">Kurum</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Team")">Ekip</MudSelectItem>
                                <MudSelectItem T="string" Value="@("All")">Tüm kurum</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            @if (_grant.Kind == "Organization")
                            {
                                <MudSelect T="Guid?" @bind-Value="_grant.OrganizationId" Label="Kurum" Variant="Variant.Outlined">
                                    @foreach (OrganizationView org in _organizations) { <MudSelectItem T="Guid?" Value="@((Guid?)org.Id)">@org.Name</MudSelectItem> }
                                </MudSelect>
                            }
                            else if (_grant.Kind == "Team")
                            {
                                <MudSelect T="Guid?" @bind-Value="_grant.TeamId" Label="Ekip" Variant="Variant.Outlined">
                                    @foreach (TeamView team in _teams) { <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem> }
                                </MudSelect>
                            }
                        </MudItem>
                        <MudItem xs="12" md="3"><MudTextField @bind-Value="_grant.Reason" Label="Gerekçe" MaxLength="400" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                    <MudButton OnClick="GrantAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_grant.Identity) || string.IsNullOrWhiteSpace(_grant.Reason))" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Kapsam ver</MudButton>
                </section>
            </MudTabPanel>

            <MudTabPanel Text="Kurum ve ekipler">
                <section class="so-panel" aria-labelledby="sa-orgs">
                    <h2 id="sa-orgs" class="so-panel-title">Kurumlar</h2>
                    <MudTable Items="_organizations" Dense="true" Breakpoint="Breakpoint.Sm" T="OrganizationView">
                        <HeaderContent><MudTh>Ad</MudTh><MudTh>Tür</MudTh><MudTh>Üst kurum</MudTh><MudTh>Düzenle</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Ad">@context.Name</MudTd>
                            <MudTd DataLabel="Tür">@OrgKind(context.Kind)</MudTd>
                            <MudTd DataLabel="Üst kurum">@(_organizations.FirstOrDefault(o => o.Id == context.ParentId)?.Name ?? "—")</MudTd>
                            <MudTd DataLabel="Düzenle"><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditOrg(context))">Düzenle</MudButton></MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_org.Name" Label="@(_org.Id is null ? "Yeni kurum adı" : "Kurum adı")" MaxLength="200" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="6" md="3">
                            <MudSelect T="string" @bind-Value="_org.Kind" Label="Tür" Variant="Variant.Outlined">
                                @foreach (string kind in _orgKinds) { <MudSelectItem T="string" Value="@kind">@OrgKind(kind)</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudSelect T="Guid?" @bind-Value="_org.ParentId" Label="Üst kurum" Clearable="true" Variant="Variant.Outlined">
                                @foreach (OrganizationView org in _organizations.Where(o => o.Id != _org.Id)) { <MudSelectItem T="Guid?" Value="@((Guid?)org.Id)">@org.Name</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="2" Class="d-flex align-center gap-1">
                            <MudButton OnClick="SaveOrgAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_org.Name))" Variant="Variant.Filled" Color="Color.Primary">Kaydet</MudButton>
                            @if (_org.Id is not null) { <MudButton OnClick="@(() => _org = new())" Variant="Variant.Text">Yeni</MudButton> }
                        </MudItem>
                    </MudGrid>
                </section>
                <section class="so-panel" aria-labelledby="sa-teams">
                    <h2 id="sa-teams" class="so-panel-title">Ekipler</h2>
                    <MudTable Items="_teams" Dense="true" Breakpoint="Breakpoint.Sm" T="TeamView">
                        <HeaderContent><MudTh>Ad</MudTh><MudTh>Kurum</MudTh><MudTh>Durum</MudTh><MudTh>Düzenle</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Ad">@context.Name</MudTd>
                            <MudTd DataLabel="Kurum">@(_organizations.FirstOrDefault(o => o.Id == context.OrganizationId)?.Name ?? "Atanmadı")</MudTd>
                            <MudTd DataLabel="Durum">@(context.Provisional ? "Geçici (içe aktarımdan)" : "Onaylı")</MudTd>
                            <MudTd DataLabel="Düzenle"><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => EditTeam(context))">Düzenle</MudButton></MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" md="4"><MudTextField @bind-Value="_team.Name" Label="@(_team.Id is null ? "Yeni ekip adı" : "Ekip adı")" MaxLength="200" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="Guid?" @bind-Value="_team.OrganizationId" Label="Kurum" Clearable="true" Variant="Variant.Outlined">
                                @foreach (OrganizationView org in _organizations) { <MudSelectItem T="Guid?" Value="@((Guid?)org.Id)">@org.Name</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" md="2" Class="d-flex align-center"><MudCheckBox T="bool" @bind-Value="_team.Provisional" Label="Geçici" /></MudItem>
                        <MudItem xs="6" md="2" Class="d-flex align-center gap-1">
                            <MudButton OnClick="SaveTeamAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_team.Name))" Variant="Variant.Filled" Color="Color.Primary">Kaydet</MudButton>
                            @if (_team.Id is not null) { <MudButton OnClick="@(() => _team = new())" Variant="Variant.Text">Yeni</MudButton> }
                        </MudItem>
                    </MudGrid>
                </section>
            </MudTabPanel>

            <MudTabPanel Text="gMSA yönlendirme">
                <section class="so-panel" aria-labelledby="sa-roles">
                    <h2 id="sa-roles" class="so-panel-title">gMSA yönlendirme ayarı</h2>
                    <p class="so-panel-text--sm">
                        1 Ekim 2026 kararı: SQL ekibi olarak işaretlenen ekiplere ait hesaplar gMSA olarak değerlendirilir ve yürütücü ekibe atanır.
                        İçe aktarmada, hesabın sahip ekibi ya da satırdaki kaynak ekip SQL ekibiyse önizlemede bir "gMSA yönlendirme" satırı görünür ve
                        onaylanınca yürütücü ekibe bir gMSA değerlendirme talebi açılır. Bu ayar erişim vermez; sahiplik, uygunluk veya kabul değiştirmez.
                        Yürütücü ekip kaldırılırsa otomatik yönlendirme durur.
                    </p>
                    @if (_roles.Count == 0) { <SoEmptyState Title="Ayar yok: otomatik yönlendirme kapalı" /> }
                    else
                    {
                        <MudTable Items="_roles" Dense="true" Breakpoint="Breakpoint.Sm" T="TeamRoleView">
                            <HeaderContent><MudTh>Ekip</MudTh><MudTh>Rol</MudTh><MudTh>Gerekçe</MudTh><MudTh>İşlem</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Ekip">@context.Team.Label</MudTd>
                                <MudTd DataLabel="Rol">@RoleLabel(context.Role)</MudTd>
                                <MudTd DataLabel="Gerekçe">@context.Reason</MudTd>
                                <MudTd DataLabel="İşlem"><MudButton Size="Size.Small" Variant="Variant.Text" Disabled="Busy" OnClick="@(() => _roleRevoke = context)">Kaldır</MudButton></MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    @if (_roleRevoke is not null)
                    {
                        <div class="d-flex flex-wrap align-center gap-2 mt-2">
                            <MudTextField @bind-Value="_roleRevokeReason" Label="@($"Kaldırma gerekçesi: {_roleRevoke.Team.Label}")" MaxLength="1000" Variant="Variant.Outlined" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Busy || string.IsNullOrWhiteSpace(_roleRevokeReason))" OnClick="RevokeRoleAsync">Kaldır</MudButton>
                            <MudButton Variant="Variant.Text" Disabled="Busy" OnClick="@(() => _roleRevoke = null)">Vazgeç</MudButton>
                        </div>
                    }
                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" md="4">
                            <MudSelect T="Guid?" @bind-Value="_roleTeam" Label="Ekip" Variant="Variant.Outlined">
                                @foreach (TeamView team in _teams) { <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem> }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" @bind-Value="_roleKind" Label="Rol" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@ServiceAccountTeamRoles.SqlTeam">@RoleLabel(ServiceAccountTeamRoles.SqlTeam)</MudSelectItem>
                                <MudSelectItem T="string" Value="@ServiceAccountTeamRoles.GmsaExecutor">@RoleLabel(ServiceAccountTeamRoles.GmsaExecutor)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3"><MudTextField @bind-Value="_roleReason" Label="Gerekçe" MaxLength="1000" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="2" Class="d-flex align-center">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Busy || _roleTeam is null || string.IsNullOrWhiteSpace(_roleReason))" OnClick="AddRoleAsync">Ekle</MudButton>
                        </MudItem>
                    </MudGrid>
                    <p class="so-panel-text--sm mt-1">Yalnız bir yürütücü ekip olabilir; değiştirmek için önce mevcut olanı kaldırın.</p>
                </section>
            </MudTabPanel>

            <MudTabPanel Text="Kişiler">
                <SaPeopleAdmin Busy="Busy" OnCommand="PersonCommandAsync" Revision="_revision" />
            </MudTabPanel>
        </MudTabs>
    }
</div>
