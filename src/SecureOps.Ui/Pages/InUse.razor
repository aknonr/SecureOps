@page "/in-use"
@page "/in-use/{Id:guid}"
@attribute [Authorize]
@using SecureOps.Shared.Contracts.InUse
@implements IDisposable
@inject InUseApiClient Api
@inject ICurrentAccessProvider AccessProvider
@inject IJSRuntime Js

<PageTitle>In Use · @WasasBrand.Name</PageTitle>
<div class="so-page so-page--wide so-inuse">
    <SoPageHeader Title="In Use">
        <Actions>
            @if (Id.HasValue) { <MudButton Href="in-use" StartIcon="@Icons.Material.Filled.ArrowBack">Listeye dön</MudButton> }
            @if (Can(Capabilities.InUseView)) { <ResourceHelp Surface="@(Id.HasValue ? "inuse-review" : "inuse-list")" Disabled="_busy" /> }
        </Actions>
    </SoPageHeader>
    @if (_access is null) { <SoLoading Message="Yetkiler doğrulanıyor" /> }
    else if (!_access.IsResolved) { <SoProblemPanel Problem="_access.Problem!" OnRetry="InitializeAsync" /> }
    else if (!Can(Capabilities.InUseView))
    { <SoEmptyState Title="In Use erişimi gerekli" Description="Uygulama yöneticisinden In Use yetkisi isteyin." /> }
    else
    {
        @if (_problem is not null) { <SoProblemPanel Problem="_problem" />
            <MudButton OnClick="LoadAsync" Disabled="_busy" StartIcon="@Icons.Material.Filled.Refresh">Kayıtlı veriyi yeniden oku</MudButton> }
        @if (_notice is not null) { <p role="status">@_notice</p> }
        @if (_busy) { <SoLoading Message="İşlem sürüyor" /> }
        @if (!Id.HasValue)
        {
            <div class="so-inuse-filters" data-guide="inuse-filter">
                <div><MudTextField T="string" Label="Kayıt ara" aria-label="In Use kayıt ara" MaxLength="100" Value="_search" ValueChanged="SearchAsync" Immediate="true" DebounceInterval="350" Variant="Variant.Outlined" Margin="Margin.Dense" /></div>
                <label>Görünüm<select aria-label="In Use görünüm" @bind="_view" @bind:after="FilterAsync">
                    <option value="all">Tümü</option><option value="mine">Bana atanan</option><option value="unassigned">Atanmamış</option>
                </select></label>
                <label>İnceleme durumu<select aria-label="In Use durum" @bind="_status" @bind:after="FilterAsync">
                    <option value="">Tüm durumlar</option><option value="Unreviewed">İncelenmedi</option><option value="Draft">Taslak</option><option value="Stale">Yeniden inceleme</option>
                </select></label>
            </div>
            <section data-guide="inuse-refresh" class="so-inuse-band">
                @if (Can(Capabilities.InUseRefresh))
                { <MudButton OnClick="RefreshAsync" Disabled="_busy" StartIcon="@Icons.Material.Filled.Sync" Variant="Variant.Outlined">In Use kaynağını yenile</MudButton> }
                @if (_page is not null)
                {
                    <p>Son başarılı okuma: @Time(_page.Refresh.LastSuccessfulAt)</p>
                    @if (_page.Refresh.Stale) { <MudAlert Severity="Severity.Warning">@RefreshIssue(_page.Refresh.Issue) Kayıtlı veriler korunur.</MudAlert> }
                    <p>@_page.Total kayıtlı eşleşme · Kaynak kapsamı: @(_page.Refresh.Complete ? "Tam yerel sorgu sonucu" : "Tamlığı doğrulanmadı")</p>
                }
            </section>
            <section data-guide="inuse-list" aria-label="In Use kayıtları">
                @if (_page is { Items.Count: 0 }) { <SoEmptyState Title="Kayıtlı eşleşme yok" Description="Filtreleri kontrol edin veya yetkinizle kaynağı yenileyin." /> }
                @if (_page is not null)
                {
                    <ul class="so-inuse-records">
                    @foreach (InUseRecord record in _page.Items)
                    {
                        <li><div><a href="@($"in-use/{record.Id}")">@record.Source.Code</a><h2>@record.Source.Title</h2>
                            @if (record.Source.Synthetic) { <span class="so-chip">Sentetik yerel veri</span> }</div>
                            <div>@Status(record.Status)<br />WASAS inceleyicisi: @(record.AssigneeLabel ?? "Atanmamış")<br />Servis öğesi: @Relationship(record.Source.ServiceItemsState, record.Source.Servers.Count)
                                <br />Virtual PC User: @string.Join("; ", record.Source.Servers.Select(s => Evidence(s.Fields.GetValueOrDefault("Virtual PC User") ?? new(null, "Eşleme bekleniyor"))).DefaultIfEmpty("Eşleme bekleniyor").Distinct())
                                <br />Talep eden: @Evidence(record.Source.Requester)</div>
                            <MudButton Href="@($"in-use/{record.Id}")" EndIcon="@Icons.Material.Filled.ArrowForward">İncele</MudButton></li>
                    }
                    </ul>
                    <footer class="so-inuse-pager">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" aria-label="Önceki In Use sayfası" Disabled="@(_busy || _number == 1)" OnClick="PreviousAsync" />
                        <span>Sayfa @_number / @Math.Max(1, (int)Math.Ceiling((double)_page.Total / _size))</span>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" aria-label="Sonraki In Use sayfası" Disabled="@(_busy || _number * _size >= _page.Total)" OnClick="NextAsync" />
                        <label>Sayfa boyutu<select aria-label="In Use sayfa boyutu" @bind="_size" @bind:after="FilterAsync"><option>10</option><option>25</option><option>50</option></select></label>
                    </footer>
                }
            </section>
        }
        else if (_record is { } record)
        {
            <h2>@record.Source.Code · @record.Source.Title</h2>
            <p>@Status(record.Status) · Veri sürümü @record.SourceVersion · Kayıt sürümü @record.Version · Son okuma @Time(record.LastSeenAt)</p>
            @if (record.Source.Synthetic) { <MudAlert Severity="Severity.Info">Sentetik yerel veri; kurumsal doğrulama değildir.</MudAlert> }
            @if (record.Status == "Stale") { <MudAlert Severity="Severity.Warning">Kaynak değişti. Önceki taslak güncel değildir; cevapları yeniden doğrulayın.</MudAlert> }
            <section class="so-inuse-band" data-guide="inuse-owner">
                <h3>Sorumluluk ve kaynak kanıtı</h3>
                <dl class="so-inuse-evidence">
                    <dt>İlk talep sahibi</dt><dd>@Evidence(record.Source.Requester)</dd>
                    <dt>WASAS inceleyicisi</dt><dd>@(record.AssigneeLabel ?? "Atanmamış") · Yerel, yetkili uygulama ataması</dd>
                </dl>
                <details><summary>Diğer kaynak kimlikleri</summary><dl class="so-inuse-evidence">
                    <dt>Teknik kayıt oluşturucusu</dt><dd>@Evidence(record.Source.Creator ?? new(null, "Kaynak sözleşmesi doğrulanmadı"))</dd>
                    <dt>Servis / uygulama sahibi</dt><dd>@Evidence(record.Source.ServiceOwner)</dd>
                    <dt>Kurulum operatörü / ekibi</dt><dd>@Evidence(record.Source.ProvisioningTeam)</dd>
                </dl></details>
                @if (Can(Capabilities.InUseAssign))
                {
                    <details class="so-inuse-assignment" open="@(record.AssigneeId is null)"><summary>İnceleyici ata / değiştir</summary><div class="so-inuse-filters">
                        <label>İnceleyici<select aria-label="In Use inceleyicisi" @bind="_assignee"><option value="">Atanmamış</option>
                            @foreach (InUseAssignee person in _assignees) { <option value="@person.Id">@person.Label</option> }</select></label>
                        <label>Atama gerekçesi<input aria-label="Atama gerekçesi" maxlength="500" @bind="_reason" @bind:event="oninput" /></label>
                        <MudButton OnClick="AssignAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))" StartIcon="@Icons.Material.Filled.PersonAdd">Atamayı kaydet</MudButton>
                    </div></details>
                }
                <p role="status">Sonraki adım: @NextAction</p>
            </section>
            <section class="so-inuse-band" data-guide="inuse-servers">
                <h3>Servis öğeleri / sunucular</h3><p>@record.Source.RelationshipEvidence</p>
                <p>Servis öğesi: @Relationship(record.Source.ServiceItemsState, record.Source.Servers.Count) · Etkilenen varlıklar: @Relationship(record.Source.AffectedAssetsState, record.Source.AffectedAssetCount)</p>
                @if (_validation is not null) { <p role="alert">@_validation</p> }
                @if (record.Source.Servers.Count > 0)
                {
                    <div class="so-inuse-workbook" tabindex="0" aria-label="Servis öğesi tablosu"><table><thead><tr><th>Kaynak kimliği</th><th>Adı</th><th>Ortam</th><th>Durum</th><th>Servis / uygulama</th><th>Virtual PC User</th><th>RFC Kaydı</th></tr></thead><tbody>
                        @foreach (InUseServer server in record.Source.Servers)
                        { <tr><td>@server.Id</td><td>@Field(server, "HOSTNAME")</td><td>@Field(server, "SI_ENVIRONMENT")</td><td>@Field(server, "STATUS")</td><td>@Field(server, "SERVICE NAME (ÜRÜN/UYGULAMA)")</td><td>@Field(server, "Virtual PC User")</td><td>@Field(server, "RFC Kaydı")</td></tr> }
                    </tbody></table></div>
                }
                @if (record.Source.Servers.Count == 0) { <MudAlert Severity="Severity.Warning">Doğrulanmış sunucu ilişkisi yok. Kaynak ilişki kanıtı gerekli.</MudAlert> }
                @if (record.Source.Servers.Count > 0)
                {
                    <label>Yanıtlanacak sunucu<select aria-label="Yanıtlanacak sunucu" @bind="_editingServer" @bind:after="() => _changes = null">
                        @foreach (InUseServer server in record.Source.Servers) { <option value="@server.Id">@Field(server, "HOSTNAME") · @server.Id · @_answers.Count(a => a.ServerId == server.Id && a.Value == "Unknown") eksik</option> }
                    </select></label>
                    <div class="so-inuse-filters">
                        @for (int i = 0; i < InUseChecks.OperatorCodes.Count; i++)
                        {
                            int index = i;
                            AnswerEdit answer = _answers.Single(a => a.ServerId == _editingServer && a.Check == InUseChecks.OperatorCodes[index]);
                            <label>@Check(answer.Check)<select @ref="_answerElements[index]" aria-label="@($"{answer.ServerId} {answer.Check}")" disabled="@(!CanEdit || _busy)" @bind="answer.Value" @bind:after="Dirty">
                                @foreach (string value in InUseChecks.Values.Where(v => v != "NotApplicable")) { <option value="@value">@Answer(value)</option> }
                            </select></label>
                        }
                    </div>
                    @if (CanEdit && record.Source.Servers.Count > 1)
                    {
                        <details class="so-inuse-bulk"><summary>Bu üç cevabı seçili sunuculara uygula</summary>
                            @foreach (InUseServer server in record.Source.Servers.Where(s => s.Id != _editingServer))
                            { <label class="so-inuse-check"><input type="checkbox" disabled="@_busy" checked="@_selected.Contains(server.Id)" @onchange="e => SelectServer(server.Id, e)" />@server.Id · @Field(server, "SI_ENVIRONMENT") · @Field(server, "SERVICE NAME (ÜRÜN/UYGULAMA)")</label> }
                            <MudButton OnClick="PreviewBulk" Disabled="@(_busy || _selected.Count == 0)" StartIcon="@Icons.Material.Filled.CompareArrows">Değişiklikleri göster</MudButton>
                            @if (_changes is not null)
                            {
                                <ul>@foreach (var change in _changes) { <li>@change.Target.ServerId · @Check(change.Target.Check): @Answer(change.Before) → @Answer(change.After)</li> }</ul>
                                <MudButton OnClick="ApplyBulk" Disabled="@(_busy || _changes.Length == 0)" StartIcon="@Icons.Material.Filled.DoneAll">Gösterilen değişiklikleri onayla</MudButton>
                            }
                        </details>
                    }
                    <details><summary>Kaynak kanıtı ve geçmiş notlar</summary>
                        <p>@_notes</p>
                        @foreach (InUseServer server in record.Source.Servers)
                        { <h4>@server.Id</h4><dl class="so-inuse-evidence">@foreach (var field in server.Fields) { <dt>@field.Key</dt><dd>@Evidence(field.Value)</dd> }</dl> }
                        @foreach (InUseAnswer old in record.Draft?.Answers.Where(a => !string.IsNullOrEmpty(a.Evidence)) ?? [])
                        { <p>@old.ServerId · @Check(old.Check): @old.Evidence</p> }
                    </details>
                }
            </section>
            <section class="so-inuse-band" data-guide="inuse-report">
                <h3>İnceleme ve Excel hazırlığı</h3>
                <div class="so-inline-actions">
                    @if (CanEdit) { <MudButton OnClick="SaveAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">Taslağı kaydet</MudButton> }
                    @if (Can(Capabilities.InUseReview)) { <MudButton OnClick="PreviewAsync" Disabled="@(_busy || _dirty || record.Draft is null || record.Status == "Stale")" StartIcon="@Icons.Material.Filled.TableView">Excel önizleme</MudButton> }
                </div>
                @if (_dirty) { <p role="status">Kaydedilmemiş değişiklikler var.</p> }
                @if (_report is { } report)
                {
                    <p>Yerel taslak · Sürüm @report.Version · Kaynak sürümü @report.SourceVersion · Yüklenmedi / kaynak onayı değil</p>
                    @if (!report.Archived) { <MudButton OnClick="() => DownloadAsync()" Disabled="@(_busy || _dirty)" StartIcon="@Icons.Material.Filled.Archive">WASAS'a arşivle ve indir</MudButton> }
                    else { <MudButton OnClick="() => DownloadAsync(report.Version)" Disabled="_busy" StartIcon="@Icons.Material.Filled.Download">Arşivi indir</MudButton> }
                    @if (report.Archived) { <p>WASAS arşivi · @Time(report.PreparedAt) · @report.Size bayt · Turuncu Hat'a eklenmedi</p> }
                    <label>Çalışma sayfası<select aria-label="Excel sayfası" @bind="_sheet">@for (int i = 0; i < report.Sheets.Count; i++) { <option value="@i">@report.Sheets[i].Name</option> }</select></label>
                    <div class="so-inuse-workbook" tabindex="0" aria-label="Excel hücre önizlemesi"><table><tbody>
                        @foreach (var row in report.Sheets[_sheet].Rows) { <tr>@foreach (string cell in row) { <td>@cell</td> }</tr> }
                    </tbody></table></div>
                    @if (report.Sheets[_sheet].Rows.Count == 0) { <p>Orijinal script bu sayfaya veri yazmıyor. Onaylı şablon gereksinimi bekleniyor.</p> }
                }
                @if (Can(Capabilities.InUseReview) && record.ArchivedVersions.Count > 0)
                { <details><summary>Önceki WASAS raporları</summary>@foreach (long version in record.ArchivedVersions) { <MudButton OnClick="() => DownloadAsync(version)" Disabled="_busy" StartIcon="@Icons.Material.Filled.Download">Sürüm @version (arşiv)</MudButton> }</details> }
            </section>
        }
    }
</div>
