@page "/"
@namespace SecureOps.Ui.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Components.Web
@using SecureOps.Ui
@using SecureOps.Ui.Services
@{
    // The one place the browser session can be read for a circuit. Inside a live circuit there is no
    // HttpContext, so this request hands the correlation value to the root component, which seeds it
    // for every API client the circuit will create. Blazor encrypts root parameters into the
    // prerendered marker, so this does not put the value in the page source.
    string? browserSessionKey = User.FindFirst(SignedInUserService.BrowserSessionClaim)?.Value;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@WasasBrand.Name</title>
    <base href="~/" />

    @* Approved corporate emblem, served from this application. Versioned so a palette or asset
       change is not held back by a cached tab icon. *@
    <link rel="icon" href="~/brand/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="~/brand/favicon-16.png?v=2" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="~/brand/favicon.ico?v=2" sizes="16x16 32x32" />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-name" content="@WasasBrand.Name" />

    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="~/css/secureops-theme.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered"
               param-BrowserSessionKey="browserSessionKey" />

    @* Blazor's built-in circuit failure banner. Reworded from the framework default so a dropped
       connection reads as a recoverable state rather than an application error. *@
    <div id="blazor-error-ui">
        <span>Sunucu bağlantısı kesildi. Sayfayı yenileyerek devam edebilirsiniz.</span>
        <a href="" class="reload">Yenile</a>
        <a class="dismiss" aria-label="Kapat">×</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Appearance preference. Presentation only: no identity, no authorization, nothing the API
        // is told about, and never a cookie -- a cookie would travel on every request and belongs to
        // authentication, not to which palette somebody prefers.
        window.secureOpsAppearance = {
            read: function () {
                try {
                    var value = localStorage.getItem("wasas.appearance");
                    if (value === "night") {
                        localStorage.setItem("wasas.appearance", "dark");
                        return "dark";
                    }
                    return value === "light" || value === "dark" ? value : null;
                } catch (e) { return null; }
            },
            write: function (v) {
                try { localStorage.setItem("wasas.appearance", v === "light" ? "light" : "dark"); }
                catch (e) { }
            }
        };

        // FocusOnNavigate keeps page changes accessible. Track the initiating input so its heading
        // ring is retained for keyboard navigation but suppressed after a pointer click.
        document.documentElement.dataset.soInputModality = "pointer";
        window.addEventListener("pointerdown", function () {
            document.documentElement.dataset.soInputModality = "pointer";
        }, true);
        window.addEventListener("keydown", function (event) {
            if (!event.metaKey && !event.ctrlKey && !event.altKey) {
                document.documentElement.dataset.soInputModality = "keyboard";
            }
        }, true);

        // Hands the operator a file the server produced. The bytes, the name, and the content type
        // all come from the API response; nothing is generated or reformatted here, which is what
        // keeps an export traceable to the audited server-side operation.
        // Batch opening of shift-start links.
        //
        // Single links are ordinary anchors with target/rel set in markup — no JavaScript is
        // involved and the browser handles them natively. This exists only because opening several
        // tabs requires several window.open calls inside one user gesture, which markup cannot do.
        //
        // Dispatch in the browser click handler: Blazor Server interop requires a round trip and
        // cannot guarantee that transient user activation is still available on arrival.
        //
        // noopener,noreferrer on every call: the opened page gets no window.opener handle back into
        // WASAS and no Referer header. No cookie, token, or header is passed — window.open cannot
        // carry any, and nothing here tries.
        //
        // The returned count is attempts that came back without a handle. It is a hint, not proof:
        // a browser may block silently and still return an object, or return null for reasons
        // unrelated to blocking. The caller must never report success from it — the only honest
        // claim is that opening was attempted, which is why the individual links stay on screen.
        window.secureOpsLinks = {
            openMany: function (urls) {
                if (!Array.isArray(urls)) { return 0; }
                var withoutHandle = 0;
                for (var i = 0; i < urls.length; i++) {
                    var handle = null;
                    try {
                        handle = window.open(urls[i], '_blank', 'noopener,noreferrer');
                    } catch (e) {
                        handle = null;
                    }
                    if (!handle) { withoutHandle++; }
                }
                return withoutHandle;
            }
        };

        document.addEventListener('click', function (event) {
            var button = event.target.closest('[data-so-open-links]');
            if (!button || !event.isTrusted) { return; }
            var panel = button.closest('.so-set-resolved');
            var urls = Array.from(panel.querySelectorAll('a.so-resource-name'))
                .map(function (link) { return link.href; });
            window.secureOpsLinks.openMany(urls);
            panel.querySelector('[data-so-open-status]').hidden = false;
        });

        // MudBlazor 6 puts select attributes on a hidden input, not its keyboard target.
        // Transfer resource field names to that target without replacing its keyboard behavior.
        function labelResourceSelects() {
            document.querySelectorAll('.so-resource-filters .mud-select, .so-resource-dialog .mud-select')
                .forEach(function (select) {
                    var input = select.querySelector('input[aria-label]');
                    var target = select.querySelector('div.mud-input-slot[tabindex="0"]');
                    if (input && target) {
                        target.setAttribute('aria-label', input.getAttribute('aria-label'));
                        target.setAttribute('role', 'button');
                        target.setAttribute('aria-haspopup', 'listbox');
                    }
                });
        }
        new MutationObserver(labelResourceSelects).observe(document.body, { childList: true, subtree: true });
        labelResourceSelects();

        window.secureOpsDownload = function (fileName, contentType, base64) {
            var binary = atob(base64);
            var bytes = new Uint8Array(binary.length);
            for (var i = 0; i < binary.length; i++) { bytes[i] = binary.charCodeAt(i); }

            var url = URL.createObjectURL(new Blob([bytes], { type: contentType }));
            var link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            // Revoked on the next tick so the click has already been handled.
            setTimeout(function () { URL.revokeObjectURL(url); }, 0);
        };
    </script>
</body>
</html>
