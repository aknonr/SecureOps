{
  "Audit": {
    "Provider": "File",
    "FailClosed": true,
    "RequirePersistentStoreInProduction": true,
    "File": {
      "Directory": "C:\\SecureOps\\Audit",
      "FilePrefix": "secureops-audit",
      "RollingInterval": "Day",
      "MaxFileSizeMB": 50,
      "RetainedFileCountLimit": 31
    },
    "Queue": {
      "Enabled": true,
      "Capacity": 1000,
      "FullBehavior": "FailClosed"
    },
    "FlushIntervalSeconds": 1
  },
  "IdentityLookup": {
    "Provider": "Mock",
    "StripDomainPrefix": true,
    "NormalizeToLowerInvariant": true,
    "EnableUpnLookup": true,
    "MaxAccountLength": 128,
    "AllowedAccountPattern": "^[a-zA-Z0-9._@-]+$",
    "RegexTimeoutMilliseconds": 250,
    "ProviderTimeoutSeconds": 3,
    "RateLimit": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    }
  },
  "Rbac": {
    "OperatorsGroup": "CONTOSO\\SecureOps-Operators",
    "LeadsGroup": "CONTOSO\\SecureOps-Leads",
    "AdminsGroup": "CONTOSO\\SecureOps-Admins",
    "AuditorsGroup": "CONTOSO\\SecureOps-Auditors"
  }
}
