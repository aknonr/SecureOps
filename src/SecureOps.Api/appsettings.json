{
  "DemoAuth": {
    "Enabled": false,
    "HeaderName": "X-SecureOps-Demo-Actor"
  },
  "Oidc": {
    "Enabled": false,
    "Authority": "",
    "MetadataAddress": "",
    "ApiAudience": "",
    "RequireHttpsMetadata": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Access": {
    "RepositoryProvider": "InMemory",
    "AutoCreateRequest": true,
    "DemoCompatibilityEnabled": false,
    "OidcSubjectClaimType": "sub",
    "OidcIssuerClaimType": "iss"
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "LoginName": "",
    "AllowedIssuer": ""
  },
  "SessionSecurity": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteLifetimeHours": 12,
    "ActivityPersistenceIntervalMinutes": 5,
    "RepositoryProvider": "InMemory",
    "CookieName": "__Host-SecureOps.ApplicationSession",
    "MaxAdminPageSize": 100,
    "SecureCookie": true,
    "HttpOnly": true,
    "SameSite": "Lax",
    "RevalidateAccessOnEveryRequest": true
  },
  "DataProtection": {
    "Mode": "Ephemeral",
    "ApplicationName": "SecureOps.Api"
  },
  "ReverseProxy": {
    "ForwardedHeaders": {
      "Enabled": false,
      "TrustedProxyIps": []
    }
  },
  "PamProvider": {
    "Provider": "Mock",
    "TimeoutSeconds": 3
  },
  "Audit": {
    "Provider": "File",
    "FailClosed": true,
    "RequirePersistentStoreInProduction": true,
    "File": {
      "Directory": "C:\\SecureOps\\Audit",
      "FilePrefix": "secureops-audit",
      "RollingInterval": "Day",
      "MaxFileSizeMB": 50,
      "RetainedFileCountLimit": 31
    },
    "Queue": {
      "Enabled": true,
      "Capacity": 1000,
      "FullBehavior": "FailClosed"
    },
    "FlushIntervalSeconds": 1
  },
  "IdentityLookup": {
    "Provider": "Mock",
    "StripDomainPrefix": true,
    "NormalizeToLowerInvariant": true,
    "EnableUpnLookup": true,
    "MaxAccountLength": 128,
    "AllowedAccountPattern": "^[a-zA-Z0-9._@-]+$",
    "RegexTimeoutMilliseconds": 250,
    "ProviderTimeoutSeconds": 3,
    "BulkMaxAccounts": 20,
    "Cache": {
      "Enabled": true,
      "TtlSeconds": 30,
      "MaxEntries": 500
    }
  },
  "OperationalRecords": {
    "SourceProvider": "Disabled",
    "RepositoryProvider": "InMemory",
    "MaxImportCount": 100,
    "ClaimLeaseSeconds": 120
  },
  "CommandIdempotency": {
    "ExecutionLeaseSeconds": 120,
    "MaxKeyLength": 128
  },
  "RateLimiting": {
    "IdentityLookup": { "PermitLimit": 10, "WindowSeconds": 60 },
    "BulkIdentityLookup": { "PermitLimit": 4, "WindowSeconds": 60 },
    "OperationalRecordRefresh": { "PermitLimit": 12, "WindowSeconds": 60 },
    "JiraPreview": { "PermitLimit": 20, "WindowSeconds": 60 },
    "JiraCreate": { "PermitLimit": 6, "WindowSeconds": 60 },
    "WorkflowRetry": { "PermitLimit": 6, "WindowSeconds": 60 }
  }
}
