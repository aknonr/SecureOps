<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SecureOps.Infrastructure
    Data access, external integrations, PowerShell execution, Hangfire jobs.

    Depends on: Domain, Shared.
    Does NOT contain: ASP.NET pipeline, Blazor components.

    See: docs/03-architecture.md, docs/agent-guides/010-architecture.md
  -->

  <PropertyGroup>
    <RootNamespace>SecureOps.Infrastructure</RootNamespace>
    <AssemblyName>SecureOps.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Liberation Mono (SIL OFL 1.1, unmodified; licence beside the files), embedded in Service Accounts report PDFs. -->
    <EmbeddedResource Include="ServiceAccounts\Reporting\Fonts\LiberationMono-Regular.ttf" LogicalName="SecureOps.Reporting.LiberationMono-Regular.ttf" />
    <EmbeddedResource Include="ServiceAccounts\Reporting\Fonts\LiberationMono-Bold.ttf" LogicalName="SecureOps.Reporting.LiberationMono-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureOps.Domain\SecureOps.Domain.csproj" />
    <ProjectReference Include="..\SecureOps.Shared\SecureOps.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data access -->
    <PackageReference Include="MimeKit" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />

    <!-- Hangfire -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />

    <!-- PowerShell / JEA -->
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />

    <!-- AD lookup -->
    <PackageReference Include="System.DirectoryServices" />

    <!-- Resilience -->
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />

    <!-- AD lookup (Phase 2+) -->
    <PackageReference Include="System.DirectoryServices.AccountManagement" />

    <!-- Options + DI helpers -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
