diff --git a/tests/sql/service-accounts/sa-sql-harness.ps1 b/tests/sql/service-accounts/sa-sql-harness.ps1
index 75ccd33..6f611b5 100644
--- a/tests/sql/service-accounts/sa-sql-harness.ps1
