@@ -45,10 +45,16 @@ try {
     & $sqlcmd -S $server -d $database -E -I -b -i 'SA-001-service-accounts.sql' | Out-Null
     if ($LASTEXITCODE -eq 0) { throw 'Candidate replay was not refused.' }
     Write-Host 'replay refused as expected'
